Процедура	ВстроитьЭлементыИнтеграцииНаФорму(Форма, ПараметрыРазмещения, КомандыТаблица) Экспорт
	// Проверка на возможноть добавить колонки
	// Добавление колонок
	ДобавитьКолонкиВДинамическийСписок(Форма, ПараметрыРазмещения);
	
	// Проверка на возможноть добавить команды
	// Добавим команды
	ДобавитьКомандыНаФорму(Форма, ПараметрыРазмещения, КомандыТаблица);
КонецПроцедуры

#Область Команды

// *************************************
// Группа комманд 

Функция ПанельКомандФормы(Форма)
	
	// Доработанная форма от 1С
	ОсновнаяКоманднаяПанель = Форма.Элементы.Найти("ОсновнаяКоманднаяПанель");
	Если ОсновнаяКоманднаяПанель = Неопределено Тогда
		// Простая форма от 1С (Объект)
		ОсновнаяКоманднаяПанель = Форма.Элементы.Найти("ГруппаКнопкиКоманднойПанели");
	КонецЕсли;
	Если ОсновнаяКоманднаяПанель = Неопределено Тогда
		// Простая форма от 1С (Список/журнал)
		ОсновнаяКоманднаяПанель = Форма.Элементы.Найти("КоманднаяПанельФормы");
	КонецЕсли;
	Если ОсновнаяКоманднаяПанель = Неопределено Тогда
		// Простая форма от 1С в журналах / обработках
		ОсновнаяКоманднаяПанель = Форма.Элементы.Найти("ГруппаГлобальныеКоманды");
	КонецЕсли;
	Если ОсновнаяКоманднаяПанель = Неопределено Тогда
		// БУХ - ПодразделенияОрганизаций
		ОсновнаяКоманднаяПанель = Форма.Элементы.Найти("ГруппаКоманднаяПанель");
	КонецЕсли;
	Если ОсновнаяКоманднаяПанель = Неопределено Тогда
		// БУХ - Должности
		ОсновнаяКоманднаяПанель = Форма.Элементы.Найти("КоманднаяПанель");
	КонецЕсли;
	Если ОсновнаяКоманднаяПанель = Неопределено Тогда
		// КАМИН
		ОсновнаяКоманднаяПанель = Форма.Элементы.Найти("ФормаКоманднаяПанель");
	КонецЕсли;
	// Пробуем найчти меню - Печать
	Если ОсновнаяКоманднаяПанель = Неопределено Тогда
		КоманднаяПанельПечать = Форма.Элементы.Найти("ПодменюПечать");
		Если КоманднаяПанельПечать <> Неопределено Тогда
			ОсновнаяКоманднаяПанель = КоманднаяПанельПечать.Родитель;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый СТруктура("Панель, Элемент", ОсновнаяКоманднаяПанель, КоманднаяПанельПечать);
КонецФункции

Процедура СозданиеЭлементовУправленияНазначениеДействий(Форма, Команды)

	ГруппаИнтеграция = Форма.Элементы.Найти("ИнтеграцияГруппаКоманд");
	Если ГруппаИнтеграция = Неопределено Тогда
		ДанныеДобавленияПанели = ПанельКомандФормы(Форма);
		ГруппаИнтеграция = Форма.Элементы.Вставить(
			"ИнтеграцияГруппаКоманд", 
			Тип("ГруппаФормы"),
			ДанныеДобавленияПанели.Панель,
			ДанныеДобавленияПанели.Элемент);
	КонецЕсли;
	
	НазваниеПродукта = ЛокализацияНазваниеПродукта();
	ГруппаИнтеграция.Заголовок = НазваниеПродукта;
	
	Для Каждого Команда Из Команды Цикл
		Если Команда.Назначение <>  НазваниеПродукта Тогда
			Продолжить;
		КонецЕсли;
		
		// Создание команды формы
		ИмяКоманды = Команда.ИмяВФорме;
		НоваяКоманда = Форма.Команды.Найти(ИмяКоманды);
		Если НоваяКоманда = Неопределено Тогда
			НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
			НоваяКоманда.Заголовок = Команда.Представление;
			НоваяКоманда.Действие = "Подключаемый_ВыполнитьКоманду";
		КонецЕсли;
		
		// Создание кнопки на форме и назначение ей команды
		Кнопка = Форма.Элементы.Найти(ИмяКоманды);
		Если Кнопка = Неопределено Тогда
			Кнопка = Форма.Элементы.Вставить(ИмяКоманды, Тип("КнопкаФормы"), ГруппаИнтеграция, Неопределено);
			Кнопка.ИмяКоманды = ИмяКоманды;
		КонецЕсли;
	КонецЦикла;		
КонецПроцедуры

Процедура ДобавитьКомандыНаФорму(Форма, ПараметрыРазмещения, КомандыПустаяТаблица)
    #Если Не ТолстыйКлиентОбычноеПриложение Тогда 
	СтруктураОписаниеФормы		= ПодготовитьСтруктуруОписанияФормы(Форма, ПараметрыРазмещения);
	
	МодульВстраиваниеВСтандартныеФормы = МодульВстраиваниеВСтандартныеФормы(); 
	МодульCore = МодульCore();
	
	УсловиеДЛяОтказаВывода = 
		// Форма исключения
		МодульВстраиваниеВСтандартныеФормы.ЭтоФормаИсключения(СтруктураОписаниеФормы)
		// Проверка прав
		Или НЕ МодульCore.ТекущемуПользователюМожноРаботатьСРасширением()
		// Проверка функциональной опции
		// Обънект с которым мы НЕ поддерживаем обмен
		Или НЕ МодульВстраиваниеВСтандартныеФормы.ЭтоВстраиваемыйОбъектМетаданных(СтруктураОписаниеФормы);
	Если УсловиеДЛяОтказаВывода Тогда 
		Возврат;
	КонецЕсли;	

// BSLLS:MissingTempStorageDeletion-off
// Удалять ни чего нельзя, нарушим работу подсистему команд
	КомандыТаблицаВрем = ПолучитьИзВременногоХранилища(Форма.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд);
// BSLLS:MissingTempStorageDeletion-on	
	Если КомандыТаблицаВрем = Неопределено Тогда
		КомандыТаблицаВрем = КомандыПустаяТаблица;
	КонецЕсли;
	ДобавитьКоманды(СтруктураОписаниеФормы, СтруктураОписаниеФормы.ТипыИсточников, Неопределено, КомандыТаблицаВрем);
	ПоместитьВоВременноеХранилище(КомандыТаблицаВрем, Форма.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд);
	
	СозданиеЭлементовУправленияНазначениеДействий(Форма, КомандыТаблицаВрем);
	#КонецЕсли
КонецПроцедуры

// См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииКомандПодключенныхКОбъекту
// BSLLS:CommentedCode-off

Процедура ДобавитьКоманды(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды) Экспорт
	ПолучитьСписокКоманд(НастройкиФормы["ТипыИсточников"], Команды);
КонецПроцедуры

// BSLLS:CommentedCode-on

Процедура ЗаполнитьКомандыМеню(КомандыМеню, МассивПунктовМеню, Порядок) 
	Для Каждого ПунктМеню Из МассивПунктовМеню Цикл 
		ИмяПунктаМеню = get_prop(ПунктМеню, "Name", get_prop(ПунктМеню, "NAME"));
		Действие = get_prop(ПунктМеню, "Action", get_prop(ПунктМеню, "ACTION"));
		Если Не ЗначениеЗаполнено(ИмяПунктаМеню) Или Не ЗначениеЗаполнено(Действие) Тогда
			Продолжить;
		КонецЕсли;	
		Если КомандыМеню[ИмяПунктаМеню] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		ПунктМеню.Вставить("Порядок", Порядок);
		КомандыМеню.Вставить(ИмяПунктаМеню, ПунктМеню);
		Порядок = Порядок + 1;
	КонецЦикла;	
КонецПроцедуры

// BSLLS:Typo-off
// Опечатка в названии метода отсутствует

Функция КомандаПунктаТулбара(ДействиеКоманды)
	ИмяКомандыОбменаДляФормыКлиент = ИмяКомандыОбменаДляФормыКлиент();
	ИмяКоманды = Неопределено;
	ActionСтрокой = "Action";
	Если ДействиеКоманды[ActionСтрокой] <> Неопределено Тогда
		ИмяКоманды = ИмяКомандыОбменаДляФормыКлиент + "." + ДействиеКоманды[ActionСтрокой];
	Иначе
		ACTION = ДействиеКоманды["ACTION"];
		ИмяКоманды = ПрефиксПродукта() + "КомандыОбменаДляФормыКлиент." + ACTION;
	КонецЕсли;
	Возврат ИмяКоманды;
КонецФункции
// BSLLS:Typo-on

Процедура ПолучитьСписокКомандИзНастроекПодключения(Источники, Команды, ВстраиваемоеМеню)
	КомандыМеню = Новый Соответствие;
	Порядок = 0;
	Для Каждого ТипЗначения Из Источники Цикл
		ОбъектМетаданных			= Метаданные.НайтиПоТипу(ТипЗначения);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяОбъектаМетаданных = ОбъектМетаданных.Имя;
		МассивПунктовМеню = ВстраиваемоеМеню[ИмяОбъектаМетаданных];
		Если МассивПунктовМеню = Неопределено Тогда
			Продолжить;		
		КонецЕсли;
		ЗаполнитьКомандыМеню(КомандыМеню, МассивПунктовМеню, Порядок);
	КонецЦикла;
	Если КомандыМеню.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивКомандМеню = Новый Массив;
	Для Каждого КомандаМеню Из КомандыМеню Цикл 
		Порядок = КомандаМеню.Значение["Порядок"];
		Если МассивКомандМеню.Количество() > Порядок Тогда
			МассивКомандМеню.Установить(Порядок,КомандаМеню.Значение);
		Иначе
			МассивКомандМеню.Вставить(Порядок,КомандаМеню.Значение);
		КонецЕсли;	
	КонецЦикла;
	
	Порядок = 1;
	Для Каждого КомандаМеню Из МассивКомандМеню Цикл 
		
		ИмяКоманды = КомандаПунктаТулбара(КомандаМеню);
		Если ИмяКоманды = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяКоманда = Новый Структура;
		НоваяКоманда.Вставить("Имя",       get_prop(КомандаМеню, "NAME"));
		НоваяКоманда.Вставить("Заголовок", get_prop(КомандаМеню, "TITLE"));
		НоваяКоманда.Вставить("Действие",  ИмяКоманды);
		НоваяКоманда.Вставить("Отключена", Ложь);
		НоваяКоманда.Вставить("Порядок",   Неопределено);
		НоваяКоманда.Вставить("ИмяИни",    Неопределено);
		НоваяКоманда.Вставить("ПараметрыВызова",  КомандаМеню);
		
		ДобавитьКомандуНаФорму1С(НоваяКоманда, Команды, Порядок);
        Порядок = Порядок + 1;
	КонецЦикла;
КонецПроцедуры

Процедура ПолучитьСписокКоманд( Источники, Команды ) Экспорт 

	ЕстьКомандыДляСправочников = Ложь;
	ЕстьКомандыДляСпрСотрудники = Ложь;
	ЕстьКомандыДляСпрФизЛица 	= Ложь;
	ЕстьКомандыДляДокументов   = Ложь;
	ВставитьКнопку	         = Ложь;
	ПорядокСчет = 1;
	
	Для Каждого ТипЗначения Из Источники Цикл
		
		ОбъектМетаданных			= Метаданные.НайтиПоТипу(ТипЗначения);
		ЕстьКомандыДляСправочников	= Метаданные.Справочники.Содержит(ОбъектМетаданных);
		Если ЕстьКомандыДляСправочников Тогда
			ЕстьКомандыДляСпрСотрудники = Найти(ОбъектМетаданных.Имя, "Сотрудники") > 0;
			ЕстьКомандыДляСпрФизЛица = Найти(ОбъектМетаданных.Имя, "ФизическиеЛица") > 0;
		КонецЕсли;
		ЕстьКомандыДляДокументов	= ЕстьКомандыДляДокументов ИЛИ Метаданные.Документы.Содержит(ОбъектМетаданных);
		Если ЕстьКомандыДляСправочников или ЕстьКомандыДляДокументов Тогда
			ВставитьКнопку = Истина;	
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	НазваниеПродукта = ЛокализацияНазваниеПродукта();
	ИмяКомандыОбменаДляФормыКлиент = ИмяКомандыОбменаДляФормыКлиент();
	
	Если ВставитьКнопку = Ложь Тогда
		Возврат;
	КонецЕсли;	
		
	ИмяИни		= "ИмяИни";
	Имя			= "Имя";
	Заголовок	= "Заголовок";
	Действие	= "Действие";
	Отключена	= "Отключена";
	Порядок		= "Порядок";
	
	ПорядокСчет = ПорядокСчет + 1;			
	НоваяКоманда = Новый Структура;
	НоваяКоманда.Вставить(Имя,       НазваниеПродукта + "_ЗагрузкаДокументов");
	НоваяКоманда.Вставить(Заголовок, "Загрузить в " + ЛокализацияНазваниеПродукта()); 
	НоваяКоманда.Вставить(Действие,  ИмяКомандыОбменаДляФормыКлиент + ".ЗагрузитьВСБИС");
	НоваяКоманда.Вставить(Отключена, Ложь);
	НоваяКоманда.Вставить(Порядок,   ПорядокСчет);
	НоваяКоманда.Вставить(ИмяИни,    Неопределено);
	
	ДобавитьКомандуНаФорму1С(НоваяКоманда, Команды, ПорядокСчет);
	
	ПорядокСчет = ПорядокСчет + 1;
	НоваяКоманда = Новый Структура;
	НоваяКоманда.Вставить(Имя,       НазваниеПродукта + "_ОткрытьВСБИС");
	НоваяКоманда.Вставить(Заголовок, "Открыть в " + ЛокализацияНазваниеПродукта()); 
	НоваяКоманда.Вставить(Действие,  ИмяКомандыОбменаДляФормыКлиент + ".ПриНажатииОткрытьВСБИСПолучитьUID");
	НоваяКоманда.Вставить(Отключена, Ложь);
	НоваяКоманда.Вставить(Порядок,   ПорядокСчет);
	НоваяКоманда.Вставить(ИмяИни,    Неопределено);
	
	ДобавитьКомандуНаФорму1С(НоваяКоманда, Команды, ПорядокСчет);		
	
	Если ЕстьКомандыДляСпрСотрудники ИЛИ НЕ ЕстьКомандыДляСправочников Тогда
		ПорядокСчет = ПорядокСчет + 1;
		НоваяКоманда = Новый Структура;			
		НоваяКоманда.Вставить(Имя,       НазваниеПродукта + "_ВыгрузитьВложенияИзСБИС");
		НоваяКоманда.Вставить(Заголовок, "Выгрузить вложения из " + ЛокализацияНазваниеПродукта()); 
		НоваяКоманда.Вставить(Действие,  ИмяКомандыОбменаДляФормыКлиент + ".ПриНажатииВыгрузитьВложенияИзСБИС");
		НоваяКоманда.Вставить(Отключена, Ложь);
		НоваяКоманда.Вставить(Порядок,   ПорядокСчет);
		НоваяКоманда.Вставить(ИмяИни,    Неопределено);
		
		ДобавитьКомандуНаФорму1С(НоваяКоманда, Команды, ПорядокСчет);
	КонецЕсли;

	Если ЕстьКомандыДляДокументов Тогда
		
		ПорядокСчет = ПорядокСчет + 1;
		НоваяКоманда = Новый Структура;			
		НоваяКоманда.Вставить(Имя,       НазваниеПродукта + "_ОбновитьСтатусы");
		НоваяКоманда.Вставить(Заголовок, "Обновить статусы"); 
		НоваяКоманда.Вставить(Действие,  ИмяКомандыОбменаДляФормыКлиент + ".ПриНажатииОбновитьСтатусы");
		НоваяКоманда.Вставить(Отключена, Ложь);
		НоваяКоманда.Вставить(Порядок,   ПорядокСчет);
		НоваяКоманда.Вставить(ИмяИни,    Неопределено);
		
		ДобавитьКомандуНаФорму1С(НоваяКоманда, Команды, ПорядокСчет);
		
	КонецЕсли;	
	
	Если ЕстьКомандыДляСпрСотрудники Тогда
		ПорядокСчет = ПорядокСчет + 1;	
		НоваяКоманда = Новый Структура;
		НоваяКоманда.Вставить(Имя,       НазваниеПродукта + "_УчаствуетВКЭДО");
		НоваяКоманда.Вставить(Заголовок, "Установить/Снять признак КЭДО"); 
		НоваяКоманда.Вставить(Действие,  ИмяКомандыОбменаДляФормыКлиент + ".УстановитьПризнакУчаствуетВКЭДО");
		НоваяКоманда.Вставить(Отключена, Ложь);
		НоваяКоманда.Вставить(Порядок,   ПорядокСчет);
		НоваяКоманда.Вставить(ИмяИни,    Неопределено);
		
		ДобавитьКомандуНаФорму1С(НоваяКоманда, Команды, ПорядокСчет);
		
		ПорядокСчет = ПорядокСчет + 1;	
		НоваяКоманда = Новый Структура;
		НоваяКоманда.Вставить(Имя,       НазваниеПродукта + "_ПолучитьПризнакКЭДО");
		НоваяКоманда.Вставить(Заголовок, "Получить признак КЭДО из " + НазваниеПродукта); 
		НоваяКоманда.Вставить(Действие,  ИмяКомандыОбменаДляФормыКлиент + ".ПолучитьПризнакУчаствуетВКЭДО");
		НоваяКоманда.Вставить(Отключена, Ложь);
		НоваяКоманда.Вставить(Порядок,   ПорядокСчет);
		НоваяКоманда.Вставить(ИмяИни,    Неопределено);
		
		ДобавитьКомандуНаФорму1С(НоваяКоманда, Команды, ПорядокСчет);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьКомандуНаФорму1С(Команда, Команды, Порядок)

	НазваниеПродукта = ЛокализацияНазваниеПродукта();
	НайденныеКоманды = Команды.НайтиСтроки(Новый Структура("Представление", Команда.Заголовок));
	Если НайденныеКоманды.Количество() > 0 Тогда 
		Возврат;
	КонецЕсли;
	ПодключаемаяКоманда = Команды.Добавить();
	ПодключаемаяКоманда.Вид                      = НазваниеПродукта+"_КОМАНДЫ"; //ВидПодключаемойКоманды();
	ПодключаемаяКоманда.Представление            = Команда.Заголовок;
	ПодключаемаяКоманда.Порядок                  = Порядок;
	ПодключаемаяКоманда.ТолькоВоВсехДействиях    = Ложь;
	ПодключаемаяКоманда.ТипПараметра             = Новый ОписаниеТипов(Новый Массив());
	ПодключаемаяКоманда.Назначение               = НазваниеПродукта;
	ПодключаемаяКоманда.ФункциональныеОпции      = "";
	ПодключаемаяКоманда.УсловияВидимости         = Новый Массив(); 
	ПодключаемаяКоманда.ИзменяетВыбранныеОбъекты = Ложь;
	ПодключаемаяКоманда.МножественныйВыбор       = Истина;
	ПодключаемаяКоманда.РежимЗаписи              = "НеЗаписывать";
	ПодключаемаяКоманда.ТребуетсяРаботаСФайлами  = Ложь;
	ПодключаемаяКоманда.ИзменяетВыбранныеОбъекты = Ложь;
	ПодключаемаяКоманда.Менеджер                 = "";
	ПодключаемаяКоманда.ИмяФормы                 = "";
	ПодключаемаяКоманда.ИмяВФорме        		 = ПодключаемаяКоманда.Вид + "_" + СтрЗаменить(Команда.Действие, ".", "_");
	ПодключаемаяКоманда.ИмяПараметраФормы        = "";
	ПодключаемаяКоманда.ПараметрыФормы           = Новый Структура("ИмяИни", Команда.ИмяИни);

	ПодключаемаяКоманда.Обработчик               = Команда.Действие;
	ПодключаемаяКоманда.ДополнительныеПараметры  = Новый Структура("ПараметрыВызова", get_prop(Команда, "ПараметрыВызова"));

КонецПроцедуры	

Функция ПроисходилЛиОбменДокументов( МассивСсылокНаДокументы, ДопПараметры=Неопределено) Экспорт 
	Обработка = Обработки[ИмяОбработки()].Создать();	
	Результат = Обработка.ПроисходилЛиОбменДокументов(МассивСсылокНаДокументы, ДопПараметры);	
	Возврат Результат; 
КонецФункции

Функция ПрочитатьСписокИнишекПоТипуИС(ТипИС, Действие = Неопределено) Экспорт 

	// Метод на вход будет получать ИмяИС и искать все инишки согласно блоку WORKSPACE META.
	// в нем будет передаваться title с красивым названием и в дальнейшем это название будет пришиваться к кнопке
	// например "Загрузить в СБИС", "Загрузить в СБИС как сотрудник 

	Результат = Новый Массив;
	Если ТипИС = "Сотрудники" Тогда
		ТранспортБлокли = Обработки[ИмяОбработки()].Создать();
		
		context_params = ТранспортБлокли.НастройкиПодключенияПрочитать();
		мИниФайлов	= Новый Массив();
		мИниФайлов.Добавить(Новый Структура("type, name", "Blockly", "Blockly_Сотрудники_read")); 
		мИниФайлов.Добавить(Новый Структура("type, name", "Blockly", "Blockly_ПрочийКадровыйДокументСотрудники_read"));
		
		params	= Новый Структура("props, ini", 
			Новый Структура("id, type_data", 
				context_params.ConnectionUuid,
				1),
			мИниФайлов);
		res = ТранспортБлокли.local_helper_integration_api(context_params, "IntegrationConnection.ReadConnection", params, "int-settings");
		
		Для Каждого _ини Из res["data"] Цикл
			title = СтрЗаменить(СтрЗаменить(_ини.Значение["data_name"],"Blockly_",""),"_read","");
			ini_name = СтрЗаменить(СтрЗаменить(_ини.Значение["data_name"],"Blockly_",""),"_read","");
			Результат.Добавить(Новый Структура("title,ini_name,xml",title,ini_name,_ини.Значение["data"] ));
		КонецЦикла;	 
		
	Иначе
		Результат.Добавить(Новый Структура); // здесь будут инишки в случае документов. Сейчас такого нет.
	КонецЕсли;

	Возврат Результат;

КонецФункции	

