Процедура ДобавитьКолонкиСтатусаФизЛица(Контекст, НаименованиеРеквизитаСписок, 
	ИмяКолонкиЛевогоСоединения = "Сотрудник", context_params = Неопределено)
// BSLLS:QueryParseError-off
	ТекстЗапросаСтатусФизЛица = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ДС.Объект КАК Справочник.ФизическиеЛица) КАК ФизЛицо,
	|	ВЫРАЗИТЬ(ДС.Значение КАК СТРОКА(1024)) КАК СтатусФизЛица
	|ПОМЕСТИТЬ СвойстваСтатус
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДС
	|ГДЕ
	|	НЕ ДС.Объект ЕСТЬ NULL
	|	И ДС.Свойство = &СвойствоОтбора
	|ИНДЕКСИРОВАТЬ ПО
	|	ФизЛицо
	|;
    |
	|////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ * ИЗ 
    |";
// BSLLS:QueryParseError-on	

	ПараметрыДопТаблицы = ИнициализироватьСтруктуруДопТаблицы();
	ПараметрыДопТаблицы.Вставить("ТаблицаДанных",		"СвойстваСтатус");
// BSLLS:UsingFindElementByString-off
	СвойствоОтбора = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("СтатусФизЛица");
// BSLLS:UsingFindElementByString-on	
	Фильтр = Новый Массив;
	Фильтр.Добавить(Новый Структура("Параметр, Значение", "СвойствоОтбора", СвойствоОтбора));
	ПараметрыДопТаблицы.Вставить("Фильтр",	Фильтр);
	ПараметрыДопТаблицы.Вставить("Псевдоним",			"СвойстваСтатус");
	ПараметрыДопТаблицы.Вставить("ИмяСпискаНаФорме",	НаименованиеРеквизитаСписок);
	ПараметрыДопТаблицы.Вставить("ВременнаяТаблица",	ТекстЗапросаСтатусФизЛица);
	ПараметрыДопТаблицы.Вставить("ИмяКолонкиЛевогоСоединения",	ИмяКолонкиЛевогоСоединения);
	ЗаполнитьСтруктуруПолейДляКолонкиСтатусФизЛица(Контекст, НаименованиеРеквизитаСписок, ПараметрыДопТаблицы);
	УспешноеВыполнение = ОбновитьЗапросДинамическогоСписка(Контекст.Форма, ПараметрыДопТаблицы);
	Если УспешноеВыполнение Тогда
		УспешноеВыполнение = ДобавитьКолонкиНаФорму(Контекст.Форма, ПараметрыДопТаблицы);
	КонецЕсли;
КонецПроцедуры

