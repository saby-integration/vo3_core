Функция ТекстЗапросаСвойстваПоВидамОбъектов(МассивТиповОбъепктов, Знач ИмяПараметра, Знач ИмяВременнойТаблицы)
// BSLLS:QueryParseError-off
// Собираем запрос частями

	Результат = "";
	СтрокаИмяВрТаблицы = "ПОМЕСТИТЬ " + ИмяВременнойТаблицы;
	СтрокаОбъединитьВсе = "ОБЪЕДИНИТЬ ВСЕ";
	МассивРезультат = Новый Массив;
	
	СчетСтрок = 0;
	Для Каждого ТипЗахвОбъекта Из МассивТиповОбъепктов Цикл
		СчетСтрок = СчетСтрок + 1;
		Если СчетСтрок = МассивТиповОбъепктов.Количество() Тогда
			СтрокаОбъединитьВсе = "";
		КонецЕсли;
		
		ТипМД = ТипМетаданного(ТипЗахвОбъекта);
		ИмяМД = ИмяТипаМетаданных(ТипЗахвОбъекта);
		
		МассивРезультат.Добавить(
					"ВЫБРАТЬ    
		           |	ВЫРАЗИТЬ(ДС.Объект КАК " + ТипМД + "." + ИмяМД + ") КАК Объект,
		           |	ДС.Значение КАК Значение");
		Если ЗначениеЗаполнено(СтрокаИмяВрТаблицы) Тогда
			МассивРезультат.Добавить(СтрокаИмяВрТаблицы);
		КонецЕсли;
		МассивРезультат.Добавить(
		           "ИЗ
		           |	РегистрСведений.ДополнительныеСведения КАК ДС
		           |ГДЕ
		           |	ДС.Свойство = &ИмяПараметра
				   |	И НЕ ВЫРАЗИТЬ(ДС.Объект КАК " + ТипМД + "." + ИмяМД + ") ЕСТЬ NULL");
		Если ЗначениеЗаполнено(СтрокаОбъединитьВсе) Тогда
			МассивРезультат.Добавить(СтрокаОбъединитьВсе);
		КонецЕсли;
	                   
		СтрокаИмяВрТаблицы = "";
	КонецЦикла;
	
	МассивРезультат.Добавить(
	           "
               |ИНДЕКСИРОВАТЬ ПО
               |	Объект
               |");
	Результат = СтрСоединить82(МассивРезультат, Символы.ПС);
	Результат = СтрЗаменить(Результат, "&ИмяПараметра", "&" + ИмяПараметра);
	Возврат Результат;
// BSLLS:QueryParseError-on	
КонецФункции

Процедура ДобавитьКолонкиСтатусаСостояния(ДанныеФормы, НаименованиеРеквизитаСписок, 
	ИмяКолонкиЛевогоСоединения = "Документ", context_params = Неопределено)
	МодульCore = МодульCore();
	СервисИнтеграции = МодульCore.get_prop(context_params, "service", "");
// BSLLS:UsingFindElementByString-off
	СвойствоСостояние = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(
		СервисИнтеграции + "ДокументСБИС_Статус");
// BSLLS:UsingFindElementByString-on	
	
    мСтрокиЗапроса = Новый Массив();
