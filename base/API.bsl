// Заполнение контекста при аутентификации
//
// Параметры:
//  ПараметрыВызова - Структура - параметры вызова.
//  context_param - Структура - Контекст.
//
//DynamicDirective
Процедура API_ADDON_ONAUTH(ПараметрыВызова, context_param = Неопределено) Экспорт
	Если context_param = Неопределено Тогда
		ИмяНастроек = ИмяПродукта();
		context_param	= ПрочитатьИзХранилища(ИмяНастроек, "params");
		Если context_param = Неопределено Тогда
			context_param = новый Структура;
		КонецЕсли;
	КонецЕсли;
	УРЛ = get_prop(ПараметрыВызова,"Url", Неопределено);
	Если ЗначениеЗаполнено(УРЛ) Тогда 
		УРЛ = РазобратьСтрокуУРЛ(УРЛ);
		context_param.Вставить("api_url", УРЛ.scheme +"://"+ УРЛ.host);
	КонецЕсли;     
	ВидТранспорта = ВидТранспорта(context_param);
	session = ПараметрыВызова["SessionId"];
	Если ВидТранспорта = "ExtSdk2" Или ВидТранспорта = "SabyPluginConnector"  Тогда 
		session = ТранспортИнтеграции.AuthenticateBySession(context_param, session);		
	КонецЕсли;	
	ТекущаяСессия = УИДСессии(context_param);
	ТекущийПользователь = СвойствоСессии(context_param, "user_fio");
	ПользовательВБраузере = get_prop(ПараметрыВызова, "UserFio");
	Если Не ТекущаяСессия = Неопределено И НЕ ТекущийПользователь = ПользовательВБраузере Тогда
		 Сообщить("Произошла смена авторизации по данным браузера"); 
	КонецЕсли;
	СтруктураСессии = Новый Структура;
	СтруктураСессии.Вставить("session", session );
	// BSLLS:DeprecatedCurrentDate-off
	СтруктураСессии.Вставить("session_begin", ТекущаяДата());
	// BSLLS:DeprecatedCurrentDate-on
	СтруктураСессии.Вставить("last_token_time", Неопределено);  
	ТранспортИнтеграции.ЗаписатьСессию(context_param, СтруктураСессии);
	ТранспортИнтеграции.ПослеАутентификации(context_param);
КонецПроцедуры

