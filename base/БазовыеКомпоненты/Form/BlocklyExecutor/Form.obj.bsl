&НаКлиенте
Процедура ЗапуститьINIФоновымЗаданием(Контекст) Экспорт
	МодульФоновогоЗаданияКлиент().ЗапуститьINIФоновымЗаданием(Контекст.algorithm, Контекст.ПараметрыВызова,
		Контекст.context_params, ЭтаФорма.ВладелецФормы, Контекст.НазваниеОперации, get_prop(Контекст, "ОповещениеОЗавершении"));
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьINI(Контекст) Экспорт 
	ТипТранспортаСервер = ТранспортИнтеграции.ЭтоСервер();
	Если ТипТранспортаСервер = Истина Тогда
		ЗапуститьINIФоновымЗаданием(Контекст); 
		Возврат;
	КонецЕсли;	
		
	context_param = НастройкиПодключенияПрочитать();

	ПараметрыВызова = ПодготовитьПараметрыЗапускINIФоновымЗаданием(Контекст.algorithm, Контекст.ПараметрыВызова, context_param);
	Результат = API_BLOCKLY_RUN(ПараметрыВызова);
	СтатусВыполнения = get_prop(Результат, "Status", "");
	ТекстОповещения = "";
	Если СтатусВыполнения = "run" Тогда
		Контекст.ПараметрыВызова.Вставить("CurrentBlock", get_prop(Результат, "CurrentBlock",""));
		ОбработчикСледующегоШага = Новый ОписаниеОповещения("ЗапуститьINI", ЭтаФорма, Контекст); 
		ВыполнитьКоманды_Клиент(ОбработчикСледующегоШага, Результат.commands, Результат.commands_data);
		Возврат;
	КонецЕсли;	
	РезультатВыгрузки = get_prop(Результат, "Result");
	Если СтатусВыполнения = "error" Тогда
		КартинкаОповещения = "Ошибка32";
		ТекстОповещения = СокрЛП(РезультатВыгрузки.message) + ". ";
		Если ТипЗнч(РезультатВыгрузки.detail) = Тип("Строка") Тогда
			ТекстОповещения = ТекстОповещения +  СокрЛП(РезультатВыгрузки.detail);
		КонецЕсли;
		// 
		ExtExceptionToJournal(РезультатВыгрузки);
	КонецЕсли;	
	Если СтатусВыполнения = "complete" Тогда
		ТекстОповещения = "Выполнено";		
		КартинкаОповещения = get_prop(РезультатВыгрузки, "Картинка","");
		Если ПустаяСтрока(КартинкаОповещения) Тогда
			КартинкаОповещения = "ЗеленаяГалка";
		КонецЕсли;
		КоличествоОбработано	= get_prop(РезультатВыгрузки, "CountConfirmed", 0);
		ВсегоОбъектов			= get_prop(РезультатВыгрузки, "CountObjects", 0);
		КоличествоОшибок		= get_prop(РезультатВыгрузки, "CountErrors", 0);
		КоличествоИгнорировано	= get_prop(РезультатВыгрузки, "CountIgnored", 0);
		Если	КоличествоОшибок > 0
			ИЛИ КоличествоОшибок + КоличествоОбработано + КоличествоИгнорировано <> ВсегоОбъектов Тогда
			СтатусВыполнения = "error";  
			ТекстОповещения = "Выполнено " + КоличествоОбработано + " из " + ВсегоОбъектов;
			КартинкаОповещения = "Ошибка32";
		КонецЕсли;	
	КонецЕсли;   
	НавигационнаяСсылкаОповещения = Неопределено; 
	МассивОперацийСНавигационнойСсылкой = Новый Массив;
	МассивОперацийСНавигационнойСсылкой.Добавить("Загрузка в " + ЛокализацияНазваниеПродукта());
	МассивОперацийСНавигационнойСсылкой.Добавить("Выгрузка в 1С");
	Если МассивОперацийСНавигационнойСсылкой.Найти(Контекст.НазваниеОперации) <> Неопределено Тогда
		НавигационнаяСсылкаОповещения = АдресСтраницыОтчетОЗагрузке(ПараметрыВызова["params"]["api_url"],
			get_prop(Результат,"ContextId", ""));
        НавигационнаяСсылкаОповещения = ПолучитьПрямуюССылку(НавигационнаяСсылкаОповещения);
	КонецЕсли;
	мСообщений = get_prop(РезультатВыгрузки, "detail", Неопределено);
	Если ТипЗнч(мСообщений) = Тип("Массив") Тогда
		ТекстОповещения_ = ТекстОповещения;
		Для Каждого ДанныеСообщения Из мСообщений Цикл
			ТекстОповещения		= get_prop(ДанныеСообщения, "message") + " " + get_prop(ДанныеСообщения, "detail");
			ПоказатьОповещениеПользователя(ТекстОповещения, НавигационнаяСсылкаОповещения,
				ТекстОповещения,БиблиотекаКартинок[КартинкаОповещения]);
		КонецЦикла;
		ТекстОповещения = ТекстОповещения_;
		Результат.Result.Вставить("detail", "");
	КонецЕсли;
	//Итоговое
	ПоказатьВажноеОповещениеПользователя(Контекст.НазваниеОперации, НавигационнаяСсылкаОповещения,
		ТекстОповещения, БиблиотекаКартинок[КартинкаОповещения]);
КонецПроцедуры

&НаКлиенте
Функция АдресСтраницыОтчетОЗагрузке(URL, extSyncDocId) 
	Возврат URL+"/ext-sync-doc/page/?extSyncDocId="+extSyncDocId; 	 	
КонецФункции

