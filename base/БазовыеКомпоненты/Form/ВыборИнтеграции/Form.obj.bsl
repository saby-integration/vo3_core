
&НаКлиенте
Процедура ТаблицаИнтеграцийВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)
	SystemId = Неопределено;
	Если ТипЗнч(ВыбраннаяСтрока) = Тип("Число") Тогда
		ТаблицаИнтеграций.НайтиПоИдентификатору(ВыбраннаяСтрока).Свойство("SystemId", SystemId);	
	Иначе
		SystemId = ВыбраннаяСтрока.SystemId;	
	КонецЕсли;	
	Оповестить("ВыбранаИнтеграция", SystemId);
	Если ЭтаФорма.Открыта() Тогда
		Закрыть();		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии()
	ЗаполнитьТаблицуИнтеграций(МассивИнтеграций);
КонецПроцедуры

