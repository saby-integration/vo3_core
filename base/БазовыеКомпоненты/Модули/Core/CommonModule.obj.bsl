Функция ЕстьПрофилиСПравамиРасширения()
	// BSLLS:SetPrivilegedMode-off Повысить права для выполнения запроса по ПрофилиГруппДоступа
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	// На Казахстане БСП имя формирует из синонима + " (Роль)" и нам ни когда не найти роль - ИмяОсновнойРоли()
	// поэтому першли на запрос
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ИОР.Ссылка КАК Ссылка,
		|	ИОР.Имя КАК Имя
		|ИЗ
		|	Справочник.ИдентификаторыОбъектовРасширений КАК ИОР
		|ГДЕ
		|	ИОР.Имя = &ИмяОбъектаРасширения";
	Запрос.УстановитьПараметр("ИмяОбъектаРасширения", ИмяОсновнойРоли());
	ВДЗ = Запрос.Выполнить().Выбрать();
	РольIntegration = Неопределено;
	Пока ВДЗ.Следующий() Цикл
		РольIntegration = ВДЗ.Ссылка;
	КонецЦикла;
	
	Если РольIntegration = Неопределено ИЛИ РольIntegration.Пустая() Тогда
		РезультатЗапроса = Ложь;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ПГД.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ПрофилиГруппДоступа.Роли КАК ПГД
			|ГДЕ
			|	ПГД.Роль = &РольIntegration";
		Запрос.УстановитьПараметр("РольIntegration", РольIntegration);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить().Количество() > 0;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат РезультатЗапроса;
КонецФункции

Функция ТекущемуПользователюМожноРаботатьСРасширением() Экспорт
	СписокРолей = РолиДляДоступаКФункционалу();
	
	РольНайдена = Ложь;
	Для Каждого ИмяРоли Из СписокРолей Цикл
		Если РольДоступна(ИмяРоли) ИЛИ ПривилегированныйРежим()  Тогда
			РольНайдена = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат РольНайдена;
КонецФункции

Функция ВключеноИспользованиеПодсистемыКЕДО() Экспорт
	ИспользованиеПодсистемыКЕДО = Ложь;
	ИмяФункциональнойОпцииКЭДО = ИмяФункциональнойОпцииКЭДО();
	Если Метаданные.ФункциональныеОпции.Найти(ИмяФункциональнойОпцииКЭДО) <> Неопределено Тогда
		ИспользованиеПодсистемыКЕДО = ПолучитьФункциональнуюОпцию(ИмяФункциональнойОпцииКЭДО);
	КонецЕсли;
	Возврат ИспользованиеПодсистемыКЕДО;
КонецФункции

Функция ОтправитьПриглашение(СписокСотрудников) Экспорт
	МодульОбъекта = ПолучитьОбъектОбработки();
	Возврат МодульОбъекта.ОтправитьПриглашение(СписокСотрудников);
КонецФункции

Функция ДанныеПоСотруднику(Сотрудник) Экспорт
	МодульОбъекта = ПолучитьОбъектОбработки();
	Возврат МодульОбъекта.ДанныеПоСотруднику(Сотрудник);	
КонецФункции	

