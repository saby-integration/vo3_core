&НаКлиенте
Функция ТипФайла(ИмяФайла) Экспорт
	ТипФайла = ИмяФайла;
	ЭлементыСтроки = Saby_СтрРазделить82(ИмяФайла, ".");
	Если ЭлементыСтроки.Количество() > 1 Тогда
		ТипФайла = ЭлементыСтроки[ЭлементыСтроки.Количество() - 1];
	КонецЕсли;
	Возврат ТипФайла;
КонецФункции

&НаКлиенте
Процедура ПИМСохранитьНаПодключении(ИдПодключения,МассивПИМ, Количество = 1)
	Если МассивПИМ.Количество() < Количество Тогда
		Возврат;
	КонецЕсли;
	ДопПараметры = Новый Структура("context_params", ЭтаФорма.context_params);
	ТранспортИнтеграции.ОбновитьПИМ(ИдПодключения, МассивПИМ, ДопПараметры);
	МассивПИМ = Новый Массив;
КонецПроцедуры

&НаКлиенте
Процедура ПИМВыборФайлаЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы = Неопределено Тогда   
		Возврат;
	КонецЕсли;
	МассивВыбранныхФайлов = Новый Массив;
	Каталог = get_prop(ДополнительныеПараметры, "Каталог", "");
	Для Каждого ВыбранныйФайл Из ВыбранныеФайлы Цикл
		Если ТипЗнч(ВыбранныйФайл) = Тип("Строка") Тогда 
			ИмяФайла = СтрЗаменить(ВыбранныйФайл, Каталог, "");
			ПолноеИмяФайла = ВыбранныйФайл;
		Иначе	
			ИмяФайла = ВыбранныйФайл.Имя; 
			ПолноеИмяФайла = ВыбранныйФайл.ПолноеИмя;
		КонецЕсли;	
		ТипФайла				= ТипФайла(ИмяФайла);
		ИмяФайлаБезРаширения	= СтрЗаменить(ИмяФайла, "." + ТипФайла, "");
		#Если ВебКлиент Тогда
			ФайлПИМ				= ПолучитьИзВременногоХранилища(ВыбранныйФайл.Хранение);
			УдалитьИзВременногоХранилища(ВыбранныйФайл.Хранение);
			ТекстПИМ			= ПолучитьСтрокуИзДвоичныхДанных(ФайлПИМ);
		#Иначе     
			ФайлПИМ = Новый ТекстовыйДокумент;
			ФайлПИМ.Прочитать(ПолноеИмяФайла, КодировкаТекста.UTF8);
			ТекстПИМ = ФайлПИМ.ПолучитьТекст();
		#КонецЕсли
       	СтруктураПИМ = Новый Структура;
		СтруктураПИМ.Вставить("Тип", ТипПИМФайла()); 
		СтруктураПИМ.Вставить("ИмяФайла", ИмяФайлаБезРаширения);
		СтруктураПИМ.Вставить("Содержимое", ТекстПИМ);
		МассивВыбранныхФайлов.Добавить(СтруктураПИМ);
		ПИМСохранитьНаПодключении(ЭтаФорма.ИдентификаторПодключения, МассивВыбранныхФайлов, 5);
	КонецЦикла;	
	ПИМСохранитьНаПодключении(ЭтаФорма.ИдентификаторПодключения, МассивВыбранныхФайлов);
	ЗаписатьСтатистикуПИМФайлов(ЭтаФорма.context_params, "Загрузка ПИМ-файла на подключение", ВыбранныеФайлы.Количество()); 
	ПИМОбновить(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПИМУдалить(Команда)
	МассивПимФайловИнтеграции = Новый Массив;
	МассивПимФайловПодключения = Новый Массив; 
	МассивФайлов = ПИМВыбранныеСтроки();

	Для Каждого Запись Из МассивФайлов Цикл 
		Если Запись.СтатусИзменения = -1 Тогда
			Продолжить;
		КонецЕсли;	
		СтруктураПИМ = Новый Структура;
		СтруктураПИМ.Вставить("Тип", Запись.DataType); 
		СтруктураПИМ.Вставить("ИмяФайла", Запись.Название);
		СтруктураПИМ.Вставить("Содержимое", Неопределено);
		Если Запись.СтатусПодключения = -1 Тогда
			МассивПимФайловИнтеграции.Добавить(СтруктураПИМ);
		Иначе
			МассивПимФайловПодключения.Добавить(СтруктураПИМ);
		КонецЕсли;	
	КонецЦикла;
    ПИМСохранитьНаПодключении(ЭтаФорма.ИдентификаторПодключения, МассивПимФайловПодключения);
    ПИМСохранитьНаПодключении(ЭтаФорма.context_params.IntegrationUuid, МассивПимФайловИнтеграции);
	ВсегоПимФайловПодключения = МассивПимФайловПодключения.Количество();
	ВсегоПимФайловИнтеграции  = МассивПимФайловИнтеграции.Количество();  
	Если ВсегоПимФайловПодключения > 0 Тогда
		ЗаписатьСтатистикуПИМФайлов(ЭтаФорма.context_params, "Удалить ПИМ-файл с подключения", ВсегоПимФайловПодключения);
	КонецЕсли;
	Если ВсегоПимФайловИнтеграции > 0 Тогда
		ЗаписатьСтатистикуПИМФайлов(ЭтаФорма.context_params, "Удалить ПИМ-файл с интеграции", ВсегоПимФайловПодключения);
	КонецЕсли;
	СообщениеПользователю = Новый СообщениеПользователю;
	СообщениеПользователю.Текст = "Программы интеграционных модулей удалены";
	ПИМОбновить(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПИМСохранить(Команда)
	ДиалогВыбораКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Заголовок = "Выберите каталог для сохранения";
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		СохранениеПИМНаДиск(ДиалогВыбораКаталога.Каталог);
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Программы интеграционных модулей сохранены в каталог";
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПИМНаДиск(МассивПИМ, Количество = 1, Каталог = "") 
	Если МассивПИМ.Количество() < Количество Тогда
		Возврат;
	КонецЕсли;
	ПИМСПодключения = ТранспортИнтеграции.ПрочитатьПИМИзSaby(ЭтаФорма.ИдентификаторПодключения, МассивПИМ, ЭтаФорма.context_params);
	Для Каждого ПИМ Из ПИМСПодключения Цикл 
		Содержимое = ПИМ.Значение;
		Если ТипЗнч(ПИМ.Значение) = Тип("Строка") Тогда
			Расширение = "xml";
		Иначе
			Расширение = "json";
			Содержимое = ТранспортИнтеграции.local_helper_json_encode(Содержимое);
		КонецЕсли;	
		ИмяФайла = Каталог + "\" + ПИМ.Ключ + "." + Расширение;
		Файл = Новый ТекстовыйДокумент;
		Файл.УстановитьТекст(Содержимое);
		Файл.Записать(ИмяФайла, КодировкаТекста.UTF8); 
	КонецЦикла;	
	МассивПИМ.Очистить();
КонецПроцедуры	

&НаКлиенте
Процедура СохранениеПИМНаДиск(Каталог)
	МассивПИМФайлов = ПИМВыбранныеСтроки();
	МассивПИМФайловДляСохранения = Новый Массив;
	Для Каждого Запись Из МассивПИМФайлов Цикл
		СтруктураПИМ = Новый Структура;
		СтруктураПИМ.Вставить("Тип", Запись.DataType); 
		СтруктураПИМ.Вставить("ИмяФайла", Запись.Название);
        МассивПИМФайловДляСохранения.Добавить(СтруктураПИМ);
		ЗаписатьПИМНаДиск(МассивПИМФайловДляСохранения, 5, Каталог);
	КонецЦикла;	 
	ЗаписатьПИМНаДиск(МассивПИМФайловДляСохранения, 1, Каталог);
	ЗаписатьСтатистикуПИМФайлов(ЭтаФорма.context_params, "Сохранить ПИМ-файл в каталог", МассивПИМФайлов.Количество()); 
КонецПроцедуры

&НаКлиенте
Процедура ПереносПИМНаИнтеграцию(МассивПИМФайлов, Количество = 1) 
	Если МассивПИМФайлов.Количество() < Количество Тогда
		Возврат;
	КонецЕсли;
	ПИМСПодключения = ТранспортИнтеграции.ПрочитатьПИМИзSaby(ЭтаФорма.ИдентификаторПодключения, МассивПИМФайлов, ЭтаФорма.context_params);  
	ОбогатитьМассивПИМСодержимым(МассивПИМФайлов, ПИМСПодключения);
	ПИМСохранитьНаПодключении(ЭтаФорма.context_params.IntegrationUuid, МассивПИМФайлов);  
	Для Каждого Запись Из МассивПИМФайлов Цикл
		Запись.Вставить("Содержимое", Неопределено);	
	КонецЦикла;	
	ПИМСохранитьНаПодключении(ЭтаФорма.ИдентификаторПодключения, МассивПИМФайлов);  		
	МассивПИМФайлов.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ПИМНаИнтеграцию(Команда)
	МассивПИМФайлов = ПИМВыбранныеСтроки();
	МассивПИМФайловДляПереноса = Новый Массив;
	Для Каждого Запись Из МассивПИМФайлов Цикл
		Если Запись.СтатусПодключения <> 0 Тогда
			Продолжить;
		КонецЕсли; 
		СтруктураПИМ = Новый Структура;
		СтруктураПИМ.Вставить("Тип", Запись.DataType); 
		СтруктураПИМ.Вставить("ИмяФайла", Запись.Название);
        МассивПИМФайловДляПереноса.Добавить(СтруктураПИМ);
		ПереносПИМНаИнтеграцию(МассивПИМФайловДляПереноса, 5);
	КонецЦикла;	
	ПереносПИМНаИнтеграцию(МассивПИМФайловДляПереноса);
	ЗаписатьСтатистикуПИМФайлов(ЭтаФорма.context_params, "Перенести ПИМ-файл на интеграцию", МассивПИМФайлов.Количество()); 
	ПИМОбновить(Неопределено); 
	СообщениеПользователю = Новый СообщениеПользователю;
	СообщениеПользователю.Текст = "Программы интеграционных модулей перенесены для всех пользователей";
КонецПроцедуры

&НаКлиенте
Процедура ПИМПутьККаталогуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) 
	СтандартнаяОбработка = Ложь;
	ДиалогВыбораКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Заголовок = "Выберите каталог для хранения ПИМ файлов";
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		ЭтаФорма.ПИМПутьККаталогу = ДиалогВыбораКаталога.Каталог;
   	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПИМФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)  
	ВыбраннаяСтрокаДанные = Элемент.ТекущиеДанные;
	Если ВыбраннаяСтрокаДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	АлгоритмИнтеграции = ВыбраннаяСтрокаДанные.Название;
	ОткрытьРедакторФайлов(АлгоритмИнтеграции);
КонецПроцедуры

