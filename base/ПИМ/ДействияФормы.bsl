	ДополнительныеПараметры.Вставить("ДействиеСПИМФайлами", 	"Загрузка копии ПИМ-файлов на подключение");
	ЗагрузитьПИМыВОблако(ДополнительныеПараметры);	
		
КонецПроцедуры

&НаКлиенте
Процедура ПИМЗагрузитьКопиюВОблакоНаИнтеграцию(Команда)
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("context_params", 			ЭтаФорма.context_params);
