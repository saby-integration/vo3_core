
&НаКлиенте
Процедура ЗаполнитьСтатусыПИМ(НоваяСтрока, Запись)
	ПИМСтатусПодключения = -1;
	ПИМСтатусИзменения = -1; 
	ScopeCustomStatus = get_prop(Запись, "ScopeCustomStatus", "");
	ScopePersonal = get_prop(Запись, "ScopePersonal", Ложь);
	Если ScopePersonal = Истина Тогда 
		ПИМСтатусПодключения = 0;	
	КонецЕсли;	
	Если ScopeCustomStatus = "Add" Тогда
		ПИМСтатусИзменения = 1;	
	КонецЕсли;
	Если ScopeCustomStatus = "Change" Тогда
		ПИМСтатусИзменения = 2;	
	КонецЕсли;
	НоваяСтрока.СтатусПодключения = ПИМСтатусПодключения; 
	НоваяСтрока.СтатусИзменения = ПИМСтатусИзменения;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокПимФайлов() 
	АвторизацияВыполнена	= ТранспортИнтеграции.УИДСессии(ЭтаФорма.context_params) <> Неопределено;  
	ЭлФорм = ПолучитьЭлементыФормы();
	ЭлФормСтраницаПИМ = ЭлФорм.Найти(ПИМИмяОбластиЭлементов());
	Если Не АвторизацияВыполнена Тогда 
		ЭлФормСтраницаПИМ.ТекущаяСтраница = 
			ПолучитьСтраницуНаКлиенте(ЭлФормСтраницаПИМ, "ПрограммыИнтеграционногоМодуляОграничения");
        Возврат;
	Иначе
		ЭлФормСтраницаПИМ.ТекущаяСтраница = 
			ПолучитьСтраницуНаКлиенте(ЭлФормСтраницаПИМ, "ПрограммыИнтеграционногоМодуляОсновная");	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РеквизитИдентификаторПодключения()) Тогда
		Возврат;
	КонецЕсли;
	КодПодключения = get_prop(ЭтаФорма.context_params, "Connection"); 
	ДопПараметры = Новый Структура("context_params", ЭтаФорма.context_params);
	Попытка // Убрать попытку после 26.3200
		СписокПИМ = ТранспортИнтеграции.СписокПИМ(КодПодключения, Ложь, ДопПараметры);
	Исключение
		СписокПИМ = Новый Массив;
	КонецПопытки;
	Для Каждого Запись Из СписокПИМ Цикл
		НоваяСтрока = ЭтаФорма.ПИМФайлы.Добавить();
		НоваяСтрока.Название = get_prop(Запись, "FileName");
		НоваяСтрока.Тип = get_prop(Запись, "Type");
		НоваяСтрока.Формат =  get_prop(Запись, "ApiType", "") + "/" + get_prop(Запись, "CustomisationType", ""); 
		НоваяСтрока.ИмяОбъектаИС =  get_prop(Запись, "ExtSysObjName");
		НоваяСтрока.ИмяОбъектаAPI3 = get_prop(Запись, "ObjName"); 
		НоваяСтрока.DataType = get_prop(Запись, "DataType"); 
		ЗаполнитьСтатусыПИМ(НоваяСтрока, Запись);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПимСнятьУстановитьОтметку(Команда)  
	ЭтаФорма.ПИМОтметка = Не ЭтаФорма.ПИМОтметка;
