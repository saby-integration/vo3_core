
&НаКлиенте
Процедура ЗаполнитьСтатусыПИМ(НоваяСтрока, Запись)
	ПИМСтатусПодключения = -1;
	ПИМСтатусИзменения = -1; 
	ScopeCustomStatus = get_prop(Запись, "ScopeCustomStatus", "");
	ScopePersonal = get_prop(Запись, "ScopePersonal", Ложь);
	Если ScopePersonal = Истина Тогда 
		ПИМСтатусПодключения = 0;	
	КонецЕсли;	
	Если ScopeCustomStatus = "Add" Тогда
		ПИМСтатусИзменения = 1;	
	КонецЕсли;
	Если ScopeCustomStatus = "Change" Тогда
		ПИМСтатусИзменения = 2;	
	КонецЕсли;
	НоваяСтрока.СтатусПодключения = ПИМСтатусПодключения; 
	НоваяСтрока.СтатусИзменения = ПИМСтатусИзменения;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокПимФайлов() 
	АвторизацияВыполнена	= ТранспортИнтеграции.УИДСессии(ЭтаФорма.context_params) <> Неопределено;  
	ЭлФорм = ПолучитьЭлементыФормы();
	ЭлФормСтраницаПИМ = ЭлФорм.Найти(ПИМИмяОбластиЭлементов());
	Если Не АвторизацияВыполнена Тогда 
		ЭлФормСтраницаПИМ.ТекущаяСтраница = 
			ПолучитьСтраницуНаКлиенте(ЭлФормСтраницаПИМ, "ПрограммыИнтеграционногоМодуляОграничения");
        Возврат;
	Иначе
		ЭлФормСтраницаПИМ.ТекущаяСтраница = 
			ПолучитьСтраницуНаКлиенте(ЭлФормСтраницаПИМ, "ПрограммыИнтеграционногоМодуляОсновная");	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РеквизитИдентификаторПодключения()) Тогда
		Возврат;
	КонецЕсли;
	КодПодключения = get_prop(ЭтаФорма.context_params, "Connection"); 
	ДопПараметры = Новый Структура("context_params", ЭтаФорма.context_params);
	Попытка // Убрать попытку после 26.3200
		СписокПИМ = ТранспортИнтеграции.СписокПИМ(КодПодключения, Ложь, ДопПараметры);
	Исключение
		СписокПИМ = Новый Массив;
	КонецПопытки;
	Для Каждого Запись Из СписокПИМ Цикл
		НоваяСтрока = ЭтаФорма.ПИМФайлы.Добавить();
		НоваяСтрока.Название = get_prop(Запись, "FileName");
		НоваяСтрока.Тип = get_prop(Запись, "Type");
		НоваяСтрока.Формат =  get_prop(Запись, "ApiType", "") + "/" + get_prop(Запись, "CustomisationType", ""); 
		НоваяСтрока.ИмяОбъектаИС =  get_prop(Запись, "ExtSysObjName");
		НоваяСтрока.ИмяОбъектаAPI3 = get_prop(Запись, "ObjName"); 
		НоваяСтрока.DataType = get_prop(Запись, "DataType"); 
		ЗаполнитьСтатусыПИМ(НоваяСтрока, Запись);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПимСнятьУстановитьОтметку(Команда)  
	ЭтаФорма.ПИМОтметка = Не ЭтаФорма.ПИМОтметка;
	Для Каждого Запись Из ЭтаФорма.ПИМФайлы Цикл  
		Запись.Отметка = ЭтаФорма.ПИМОтметка;	
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьОтобразитьГруппуКопиюИзКаталогаНастройки()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.ГруппаКопияИзКаталогаНастройки.Видимость = ЭтаФорма.ПИМИспользоватьКопиюИзКаталога;
КонецПроцедуры

&НаКлиенте
Процедура ПИМИспользоватьКопиюИзКаталогаПриИзменении(Элемент)
	СкрытьОтобразитьГруппуКопиюИзКаталогаНастройки();
КонецПроцедуры

&НаКлиенте
Процедура ПИМОбновить(Команда)
	ЭтаФорма.ПИМФайлы.Очистить();
	ЗаполнитьСписокПимФайлов();
	ЭтаФорма.ПИМОтметка = Ложь;	
КонецПроцедуры

&НаКлиенте
Процедура ПИМДобавить(Команда)
	ОткрытьРедакторФайловНастроекНажатие(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПИМВыгрузитьКопиюИзОблакаНажатие(Элемент)
	ЗаголовокДействие = "Выгрузка копии ПИМ-файлов в каталог";
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("context_params", ЭтаФорма.context_params);
	ДополнительныеПараметры.Вставить("ХранилищеАлгоритмов", ЭтаФорма.ПИМПутьККаталогу);
	
	ПараметрыМетодаПИМ = Новый Структура();
	ПараметрыМетодаПИМ.Вставить("ИмяМетода", "ВыгрузитьПИМыИзОблака");
	ПараметрыМетодаПИМ.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	ПараметрыМетодаПИМ.Вставить("Заголовок", ЗаголовокДействие);
	
	ЗапуститьОповещениеПриНаличииСессии("ПИМЗапуститьОбменСОблаком", ЭтаФорма, ПараметрыМетодаПИМ);
КонецПроцедуры

&НаКлиенте
Процедура ПИМЗагрузитьКопиюВОблакоНаПодключениеНажатие(Элемент)
	ЗаголовокДействие = "Загрузка копии ПИМ-файлов на подключение";
	ИдентификаторПодключения = ЭтаФорма.ИдентификаторПодключения;
	ПИМЗагрузитьКопиюВОблако(ИдентификаторПодключения, ЗаголовокДействие);
КонецПроцедуры

&НаКлиенте
Процедура ПИМЗагрузитьКопиюВОблакоНаИнтеграциюНажатие(Элемент)
	ЗаголовокДействие = "Загрузка копии ПИМ-файлов на интеграцию";
	ИдентификаторПодключения = ЭтаФорма.context_params.IntegrationUuid;
	ПИМЗагрузитьКопиюВОблако(ИдентификаторПодключения, ЗаголовокДействие);
КонецПроцедуры

&НаКлиенте
Процедура ПИМЗагрузитьКопиюВОблако(ИдентификаторПодключения, ЗаголовокДействие)
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("context_params", 			ЭтаФорма.context_params);
	ДополнительныеПараметры.Вставить("ХранилищеАлгоритмов", 	ЭтаФорма.ПИМПутьККаталогу);
	ДополнительныеПараметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	ДополнительныеПараметры.Вставить("ДействиеСПИМФайлами", 	ЗаголовокДействие);
	
	ПараметрыМетодаПИМ = Новый Структура();
	ПараметрыМетодаПИМ.Вставить("ИмяМетода", "ЗагрузитьПИМыВОблако");
	ПараметрыМетодаПИМ.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	ПараметрыМетодаПИМ.Вставить("Заголовок", ЗаголовокДействие);
	
	ЗапуститьОповещениеПриНаличииСессии("ПИМЗапуститьОбменСОблаком", ЭтаФорма, ПараметрыМетодаПИМ);
КонецПроцедуры

&НаКлиенте
Процедура ПИМЗапуститьОбменСОблакомНаКлиенте(ПараметрыВыполнения) 
	ИмяМетода = get_prop(ПараметрыВыполнения, "ИмяМетода");
	Если ИмяМетода = "ЗагрузитьПИМыВОблако" Тогда
		ЗагрузитьПИМыВОблако(get_prop(ПараметрыВыполнения, "ДополнительныеПараметры"), Неопределено);	
	ИначеЕсли ИмяМетода = "ВыгрузитьПИМыИзОблака" Тогда	
		ВыгрузитьПИМыИзОблака(get_prop(ПараметрыВыполнения, "ДополнительныеПараметры"), Неопределено);	
	Иначе
		Возврат;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПИМЗапуститьОбменСОблаком(Результат = Неопределено, ДопПараметры = Неопределено) Экспорт
	ТекстСообщения = "Обмен ПИМ с облаком.";
	Картинка = КартинкаУспешно();
	
	ВидТранспорта = ВидТранспорта(context_params);
	Если ВидТранспорта = "ExtSdk" Или ВидТранспорта = "ExtSdkCrypto" Или ВидТранспорта = "SabyPluginConnector"  Тогда   
		ПИМЗапуститьОбменСОблакомНаКлиенте(ДопПараметры);
		ПоказатьОповещениеПользователя(ДопПараметры.Заголовок + " завершен.", ,
			ТекстСообщения,
			Картинка,
			СтатусОповещенияПользователя.Важное,
			Новый УникальныйИдентификатор); 
		ПИМОбновить(Неопределено);	
		Возврат;
	КонецЕсли; 
	
	Попытка
		ЗапускФоновогоОбмена(
			ДопПараметры.ИмяМетода,
			ДопПараметры.ДополнительныеПараметры,
			ДопПараметры.Заголовок,
			"ПИМОбновитьСписок");
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		СтруктураОшибки = ExtExceptionAnalyse(ИнфоОбОшибке);
		Картинка = КартинкаОшибка();
		ТекстСообщения = СтруктураОшибки.message;
	КонецПопытки;
КонецПроцедуры

