&НаСервере
Процедура ДополнитьИнформациюОДокументе1С() 
	tUID = Новый ТаблицаЗначений;
	tUID.Колонки.Добавить("UID", Новый ОписаниеТипов("Строка") );
    НовСтрока = tUID.Добавить();
	НовСтрока.UID = Идентификатор;
    МодульОбъекта = МодульОбъекта();
	ТаблицаСсылок = МодульОбъекта.СтатусыДокументовПолучитьСостоянияОбъектов(tUID);
	
	Если ТаблицаСсылок.Количество() > 0 Тогда 
		ЭтаФорма.Документ1С = get_prop(ТаблицаСсылок.Получить(0), "Link", Неопределено);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТабличнуюЧастьФормы( Действие, ДополнительныеПараметры ) Экспорт 
	Если ЗначениеЗаполнено(ДокументСБИС) Тогда 
		ДокументСБИС = ПрочитатьДокумент();
		ЗаполнитьШапкуПоДокументуСБИС(ДокументСБИС);
	КонецЕсли;	
	ЗаполнитьПрохождение(ДокументСБИС);
	ЗаполнитьВложения(ДокументСБИС);
	ДополнитьИнформациюОДокументе1С();	
	ОбновитьДанныеНаФорме(ЭтаФорма);
КонецПроцедуры

