&НаКлиенте
Функция СписокДоступныхИнишек(ИмяОбъектаИС)
	context_params	= ПроверитьНаличиеПараметровПодключенияНаСервере();
	ТранспортИнтеграции = ПолучитьФормуТранспорта(context_params);
	мИниФайлов	= Новый Массив();
	мИниФайлов.Добавить(Новый Структура("type, name", "Система", "ОбъектыСинхBlockly"));
	params	= Новый Структура(
			"props, ini",
			Новый Структура("id, type_data, requested_ini_format", context_params.ConnectionUuid, 1, "Dom1C"), мИниФайлов);
	res = ТранспортИнтеграции.local_helper_integration_api(context_params, "IntegrationConnection.ReadConnection", params, "int-settings");
	ОбъектыИСОбъектыСБИС = get_prop(get_prop(get_prop(res, "data"), "ОбъектыСинхBlockly"), "data");
	ОбъектыИС = get_prop(ОбъектыИСОбъектыСБИС, "ОбъектыИС");
	// ОбъектыСБИС = get_prop(ОбъектыИСОбъектыСБИС, "Объекты");
	Если ОбъектыИС[ИмяОбъектаИС] = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;	
	Возврат ОбъектыИС[ИмяОбъектаИС];
КонецФункции

&НаКлиенте
Процедура ПослеОтправитьВСБИС( Действие, ДополнительныеПараметры ) Экспорт 
	ЭтаФорма.Закрыть();		
КонецПроцедуры

&НаКлиенте
Процедура HTMLВложенияПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЭлементСобытия = ДанныеСобытия.srcElement;
	#Иначе
		ЭлементСобытия = ДанныеСобытия.Element;
	#КонецЕсли
	Если ЭлементСобытия["id"] = "Открыть" Тогда
		ЭлементыФормочки = ПолучитьЭлементыФормы(); 
		ТекущиеДанные = ЭлементыФормочки.Вложения.ТекущиеДанные; 
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;	
		ФайлДвоичныеДанные = ТранспортИнтеграции.local_helper_download_from_link(context_params, ТекущиеДанные.ФайлСсылка);
		// BSLLS:TempFilesDir-off Для совместимости с 8.2
		// BSLLS:UsingSynchronousCalls-off
		ИмяФайла = КаталогВременныхФайлов() + ТекущиеДанные.ФайлИмя;
		// BSLLS:TempFilesDir-on
		// BSLLS:UsingSynchronousCalls-on	
		ФайлДвоичныеДанные.Записать(ИмяФайла);
		// BSLLS:UsingSynchronousCalls-off Для совместимости с 8.2
		ЗапуститьПриложение(ИмяФайла);
		// BSLLS:UsingSynchronousCalls-on	
	КонецЕсли;	
КонецПроцедуры

