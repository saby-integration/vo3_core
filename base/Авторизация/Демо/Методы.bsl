&НаКлиенте
Процедура СтраницаДемоВходаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	ЭлементСобытия = ЭлементСобытияПоляHTML(ДанныеСобытия);
	ЭлементСобытия = ОбъектПродуктДемо(ЭлементСобытия);
	Если ТипЗнч(ЭлементСобытия) = Тип("ВнешнийОбъект") Тогда
		Попытка
			ИмяПродукта = ЭлементСобытия["id"];
			ДемоАвторизацияВыбраннымПродуктом(ИмяПродукта);
		Исключение
			// ИнфоОбОшибке = ИнформацияОбОшибке();
			// СтруктураОшибки = ExtExceptionAnalyse(ИнфоОбОшибке);
		КонецПопытки;
	КонецЕсли;	
КонецПроцедуры

