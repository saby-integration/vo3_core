	Попытка
		result = local_helper_exec_method(context_params, "СБИС.ПрочитатьСотрудника", params, Ложь);
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		Возврат ИнфОбОшибке;
	КонецПопытки;
	Возврат result;
КонецФункции

