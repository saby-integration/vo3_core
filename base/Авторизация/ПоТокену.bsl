Функция АвторизоватьсяПриложением(ИДПриложения, КлючПриложения, КлючАутентификации, context_params) Экспорт 
	
	Попытка
		params = Новый Структура("app_client_id, app_secret, secret_key", ИДПриложения, КлючПриложения, КлючАутентификации);  
		url = СтрЗаменить(context_params.api_url, "ie-1c","online");
		
		url = url + "/oauth/service/";
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ВызватьИсключение NewExtExceptionСтрока(ИнфОбОшибке,"Не заполнен параметр аутентификации",ИнфОбОшибке.Описание,,,"Unauthorized" );
	КонецПопытки;
	Попытка
		result = local_helper_exec_method(context_params, "", params, Ложь, ,url);
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ВызватьИсключение NewExtExceptionСтрока(ИнфОбОшибке,,,,,"Unauthorized" );
	КонецПопытки;
	
	Возврат get_prop(result,"sid");
КонецФункции

