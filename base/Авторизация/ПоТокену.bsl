//DynamicDirective

Функция СоздаватьСотрудникаПоПрофилю(ДанныеСотрудника, Настройки)
	СоздаватьСотрудника = Ложь;
	Для Каждого Стр Из Настройки.Профили Цикл
		Для Каждого Элемент Из ДанныеСотрудника.Права.Роль Цикл
			Если Стр.Наименование = Элемент.Название Тогда
				СоздаватьСотрудника = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;						
	КонецЦикла;
    Возврат СоздаватьСотрудника;
КонецФункции	

//DynamicDirective

Функция ТокенДляТекущегоПользователяПоAPI(ДанныеСотрудника, context_params) Экспорт
	Настройки = ПрочитатьИзХранилища("СБИС", "Авторизация",,"ПользовательСБИС");
	Если Настройки = Неопределено Тогда
		ТекстОшибки = "Не заполнены данные администратора системы для авторизации по токену.";
		ВызватьИсключение NewExtExceptionСтрока(, ТекстОшибки, , , , "Unauthorized");
	КонецЕсли;
	Если Настройки.Свойство("ВидБесшовнойАвторизации") И Настройки.ВидБесшовнойАвторизации = 1 Тогда	
		ИдентификаторСессииАдминистратора = АвторизоватьсяПриложением(Настройки.ИДПриложения, Настройки.КлючПриложения, Настройки.КлючАутентификации, context_params);	
	Иначе	
		ИдентификаторСессииАдминистратора = АвторизоватьсяПоЛогинуПаролю(Настройки.Логин, Настройки.Пароль, context_params);	
	КонецЕсли;
	
	Если ИдентификаторСессииАдминистратора = Неопределено Тогда
		ТекстОшибки = "Не удалось получить сессию администратора. Проверьте настройки бесшовной авторизации.";
		ВызватьИсключение NewExtExceptionСтрока(, ТекстОшибки, , , , "Unauthorized");	
	КонецЕсли;	
	session = Новый Структура;
	session.Вставить("session", ИдентификаторСессииАдминистратора);
	// BSLLS:DeprecatedCurrentDate-off
	session.Вставить("session_begin", ТекущаяДата());
	// BSLLS:DeprecatedCurrentDate-on
    ЗаписатьСессию(context_params, session); 
	
	ИдСотрИС = ДанныеСотрудника.Сотрудник.ИдентификаторИС;

	Токен = ТокенПоИдентификатору(ИдСотрИС, context_params);
	
	Если ЗначениеЗаполнено(Токен) Тогда 
		Возврат Токен;
	КонецЕсли;	
	СтруктураРезультата = сбисПрочитатьСотрудника(ДанныеСотрудника.Сотрудник.ИдентификаторИС, context_params);
	Если ТипЗнч(СтруктураРезультата) = Тип("ИнформацияОбОшибке") Тогда
		Описание = ЗначениеИзСтрокиВнутрНаСервере(СтруктураРезультата.Описание); 
		message = get_prop(Описание,"message");
		Если Лев(message, 27) <> "Не удалось найти сотрудника" Тогда 
			ВызватьИсключение NewExtExceptionСтрока(СтруктураРезультата, , , , , "Unauthorized");
		КонецЕсли;
		СоздаватьСотрудника = СоздаватьСотрудникаПоПрофилю(ДанныеСотрудника, Настройки);
		Если Не СоздаватьСотрудника Тогда 
			ВызватьИсключение NewExtExceptionСтрока(СтруктураРезультата, , , , , "Unauthorized");
		КонецЕсли;	
		СтруктураРезультата = сбисЗаписатьСотрудникаНаСервере(ДанныеСотрудника, context_params);
		Если ТипЗнч(СтруктураРезультата) = Тип("ИнформацияОбОшибке") Тогда
			ВызватьИсключение NewExtExceptionСтрока(СтруктураРезультата, , , , , "Unauthorized");
		КонецЕсли; 	
	КонецЕсли;
	СтруктураРезультата = get_prop(СтруктураРезультата,"result");
	Сотрудник = get_prop(СтруктураРезультата,"Сотрудник");
	ИдСотрудникаСБИС = get_prop(Сотрудник,"Идентификатор");
	СтруктураРезультата = УстановитьСвязиЛиц(ДанныеСотрудника.Сотрудник.ИдентификаторИС, ИдСотрудникаСБИС, context_params);    
	Если ТипЗнч(СтруктураРезультата) = Тип("ИнформацияОбОшибке") Тогда
		ВызватьИсключение NewExtExceptionСтрока(СтруктураРезультата, , , , , "Unauthorized");
	КонецЕсли;		
	
	Токен = ТокенПоИдентификатору(ИдСотрИС, context_params);
	
	Возврат Токен;
КонецФункции
