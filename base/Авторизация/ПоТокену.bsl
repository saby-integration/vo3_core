//DynamicDirective

Функция ТокенДляТекущегоПользователя(context_params) Экспорт
	
	ДанныеСотрудника = ДанныеТекущегоПользователяНаСервере();
	
	ИдСотрИС = ДанныеСотрудника.Сотрудник.ИдентификаторИС;
	Если ИдСотрИС = "00000000-0000-0000-0000-000000000000" Тогда  
		ВызватьИсключение NewExtExceptionСтрока(,"Не удалось получить идентификатор сотрудника. Возможно текущий пользователь 1С не связан с физическим лицом.",,,,"Unauthorized" );
	КонецЕсли;
	
	context_params_API = Новый Структура;
	Для Каждого КлючИЗначение Из context_params Цикл
		context_params_API.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение); 
	КонецЦикла;
	context_params_API.Вставить(ИмяСвойстваТранспорта(), "API");	
	Результат = ТокенДляТекущегоПользователяПоAPI(ДанныеСотрудника, context_params_API);
	Возврат Результат
КонецФункции

