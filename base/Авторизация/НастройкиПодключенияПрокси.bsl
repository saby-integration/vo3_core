&НаКлиенте
Процедура ПроверитьРаботуКомпоненты() 
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.ОшибкаНастройки.Заголовок = "";
	Если exchange_method <> "SabyPluginConnector" Тогда
		Возврат;
	КонецЕсли;
	Попытка 
		ПутьКомпоненты = ПолучитьПутьКомпоненты(exchange_method);
		Выполнить("НачатьУстановкуВнешнейКомпоненты(, ПутьКомпоненты)");
	Исключение  
		Попытка
			// BSLLS:UsingSynchronousCalls-off
			УстановитьВнешнююКомпоненту(ПутьКомпоненты);
			// BSLLS:UsingSynchronousCalls-on
		Исключение
			ИнфОбОшибке = ИнформацияОбОшибке();
			ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
			ЭлементыФормочки.ОшибкаНастройки.Заголовок = ExtExceptionToMessage(ОшибкаСтруктура);
		КонецПопытки;
	КонецПопытки;	
КонецПроцедуры

