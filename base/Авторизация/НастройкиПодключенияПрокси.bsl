&НаКлиенте
Процедура СформироватьУРЛ()
	api_url = "https://" + ПрефиксКонтур() + ПрефиксГОСТ() + Domain + "." + Country;
	ЭтаФорма.context_params.Вставить("ApiUrl", api_url);
	ЭтаФорма.context_params.Вставить(ИмяСвойстваТранспорта(), ЭтаФорма.exchange_method);
	ЭтаФорма.context_params.Вставить("GostTls", GostTls);
	ЭтаФорма.context_params.Вставить("Country", Country);
	ЭтаФорма.context_params.Вставить("Domain", Domain);
	ЭтаФорма.context_params.Вставить("Contour", Contour);
	ЭтаФорма.context_params.Вставить("AuthSSOUrl", AuthSSOUrl);
КонецПроцедуры

 &НаКлиенте
Функция ПрефиксКонтур()
	Если ЗначениеЗаполнено(Contour) Тогда
		Префикс = Contour + "-";
	Иначе
		Префикс = "";
	КонецЕсли;
	Возврат Префикс;	
КонецФункции

&НаКлиенте
Функция ПрефиксГОСТ()
	Если GostTls = Ложь Тогда
		Префикс = "online.";
	Иначе
		Префикс = "g.";
	КонецЕсли;
	Возврат Префикс;	
КонецФункции

&НаКлиенте
Процедура СпособОбменаПриИзменении(Элемент)
	УстановитьВидимостьВключенияГОСТШифрования();
	УстановитьВидимостьНастроекСпособаОбмена();
	УстановитьВидимостьГОСТШифрования();
	СформироватьУРЛОбновитьЗаголовок();
	ПроверитьРаботуКомпоненты();
	УстановитьВидимостьНастроекПрокси();
	УстановитьДоступностьХраненияНастроек();
	СпособОбменаПриИзмененииПереопределяемый(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьНастроекСпособаОбмена()
	ЭлФорм = ПолучитьЭлементыФормы();
	ЭлФорм.НастройкиСпособаОбменаПраво.ТекущаяСтраница = ПолучитьСтраницуНаКлиенте(ЭлФорм.НастройкиСпособаОбменаПраво, exchange_method);
	ЭлФорм.НастройкиСпособаОбменаНиз.ТекущаяСтраница = ПолучитьСтраницуНаКлиенте(ЭлФорм.НастройкиСпособаОбменаНиз, "Настройки" + exchange_method);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьНастроекПрокси()
	// BSLLS:LineLength-off
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	Если ЭтоВидТранспортаExtSdk(context_params) Тогда
		ЭлементыФормочки.ГруппаПараметрыПрокси.ТекущаяСтраница = ПолучитьСтраницуНаКлиенте(ЭлементыФормочки.ГруппаПараметрыПрокси, "ПараметрыПроксиНедоступны");
		ЭлементыФормочки.ПроксиПлагин.Заголовок = "Используются параметры прокси десктопного приложения " + ЛокализацияНазваниеПродукта();
	ИначеЕсли exchange_method = "SabyConnect" И Найти(ЭтаФорма.Заголовок, "Настройки") = 0 Тогда
		ЭлементыФормочки.ГруппаПараметрыПрокси.ТекущаяСтраница = ПолучитьСтраницуНаКлиенте(ЭлементыФормочки.ГруппаПараметрыПрокси, "ПараметрыПроксиКаталог");	
	ИначеЕсли exchange_method = "SabyConnect" И Найти(ЭтаФорма.Заголовок, "Настройки") > 0 Тогда
		ЭлементыФормочки.ГруппаПараметрыПрокси.ТекущаяСтраница = ПолучитьСтраницуНаКлиенте(ЭлементыФормочки.ГруппаПараметрыПрокси, "ПараметрыПроксиКаталогНастройки");				
	Иначе
		ЭлементыФормочки.ГруппаПараметрыПрокси.ТекущаяСтраница = ПолучитьСтраницуНаКлиенте(ЭлементыФормочки.ГруппаПараметрыПрокси, "ПараметрыПроксиДоступны");		
		УстановитьЗаголовокПроксиИнфо();
	КонецЕсли;
	// BSLLS:LineLength-on
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьХраненияНастроек()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	Если exchange_method = "SabyConnect" Тогда
		ЭтаФорма.ИспользоватьНастройкиИзКаталога = Истина;
		ЭлементыФормочки.ИспользоватьНастройкиИзКаталога.Доступность = Ложь;
	Иначе
		ЭтаФорма.ИспользоватьНастройкиИзКаталога = get_prop(context_params, "ИспользоватьНастройкиИзКаталога", Ложь);
		ЭлементыФормочки.ИспользоватьНастройкиИзКаталога.Доступность = Истина;		
	КонецЕсли;
	ИспользоватьНастройкиИзКаталогаПриИзменении(ЭтаФорма.ИспользоватьНастройкиИзКаталога);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьВключенияГОСТШифрования()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлемShowGostTls = ЭлементыФормочки.Найти("ShowGostTls" + exchange_method);
	Если ЭлемShowGostTls <> Неопределено Тогда
		ЭлемShowGostTls.Видимость = Country = "ru";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьГОСТШифрования()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлемGostTls = ЭлементыФормочки.Найти("GostTls" + exchange_method);
	Если ЭлемGostTls <> Неопределено Тогда 
		ЭлемGostTls.Видимость = Country = "ru" И ShowGostTls > 6;
		Если Не ЭлемGostTls.Видимость тогда
			ЭтаФорма.GostTls = Ложь;
		КонецЕсли;
	Иначе
		ЭтаФорма.GostTls = Ложь;	
	КонецЕсли;
КонецПроцедуры

