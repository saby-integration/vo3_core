Функция ПолучитьПутьКомпоненты(ИмяКомпоненты)
	МодульОбъекта = МодульОбъекта();
	ПутьКомпоненты = МодульОбъекта.АдресНативнойКомпонентыИзВнешнейОбработки(ИмяКомпоненты);	
	Возврат ПутьКомпоненты;	
КонецФункции

&НаКлиенте
Процедура УстановитьЗаголовокПроксиИнфо()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	Если ProxyType = "NotUse" Тогда
		ЭлементыФормочки.ПроксиИнфо.Заголовок = "Не используется";
	ИначеЕсли ProxyType = "SystemSettings" Тогда
		ЭлементыФормочки.ПроксиИнфо.Заголовок = "Используются системные настройки";
	Иначе
		ЭлементыФормочки.ПроксиИнфо.Заголовок = ProxyProtocol + ";" + ProxyServer + ":" + Строка(Формат(ProxyPort, "ЧЦ=5; ЧДЦ=0; ЧН=0; ЧГ=0"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокПриложений()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.Domain.СписокВыбора.Очистить();
	Если Country = "ru" Тогда
		ЭлементыФормочки.Domain.СписокВыбора.Добавить("saby", "saby");
		ЭлементыФормочки.Domain.СписокВыбора.Добавить("sabyd", "sabyd");
		ЭлементыФормочки.Domain.СписокВыбора.Добавить("sabytest", "sabytest");
		ЭлементыФормочки.Domain.Подсказка = "saby - рабочий домен; sabytest - тестовый домен";
	Иначе
		ЭлементыФормочки.Domain.СписокВыбора.Добавить("setty", "setty");
		ЭлементыФормочки.Domain.Подсказка = "setty - рабочий домен";
	КонецЕсли;
	Если ЭлементыФормочки.Domain.СписокВыбора.НайтиПоЗначению(Domain) = Неопределено Тогда
		Domain = ЭлементыФормочки.Domain.СписокВыбора[0].Значение;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокКонтуров()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.Contour.СписокВыбора.Очистить();
	ЭлементыФормочки.Contour.СписокВыбора.Добавить("", "online");
	ЭлементыФормочки.Contour.СписокВыбора.Добавить("fix", "fix");
	Если Country = "ru" Тогда
		ЭлементыФормочки.Contour.СписокВыбора.Добавить("test", "test");
		ЭлементыФормочки.Contour.СписокВыбора.Добавить("pre-test", "pre-test");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПараметрыПрокси(Команда)
	ЭлФорм = ПолучитьЭлементыФормы();
	ЭлФорм.СтраницыНастройкиПодключенияПрокси.ТекущаяСтраница = ПолучитьСтраницуНаКлиенте(ЭлФорм.СтраницыНастройкиПодключенияПрокси, "НастройкиПрокси");
	УстановитьДоступностьНастройкиПрокси();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройки(Команда)
	ОбязательныеНастройкиЗаполнены = ПроверитьОбязательныеНастройкиПодключенияПрокси();
	Если ОбязательныеНастройкиЗаполнены Тогда
		ЭлФорм = ПолучитьЭлементыФормы();
		ПереключитьСтраницуНастройкиПодключенияПрокси();
		ЭлФорм.СтраницыНастройкиПодключенияПрокси.ТекущаяСтраница = ПолучитьСтраницуНаКлиенте(ЭлФорм.СтраницыНастройкиПодключенияПрокси, "НастройкиПодключения");
		УстановитьВидимостьНастроекСпособаОбмена();
		УстановитьВидимостьНастроекПрокси();
		УстановитьДоступностьХраненияНастроек();
		ОчиститьСообщения();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьНастройкиИзКаталогаПриИзменении(Элемент)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.КаталогХраненияНастроек.Видимость = ЭтаФорма.ИспользоватьНастройкиИзКаталога;
КонецПроцедуры

