	LoggingCatalog	= Saby_ВыбратьКаталог(LoggingCatalog);
КонецПроцедуры

&НаКлиенте
Процедура ПроксиПарольНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭтаФорма.ProxyPassword = ЭлементыФормочки.ПроксиПароль.ТекстРедактирования;
	ЭлементыФормочки.ПроксиПароль.Видимость = Ложь;
	Если ЭлементыФормочки.ПроксиПароль.РежимПароля Тогда 	
		ЭлементыФормочки.ПроксиПароль.РежимПароля = Ложь;
		Попытка
			ЭлементыФормочки.ПроксиПароль.КартинкаКнопкиВыбора = БиблиотекаКартинок.СкрытьПароль;
		Исключение                  
			ЭлементыФормочки.ПроксиПароль.КнопкаВыбора = Ложь;	
		КонецПопытки;
   	Иначе
		ЭлементыФормочки.ПроксиПароль.РежимПароля = Истина;
		Попытка
			ЭлементыФормочки.ПроксиПароль.КартинкаКнопкиВыбора = БиблиотекаКартинок.ПоказатьПароль;
		Исключение                  
			ЭлементыФормочки.ПроксиПароль.КнопкаВыбора = Ложь;	
		КонецПопытки;
	КонецЕсли; 
	ЭлементыФормочки.ПроксиПароль.Видимость = Истина;
КонецПроцедуры

&НаКлиенте
Функция ПроверитьОбязательныеНастройкиПодключенияПрокси()
	ЭлФорм = ПолучитьЭлементыФормы();
	УстановитьЭлементуОтметкуНезаполненногоПоРеквизиту(ЭлФорм.ПроксиПротокол, ProxyType = "OtherSettings", ЭтаФорма.ProxyProtocol);
	УстановитьЭлементуОтметкуНезаполненногоПоРеквизиту(ЭлФорм.ПроксиСервер, ProxyType = "OtherSettings", ЭтаФорма.ProxyServer);
	Если ЭлФорм.СтраницыНастройкиПодключенияПрокси.ТекущаяСтраница = ПолучитьСтраницуНаКлиенте(ЭлФорм.СтраницыНастройкиПодключенияПрокси, "НастройкиПрокси") И
		ProxyType = "OtherSettings" И 
		(Не ЗначениеЗаполнено(ЭтаФорма.ProxyProtocol) Или Не ЗначениеЗаполнено(ЭтаФорма.ProxyServer)) Тогда
		Сообщить("Заполните обязательные поля или выберите другой тип настроек прокси");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура УстановитьЭлементуОтметкуНезаполненногоПоРеквизиту(ЭлФормы, ДоступностьЭлФормы, ЗначениеРеквизита)
	// BSLLS:IfElseIfEndsWithElse-off
	Если Не ДоступностьЭлФормы Тогда
		ЭлФормы.АвтоОтметкаНезаполненного = Ложь;
		ЭлФормы.ОтметкаНезаполненного = Ложь;
	ИначеЕсли ДоступностьЭлФормы И Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		ЭлФормы.АвтоОтметкаНезаполненного = Истина;
		ЭлФормы.ОтметкаНезаполненного = Истина;	
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
КонецПроцедуры

