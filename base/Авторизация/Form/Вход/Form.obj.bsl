&НаКлиенте
Процедура ЗаполнитьСписокПриложений()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.Domain.СписокВыбора.Очистить();
	Если Country = "ru" Тогда
		ЭлементыФормочки.Domain.СписокВыбора.Добавить("saby", "saby");
		ЭлементыФормочки.Domain.СписокВыбора.Добавить("sabytest", "sabytest");
		ЭлементыФормочки.Domain.Подсказка = "saby - рабочий домен; sabytest - тестовый домен";
	Иначе
		ЭлементыФормочки.Domain.СписокВыбора.Добавить("setty", "setty");
		ЭлементыФормочки.Domain.Подсказка = "setty - рабочий домен";
	КонецЕсли;
	Если ЭлементыФормочки.Domain.СписокВыбора.НайтиПоЗначению(Domain) = Неопределено Тогда
		Domain = ЭлементыФормочки.Domain.СписокВыбора[0].Значение;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокКонтуров()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.Contour.СписокВыбора.Очистить();
	ЭлементыФормочки.Contour.СписокВыбора.Добавить("", "online");
	ЭлементыФормочки.Contour.СписокВыбора.Добавить("fix", "fix");
	Если Country = "ru" Тогда
		ЭлементыФормочки.Contour.СписокВыбора.Добавить("test", "test");
		ЭлементыФормочки.Contour.СписокВыбора.Добавить("pre-test", "pre-test");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРаботуКомпоненты() 
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.ОшибкаНастройки.Заголовок = "";
	Если exchange_method <> "SabyPluginConnector" Тогда
		Возврат;
	КонецЕсли;
	Попытка 
		ПутьКомпоненты = ПолучитьПутьКомпоненты(exchange_method);
		НачатьУстановкуВнешнейКомпоненты(, ПутьКомпоненты);
	Исключение  
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
		ЭлементыФормочки.ОшибкаНастройки.Заголовок = ExtExceptionToMessage(ОшибкаСтруктура);	
	КонецПопытки;	
КонецПроцедуры	

Функция ПолучитьПутьКомпоненты(ИмяКомпоненты)
	МодульОбъекта = МодульОбъекта();
	ПутьКомпоненты = МодульОбъекта.АдресНативнойКомпонентыИзВнешнейОбработки(ИмяКомпоненты);	
	Возврат ПутьКомпоненты;	
КонецФункции

