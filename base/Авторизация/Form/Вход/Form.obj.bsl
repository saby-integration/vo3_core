&НаКлиенте
Процедура ВойтиЧерезБраузерЗавершение(Результат, Парметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЭтаФорма.АвторизацияУспешна = Истина;
	ЭтаФорма.context_params	= НастройкиПодключенияПрочитатьНаСервере();
	
	МассивСтатистики = Новый Массив;
	НаименованиеДействия = "Auth";
	web_interface = get_prop(context_params, "web_interface");
	Если web_interface = "BrowserSabyPlugin" Тогда
		КонтекстДействия = "Lpp";
	Иначе
		КонтекстДействия = "LppBl";
	КонецЕсли;	
	ЭлементСтатистики = ТранспортИнтеграции.local_helper_element_action(НаименованиеДействия, КонтекстДействия, Новый Структура(), 1);
	МассивСтатистики.Добавить(ЭлементСтатистики);
	ТранспортИнтеграции.local_helper_register_actions(ЭтаФорма.context_params, МассивСтатистики);
	
	ЭтаФорма.Закрыть(ЭтаФорма.context_params);
КонецПроцедуры

&НаКлиенте
Процедура ВойтиЧерезБраузер(Команда)
	СформироватьУРЛ();
	АдресСтраницы = api_url+"/auth/";

	ЭтаФорма.context_params.Вставить("login", login);
	ЭтаФорма.context_params.Вставить("password", password);
	ЭтаФорма.context_params.Вставить("api_url", api_url);
	ЭтаФорма.context_params.Вставить("ConnectionId", ConnectionId);
	ЭтаФорма.context_params.Удалить("Proxy");
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Заголовок", "Авторизация");
	ПараметрыФормы.Вставить("АвтоЗакрытиеФормы", Истина);
	ПараметрыФормы.Вставить("АдресСтраницы", АдресСтраницы);
	ПараметрыФормы.Вставить("context_params", ЭтаФорма.context_params);

	ОповещениеОЗарытитииФормыАвторизацииВЕБ = Новый ОписаниеОповещения("ВойтиЧерезБраузерЗавершение", ЭтаФорма, ПараметрыФормы);
	
	АдресСтраницы = СформироватьАдресСтраницы();

	Попытка
		СформироватьАдресСоСлужебнымиПараметрами();
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		СтруктураОшибки = ExtExceptionAnalyse(ИнфоОбОшибке);
		ОписаниеОшибки = СтруктураОшибки.message;
		ПоказатьОповещениеПользователя(
			"Ошибка", , ОписаниеОшибки,
			БиблиотекаКартинок["Ошибка32"]);
		Возврат;
	КонецПопытки;
	ОбновитьПолеHTML("ПолеHTMLДокумента", АдресСтраницыССлужебнымиПараметрами);
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьКод(Команда)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	Попытка
		ВходПроверкаКодаСМС(ПарметрыФормыВводаСМС, code_sms);
		code_sms = "";
		ЭтаФорма.Закрыть(ЭтаФорма.context_params);
	Исключение
		code_sms = "";
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = ExtExceptionAnalyse(ИнфОбОшибке);
		ПоказатьОшибкуВводаСМС(ExtExceptionToMessage(ОшибкаСтруктура));
	КонецПопытки;
КонецПроцедуры

