&НаКлиенте
Процедура УстановитьДоступностьНастройкиПрокси()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ДоступностьПрокси = ProxyType = "OtherSettings";
	ЭлементыФормочки.ПроксиПротокол.Доступность = ДоступностьПрокси;
	ЭлементыФормочки.ПроксиСервер.Доступность = ДоступностьПрокси;
	ЭлементыФормочки.ПроксиПорт.Доступность = ДоступностьПрокси;
	ЭлементыФормочки.ИспользоватьАутентификациюОС.Доступность = ДоступностьПрокси;
	ЭлементыФормочки.ПроксиЛогин.Доступность = ДоступностьПрокси;
	ЭлементыФормочки.ПроксиПароль.Доступность = ДоступностьПрокси;
	ЭлементыФормочки.ВзятьНастройкиПроксиИз1С.Доступность = ДоступностьПрокси;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокПроксиИнфо()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	Если ProxyType = "NotUse" Тогда
		ЭлементыФормочки.ПроксиИнфо.Заголовок = "Не используется";
	ИначеЕсли ProxyType = "SystemSettings" Тогда
		ЭлементыФормочки.ПроксиИнфо.Заголовок = "Используются системные настройки";
	Иначе
		ЭлементыФормочки.ПроксиИнфо.Заголовок = ProxyProtocol + ";" + ProxyServer + ":" + Строка(ProxyPort);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВВебВерсию(Команда)
	ЭтаФорма.Закрыть();
	ФормаБраузера = ФормаОсновнойОбработки("Browser", ПутьКФормамОбработки());
	ФормаБраузера.context_params = context_params;
	ФормаБраузера.Открыть();
КонецПроцедуры

