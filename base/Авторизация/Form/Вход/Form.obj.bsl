&НаКлиенте
Процедура ЗаполнитьСписокПриложений()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.Domain.СписокВыбора.Очистить();
	Если Country = "RU" Тогда
		ЭлементыФормочки.Domain.СписокВыбора.Добавить("Saby", "Saby");
		ЭлементыФормочки.Domain.СписокВыбора.Добавить("Sabytest", "Sabytest");
		ЭлементыФормочки.Domain.Подсказка = "Saby - рабочий домен; Sabytest - тестовый домен";
	Иначе
		ЭлементыФормочки.Domain.СписокВыбора.Добавить("Setty", "Setty");
		ЭлементыФормочки.Domain.Подсказка = "Setty - рабочий домен";
	КонецЕсли;
	Если ЭлементыФормочки.Domain.СписокВыбора.НайтиПоЗначению(Domain) = Неопределено Тогда
		Domain = ЭлементыФормочки.Domain.СписокВыбора[0].Значение;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокКонтуров()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.Contour.СписокВыбора.Очистить();
	ЭлементыФормочки.Contour.СписокВыбора.Добавить("fix", "fix");
	Если Country = "RU" Тогда
		ЭлементыФормочки.Contour.СписокВыбора.Добавить("test", "test");
		ЭлементыФормочки.Contour.СписокВыбора.Добавить("pre-test", "pretest");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СпособОбменаПриИзменении(Элемент)
	УстановитьВидимостьГОСТШифрования();
	СформироватьУРЛОбновитьЗаголовок();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьГОСТШифрования()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.GostTls.Видимость = exchange_method = "SabyHttpsClient" И Country = "RU" ;
	Если Не ЭлементыФормочки.GostTls.Видимость тогда
		ЭтаФорма.GostTls = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКонтура()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	Если ЗначениеЗаполнено(Contour) Тогда
		ЭтаФорма.UseTestContour	= Истина;
		ЭлементыФормочки.ГруппаКонтур.Видимость = Истина;
	Иначе
		ЭтаФорма.UseTestContour	= Ложь;
		ЭлементыФормочки.ГруппаКонтур.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтранаПриИзменении(Элемент)
	ЗаполнитьСписокПриложений();
	ЗаполнитьСписокКонтуров();
	УстановитьВидимостьГОСТШифрования();
	СформироватьУРЛОбновитьЗаголовок();
КонецПроцедуры

