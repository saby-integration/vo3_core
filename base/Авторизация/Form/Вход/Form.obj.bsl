&НаКлиенте
Процедура РежимВходаПоЛогинуНажатие(Элемент)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.СтраницыАвторизации.ТекущаяСтраница = ПолучитьСтраницуНаКлиенте(ЭлементыФормочки.СтраницыАвторизации, "ПоЛогину");
	ЭлементыФормочки.СписокСертификатов.Видимость = Ложь;
	ЭтаФорма.ВидАвторизации = 1;
КонецПроцедуры

&НаКлиенте
Процедура РежимВходаПоСертификатуПриНажатии(Элемент)
	СписокСертификатов.Очистить();
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.СтраницыАвторизации.ТекущаяСтраница = ПолучитьСтраницуНаКлиенте(ЭлементыФормочки.СтраницыАвторизации, "ПоСертификату");
	ЭлементыФормочки.СписокСертификатов.Видимость = Истина;
	ЭтаФорма.ВидАвторизации = 2;
	ЗаполнитьСписокСертификатов();
КонецПроцедуры

&НаКлиенте
Процедура СписокСертификатовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Войти(Неопределено);	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПоТокенуНажатие(Элемент)
	ЭтаФорма.ВидАвторизации = 3;
	Войти(Неопределено);
КонецПроцедуры

