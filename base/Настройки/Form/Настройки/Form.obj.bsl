#Область include_core_base_Настройки_ЗапросПрофилейПользователей
#КонецОбласти


&НаКлиенте
Процедура Показать() Экспорт
	ТекстЗапроса = ТекстЗапросаПрофилейПользователей();
	ЗаполнитьДанныеФормы(ТекстЗапроса);
	ВидБесшовнойАвторизацииПриИзменении(Неопределено);
КонецПроцедуры

&НаСервере
Процедура СохранитьДанныеАвторизацииНаСервере()
	// Вставить содержимое обработчика.
	Попытка
		Если ТипЗнч(ПрофилиПользователей) = Тип("ТаблицаЗначений") Тогда
			Профили = ПрофилиПользователей.Скопировать(Новый Структура("Отмечен", Истина), "Наименование");
		Иначе	
			Профили = ПрофилиПользователей.Выгрузить(Новый Структура("Отмечен", Истина), "Наименование");
		КонецЕсли;
		МодульОбъекта = МодульОбъекта();
		Профили = МодульОбъекта.ТаблицаЗначенийВМассив(Профили);
		ХранилищеОбщихНастроек.Сохранить("СБИС", "Авторизация", Новый Структура("Логин,Пароль,ИДПриложения,КлючПриложения,КлючАутентификации,Профили,ВидБесшовнойАвторизации",Логин, Пароль, ИДПриложения,КлючПриложения, КлючАутентификации, Профили, ВидБесшовнойАвторизации),,"ПользовательСБИС");
	Исключение
		Ошибка = ОписаниеОшибки();
		Сообщить(Ошибка);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанныеАвторизации(Команда)
	СохранитьДанныеАвторизацииНаСервере();
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДанныеФормы(Знач ТекстЗапроса) 
	МодульОбъекта = МодульОбъекта();
	Попытка  
		ЭтаФорма.ВидБесшовнойАвторизации = 1;
		Настройки = ХранилищеОбщихНастроек.Загрузить("СБИС", "Авторизация",,"ПользовательСБИС");
		Если Настройки <> Неопределено Тогда  
			ЭтаФорма.ВидБесшовнойАвторизации = get_prop(Настройки, "ВидБесшовнойАвторизации", 1);
			ЭтаФорма.Логин = Настройки.Логин;
			ЭтаФорма.Пароль = Настройки.Пароль;
			Если Настройки.Свойство("Профили") И Настройки.Профили.Количество() > 0 Тогда
				ОтмеченныеПрофили = МодульОбъекта.МассивВТаблицуЗначений(Настройки.Профили);
				ОтмеченныеПрофили = ОтмеченныеПрофили.ВыгрузитьКолонку("Наименование");
			КонецЕсли;
			Если Настройки.Свойство("ИДПриложения") Тогда
				ЭтаФорма.ИДПриложения = Настройки.ИДПриложения;
				ЭтаФорма.КлючПриложения = Настройки.КлючПриложения;
				ЭтаФорма.КлючАутентификации = Настройки.КлючАутентификации;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
			ТекстЗапросаПереопределяемый = СтрЗаменить(ТекстЗапроса, "ЛОЖЬ КАК Отмечен", 
											"ВЫБОР КОГДА Профили.Наименование В (&ОтмеченныеПрофили) Тогда Истина ИНАЧЕ Ложь КОНЕЦ КАК Отмечен");
			Профили = ПрофилиПользователей(ТекстЗапросаПереопределяемый, ОтмеченныеПрофили);
		КонецЕсли;
		Если Профили.Найти( Ложь, "Отмечен") = Неопределено Тогда
			ЭтаФорма.ОтметитьВсе = Истина;
		Иначе
			ЭтаФорма.ОтметитьВсе = Ложь;
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
		Если Найти(Ошибка, "Нарушение прав доступа") Тогда
			Сообщить("Функционал доступен только администратору системы!");
			ПереключитьПанель("Основная");	
			Возврат Ложь;
		КонецЕсли;
		Сообщить(Ошибка);
	КонецПопытки;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	// отмечает все записи в таблице	
	ОтметитьВсе = Не ОтметитьВсе;
	Для Каждого Строка Из ПрофилиПользователей Цикл
		Строка.Отмечен = ОтметитьВсе;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВидБесшовнойАвторизацииПриИзменении(Элемент)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	Если ВидБесшовнойАвторизации = 2 Тогда
		ЭлементыФормочки.ГруппаБесшовнаяАвторизация.ТекущаяСтраница =  ПолучитьСтраницуНаКлиенте(ЭлементыФормочки.ГруппаБесшовнаяАвторизация, "ЛогинПароль");;
	Иначе
		ЭлементыФормочки.ГруппаБесшовнаяАвторизация.ТекущаяСтраница = ПолучитьСтраницуНаКлиенте(ЭлементыФормочки.ГруппаБесшовнаяАвторизация, "СервиснаяАвторизация");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция ЭтотОбъектНаКлиенте() 
	Возврат ЭтаФорма;
КонецФункции

