&НаКлиенте
Процедура КакНастроитьНажатие(Элемент)
	ИнтернетСсылка = "https://sbis.ru/help/integration/app/add_app";
	#Если ВебКлиент Тогда
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Ссылка", ИнтернетСсылка);
		РасширениеРаботыСФайламиПодключить(ДопПараметры);
	#Иначе
		// BSLLS:UsingSynchronousCalls-off для вовместимости с 8.2
		ЗапуститьПриложение(ИнтернетСсылка);
		// BSLLS:UsingSynchronousCalls-on
	#КонецЕсли	
КонецПроцедуры

