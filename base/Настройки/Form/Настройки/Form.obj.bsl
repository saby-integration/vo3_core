&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПередОткрытием();
	ЭтаФорма.ИзмененаДатаОбновленияСтатусов = Ложь;
	ЭтаФорма.ЭтоСинхронизация = Истина;
	ЭлементыФормочки = ПолучитьЭлементыФормыНаСервере();
	ДобавитьИнформациюОВерсии(ЭлементыФормочки.ВерсияПродукта);
	
	ЭтаФорма.ИзмененыНастройкиПодключения = Ложь;
	
	ЗаполнитьСпискиВыбораРеквизитов();
	ЗаполнитьРеквизитыИзПубличныхНастроек();
	ЗаполнитьРеквизитыИзНастроекПодключения();
	
	ВидимостьЭлементовКЭДО = ЗначениеКонстанты("ИспользоватьКЭДО", Ложь);
	ЭлементыФормочки.грПриглашение.Видимость			  = ВидимостьЭлементовКЭДО; 
	ЭлементыФормочки.kedo_mark.Видимость				  = ВидимостьЭлементовКЭДО;
	ЭлементыФормочки.Вложения.Видимость					  = ВидимостьЭлементовКЭДО; 
	
#Область include_core_base_Настройки_Form_Настройки_ПодборПерсоналаВидимость
#КонецОбласти

	ПоказатьТекстСообщения();
	ОформлениеСтрокОбъектовСинхронизации();
КонецПроцедуры

#Область include_core_base_Настройки_Form_Настройки_ЗаполнитьРеквизитыПриОткрытии
#КонецОбласти

#Область include_core_base_Авторизация_ОткрытьФормуАвторизацииПриОтсутствииСессии
#КонецОбласти

&НаСервере
Функция ПолучитьКоличествоФункциональныхОпций()
	МодульОбъекта = МодульОбъекта();
	МетаданныеРасширения = МодульОбъекта.ПолучитьМетаданныеРасширения();
	КоличествоФО = 0;
	Если МетаданныеРасширения <> Неопределено Тогда 
		КоличествоФО = МетаданныеРасширения.ФункциональныеОпции.Количество();
	КонецЕсли;
	Возврат КоличествоФО;
КонецФункции

&НаКлиенте

Процедура ОбновитьПредставлениеПарметраРасширенногоЛогирования()
	СостояниеЛогирования = "Включить ";
	Если ЭтаФорма.advanced_log Тогда
		СостояниеЛогирования = "Выключить ";
	КонецЕсли;
	
	ККП = ПолучитьКнопкуКоманднойПанели("ГруппаКомандСИ", "ГруппаКомандыСИ");
	КомандаКП = ПолучитьКомандуПодменю(ККП, "ИзменитьРеквизитРасширенноеЛогирование");
	УстановитьЗаголовок(КомандаКП, СостояниеЛогирования + "расширенное логирование");
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПредставлениеОтключенияПользовательскихНастроек()
	//TODO проверить, что пользвательские настройки есть
	ОтключениеПользовательскихНастроек = "Отключить ";
	Если ЭтаФорма.DisableCustomAlgorithms Тогда
		ОтключениеПользовательскихНастроек = "Включить ";
	КонецЕсли;
	
	ККП = ПолучитьКнопкуКоманднойПанели("ГруппаКомандСИ", "ГруппаКомандыСИ");
	КомандаКП = ПолучитьКомандуПодменю(ККП, "ОтключитьПользовательскиеНастройки");
	УстановитьЗаголовок(КомандаКП, ОтключениеПользовательскихНастроек + "пользовательские настройки");
	
	ВывестиИнформациюОПользовательскихНастройках();
КонецПроцедуры	

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтаФорма.Заголовок  = "Настройки " + ЛокализацияНазваниеПродукта();
    УстановитьЗаголовокСпособаОтправкиПриглашения("Как приглашать новых пользователей в " + ЛокализацияНазваниеПродукта());

	ЭлементыФормочки = ПолучитьЭлементыФормы();
	СтраницаПрограммыИнтеграционногоМодуля = ЭлементыФормочки.Найти(ПИМИмяОбластиЭлементов());  
	Если СтраницаПрограммыИнтеграционногоМодуля <> Неопределено Тогда 
		СтраницаПрограммыИнтеграционногоМодуля.Видимость = Ложь;
	КонецЕсли;
	ЭлементыФормочки.download_attachments_on_update.Заголовок = "При загрузке документа из " + ЛокализацияНазваниеПродукта();
	ЭлементыФормочки.РеквизитВыгружатьВложения.Заголовок = "Выгружать вложения " + ЛокализацияНазваниеПродукта()
		+" в присоединенные файлы документов 1С в фоновом режиме";
	
	ЭлементыФормочки.kedo_mark.Заголовок = "Загружать в " + ЛокализацияНазваниеПродукта() 
		+ " кадровые документы только по сотрудникам, подписавшим соглашение о КЭДО";
	
	ТранспортИнтеграции = ПолучитьФормуТранспорта(context_params);
	BlocklyExecutor = ПолучитьФормуBlockly();
	ФормаОткрыта = Истина;
	
	УстановитьДоступностьПоляТипОтправкиПриглашения();
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.ДействиеСРегламентнымЗаданием.Заголовок = "Поиск регламентного задания...";
	ПослеОткрытия();
	ОбновитьПредставлениеПарметраРасширенногоЛогирования();
	ОбновитьПредставлениеОтключенияПользовательскихНастроек();
	ОбновитьСтраницуБесшовногоВхода();
	ВидБесшовнойАвторизацииПриИзменении(Неопределено);
	
	ОбработчикПослеАвторизации = Новый ОписаниеОповещения("ПриОткрытииПослеАвторизации", ЭтаФорма);
	ОткрытьФормуАвторизацииПриОтсутствииСессии(context_params, ТранспортИнтеграции, ОбработчикПослеАвторизации);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытииПослеАвторизации(Результат, ДопПараметры = Неопределено) Экспорт
	ПереключитьПанельАвторизации();
	
	Если Результат <> Неопределено Тогда
		context_params = Результат;
		Попытка
			ЗаполнитьДатуСобытияОбновленияСтатусов(context_params);
		Исключение
			ИнфОбОшибке = ИнформацияОбОшибке();
			ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
			Сообщение = Новый СообщениеПользователю;
			ТекстОшибки = "Ошибка: " + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЕсли;
    
	ПолучитьАктуальностьВерсии();
	СтатусВерсии = ПолучитьСтатусВерсииНаФорме(Истина);
	ДанныеОшибки = get_prop(СтатусВерсии, "ДанныеОшибки");
	ОписаниеОшибки = get_prop(ДанныеОшибки, "detail");
	ТребуетсяОткрытьФормуАвторизации = НеобходимоВвестиКодПодтверждения(ОписаниеОшибки);
	Если ТребуетсяОткрытьФормуАвторизации Тогда
		//В форме настроек мы просто разлогинимся
		ВыйтиНаСервере();
	КонецЕсли;

	ИзменениеИнтерфейсаФормыПриИзменениеПараметровАвторизации();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыПодключения()
	ЭтаФорма.НаименованиеПодключения = "";
	Если Не ЗначениеЗаполнено(РеквизитИдентификаторПодключения()) Тогда
		Возврат;
	КонецЕсли;
	
	МассивИНИ = Неопределено;
	ПараметрыОперации = Новый Структура("id, Версия, INI", РеквизитИдентификаторПодключения(), ЭтаФорма.Версия, МассивИНИ); 
	Попытка
		ИнформацияПодключения = ТранспортИнтеграции.local_helper_read_connection(ЭтаФорма.context_params, ПараметрыОперации);
	Исключение
		Картинка = КартинкаОшибка();
		ПоказатьОповещениеПользователя(
			"Функционал " + ЛокализацияНазваниеПродукта() + " недоступен.",
			Неопределено,
			"Для работы необходимо авторизоваться.",
			Картинка,
			СтатусОповещенияПользователя.Важное);
	КонецПопытки;
	ЭтаФорма.НаименованиеПодключения = get_prop(ИнформацияПодключения, "name_connection", "");                                         
	Data = get_prop(ИнформацияПодключения, "Data", Новый Соответствие);
	ЭтаФорма.DisableCustomAlgorithms = get_prop(Data, "DisableCustomAlgorithms", Ложь);
	ОбновитьПредставлениеОтключенияПользовательскихНастроек();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	ФормаОткрыта = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	АвторизацияВыполнена = Неопределено;
	Если ТипЗнч(context_params) = Тип("Структура") Тогда
		АвторизацияВыполнена = ТранспортИнтеграции.СвойствоСессии(context_params, "session");
	КонецЕсли;
	АвторизацияВыполнена =	АвторизацияВыполнена <> Неопределено;
	Если НЕ АвторизацияВыполнена Тогда
		Оповестить(ЛокализацияНазваниеПродукта() + "_ЗакрытиеФормыАвторизации",
			Новый Структура("АвторизацияУспешна, ДальнейшееДействие, ФормаНастроек", Ложь, ""));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Выйти(Элемент)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ВыйтиНаСервере();
	ПолучитьАктуальностьВерсии();
	Сообщить("Сессия и пароль сброшены");
	Оповестить("SabySignOut");
	ЭтаФорма.context_params = СБИСПараметры();

	ИзменениеИнтерфейсаФормыПриИзменениеПараметровАвторизации();
КонецПроцедуры

&НаКлиенте
Процедура Войти(Элемент)
	ПроверкаВведенныхДанныхАутентификации = 
		Новый ОписаниеОповещения("ОбработкаРезультатаЗакрытияФормыАвторизации", ЭтаФорма);
	ОткрытьФормуОбработки("Вход",, ЭтаФорма,, ПроверкаВведенныхДанныхАутентификации);
КонецПроцедуры

#Область include_core_base_Настройки_Form_Настройки_СкопироватьИдентификатори
#КонецОбласти

&НаКлиенте
Процедура ПереключитьАккаунтНастройки(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	ИзменениеИнтерфейсаФормыПриИзменениеПараметровАвторизации();
КонецПроцедуры

#Область include_core_base_Настройки_Form_Настройки_ПриИзменении
#КонецОбласти

&НаКлиенте
Процедура ОбработкаРезультатаЗакрытияФормыАвторизации(Результат, Параметры) Экспорт
	ПереключитьПанельАвторизации();
	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	ЗаполнитьДатуСобытияОбновленияСтатусов(context_params);
	ПолучитьАктуальностьВерсии();
	//А вот тут бы проверить куда мы дальше хотим идти, если есть такие указания в - Параметры
	//Это для команд открытия формы браузера.
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		ОповещениеМодуль = get_prop(Параметры,"Модуль");
		ОповещениеМетод = get_prop(Параметры,"Метод");
		Если ОповещениеМодуль = Неопределено ИЛИ ОповещениеМетод = Неопределено Тогда
			Возврат;
		КонецЕсли;
		МетодЗавершенияАвторизации = Новый ОписаниеОповещения(ОповещениеМетод, ОповещениеМодуль);
		ВыполнитьОбработкуОповещения(МетодЗавершенияАвторизации);
	КонецЕсли;
	ИзменениеИнтерфейсаФормыПриИзменениеПараметровАвторизации();
КонецПроцедуры


&НаКлиенте

Процедура ПереключитьПанельАвторизацииСменаЗаголовка(ЭлементыФормочки, СтруктураСессии, АвторизацияВыполнена)
	ККП = ПолучитьКнопкуКоманднойПанели("ГруппаКомандРодитель", "ГруппаКомандВход");
	КомандаКП = ПолучитьКомандуПодменю(ККП, "КомандаПереключитьАккаунт");
	УстановитьЗаголовок(ККП, get_prop(СтруктураСессии, "UserFio", "Пользователь системы"));
	КомандаКП.Доступность = АвторизацияВыполнена;
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьСостояниеПодключения(saby_param, СтруктураСессии, АвторизацияВыполнена)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	
	ЭлементыФормочки.СостояниеПодключения.ТекущаяСтраница = 
		ПолучитьСтраницуНаКлиенте(ЭлементыФормочки.СостояниеПодключения, "НетПодключения");
	ЭлементыФормочки.СтраницыКомандАвторизации.ТекущаяСтраница = 
	    	ПолучитьСтраницуНаКлиенте(ЭлементыФормочки.СтраницыКомандАвторизации, "СтраницаВыход");
	Константа9 = 9;
	Если АвторизацияВыполнена Тогда
		ЭлементыФормочки.СтраницыКомандАвторизации.ТекущаяСтраница = 
	    	ПолучитьСтраницуНаКлиенте(ЭлементыФормочки.СтраницыКомандАвторизации, "СтраницаВход");
		ЭлементыФормочки.СпособОбмена.Заголовок = get_prop(saby_param, "ExchangeMethod");
		ЭлементыФормочки.Сервис.Заголовок = Сред(get_prop(saby_param, "ApiUrl", ""), Константа9); 	
		ЭлементыФормочки.Аккаунт.Заголовок = get_prop(СтруктураСессии, "AccountTitle", "");
		ЭлементыФормочки.СостояниеПодключения.ТекущаяСтраница = 
			ПолучитьСтраницуНаКлиенте(ЭлементыФормочки.СостояниеПодключения, "ЕстьПодключение");
	КонецЕсли;
	
	ПереключитьПанельАвторизацииСменаЗаголовка(ЭлементыФормочки, СтруктураСессии, АвторизацияВыполнена);
КонецПроцедуры

&НаКлиенте

Процедура СменаСтраницыКомандАвторизации(Знач АвторизацияВыполнена)
	ПодсказкаТекст =	"Открыть сессию в " + ЛокализацияНазваниеПродукта();
	Если АвторизацияВыполнена Тогда
		ПодсказкаТекст =	"Закрыть сессию в " + ЛокализацияНазваниеПродукта();
	КонецЕсли;
	
	ККП = ПолучитьКнопкуКоманднойПанели("ГруппаКомандРодитель", "ГруппаКомандВход");
	КомандаКП = ПолучитьКомандуПодменю(ККП, "КомандаВыход");
	УстановитьЗаголовок(КомандаКП, ПодсказкаТекст);
КонецПроцедуры

&НаКлиенте

Процедура ПереключитьАккаунтНажатие(Элемент)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ОповещениеПослеСменыАккаунта = Новый ОписаниеОповещения("ПереключитьАккаунтНастройки", ЭтаФорма);
	СменитьАккаунтВВыпадающемСписке(ЭлементыФормочки.ГруппаКомандРодитель, , ОповещениеПослеСменыАккаунта);
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеИнтерфейсаФормыПриИзменениеПараметровАвторизации()
	ЭтаФорма.context_params				= СБИСПараметры();
	ЭтаФорма.ИдентификаторПодключения = get_prop(context_params, "ConnectionUuid", Неопределено);
	
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.ИдентификаторПодключения.Доступность = ЗначениеЗаполнено(ЭтаФорма.ИдентификаторПодключения);
	
	СтруктураСессии			= ТранспортИнтеграции.СтруктураСессии(ЭтаФорма.context_params);
	АвторизацияВыполнена	= ТранспортИнтеграции.УИДСессии(ЭтаФорма.context_params) <> Неопределено;
	
	СтруктураСессии = ТранспортИнтеграции.СтруктураСессии(ЭтаФорма.context_params);
	ОтобразитьСостояниеПодключения(ЭтаФорма.context_params, СтруктураСессии, АвторизацияВыполнена);
	СменаСтраницыКомандАвторизации(АвторизацияВыполнена);
	ОбновитьДанныеНаФорме(ЭтаФорма);
	
	ЗаполнитьПараметрыПодключения();
	ОбновитьАвтоматическиеОперации(Неопределено);
	ЗаполнитьИсториюОбмена();
	ЗаполнитьДеревоНастроек();
	СтраницаПрограммыИнтеграционногоМодуля = ЭлементыФормочки.Найти(ПИМИмяОбластиЭлементов());  
	Если СтраницаПрограммыИнтеграционногоМодуля <> Неопределено 
		И СтраницаПрограммыИнтеграционногоМодуля.Видимость = Истина Тогда
		СкрытьОтобразитьГруппуКопиюИзКаталогаНастройки();
		ЗаполнитьСписокПимФайлов();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
