Процедура ОбновитьСтраницуБесшовногоВхода() Экспорт
	ЭлемФормы = ПолучитьЭлементыФормы();

	ЭлемФормы.БесшовныйВходКонтент.ТекущаяСтраница = 
		ПолучитьСтраницуНаКлиенте(ЭлемФормы.БесшовныйВходКонтент, "БесшовныйВходОграничения");
	Если УПользователяПолныеПрава() Тогда
		ТекстЗапроса = ТекстЗапросаПрофилейПользователей();
		ЗаполнитьДанныеФормы(ТекстЗапроса);
		ЭлемФормы.БесшовныйВходКонтент.ТекущаяСтраница = 
			ПолучитьСтраницуНаКлиенте(ЭлемФормы.БесшовныйВходКонтент, "БесшовныйВход");
	КонецЕсли;
