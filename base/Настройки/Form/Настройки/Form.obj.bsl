&НаСервере
Функция ПолучитьТекущийТранспорт()
	МодульОбъекта = МодульОбъекта();
	ЭтаФорма.context_params = МодульОбъекта.НастройкиПодключенияПрочитать();
	Возврат ВидТранспорта(context_params);	
КонецФункции

&НаСервере
Процедура ЗаписатьОбщиеПараметрыНаСервере()
	МодульОбъекта = МодульОбъекта();
	ОбщиеНастройки	= МодульОбъекта.ОбщиеНастройкиПрочитать();
	ПубличныеОбщиеНастройки	= get_prop(ОбщиеНастройки, "public", Новый Структура);
	
	ПубличныеОбщиеНастройки.Вставить("download_attachments_on_complete",	download_attachments_on_complete);
	ПубличныеОбщиеНастройки.Вставить("download_attachments_on_update",		download_attachments_on_update);
	ПубличныеОбщиеНастройки.Вставить("refresh_statuses",					refresh_statuses);
	ПубличныеОбщиеНастройки.Вставить("run_docflow",							run_docflow);
	ПубличныеОбщиеНастройки.Вставить("kedo_mark",							kedo_mark);
	ПубличныеОбщиеНастройки.Вставить("send_invitations",					send_invitations);
	ПубличныеОбщиеНастройки.Вставить("send_type",							send_type);
	ПубличныеОбщиеНастройки.Вставить("send_completed_documents",			send_completed_documents);
	ПубличныеОбщиеНастройки.Вставить("pdf_attachments",						pdf_attachments);
	ПубличныеОбщиеНастройки.Вставить("auto_update",							auto_update);
	
	AlgorithmsStorage = Неопределено;
	Если ЭтаФорма.ПИМИспользоватьКопиюИзКаталога = Истина 
		И ЗначениеЗаполнено(ЭтаФорма.ПИМПутьККаталогу) Тогда 
		AlgorithmsStorage = ЭтаФорма.ПИМПутьККаталогу;
	КонецЕсли;
	ПубличныеОбщиеНастройки.Вставить("UseLocalAlgorithmStorage", AlgorithmsStorage);
	
	ОбщиеНастройки.Вставить("public", ПубличныеОбщиеНастройки);
	МодульОбъекта.ОбщиеНастройкиЗаписать(ОбщиеНастройки);  
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПараметрыПользователя(Знач context_params_Записать);
	МодульОбъекта = МодульОбъекта();
	Если context_params = Неопределено Тогда 
		context_params = Новый Структура;
	КонецЕсли;
	Если context_params_Записать.Свойство("advanced_log") Тогда
		Если advanced_log Тогда
			context_params_Записать.Вставить("advanced_log", ТекущаяДатаСеанса());
		Иначе
			context_params_Записать.Вставить("advanced_log", Дата(1, 1, 1));
		КонецЕсли;
	КонецЕсли;
	Для каждого context_param_Записать Из context_params_Записать Цикл
		context_params.Вставить(context_param_Записать.Ключ, context_param_Записать.Значение);
	КонецЦикла;		
	МодульОбъекта.НастройкиПодключенияЗаписать(context_params);
КонецПроцедуры

&НаКлиенте
Процедура ДатаВремяУказателяСтатусаПриИзменении(Элемент)
	ЭтаФорма.ИзмененаДатаОбновленияСтатусов = Истина;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуСобытияОбновленияСтатусов(context_param)
	УказателиНаСобытие = Новый Структура();
	ДатаВр = Формат(ДатаВремяУказателяСтатуса, "ДФ='dd.MM.yyyy HH.mm.ss'");
	Если ДатаВремяУказателяСтатуса <> Дата(1,1,1) Тогда
		УказателиНаСобытие = Новый Структура("date", ДатаВр);
	КонецЕсли;
	context_param.Вставить("last_event", УказателиНаСобытие);
	
	LastEventEdo = Новый Структура("id, datetime, doc_id", "", ДатаВр, "");
	last_event = Новый Структура("LastEventEdo", LastEventEdo); 
	last_event.Вставить("BrokerMarkEdo", Неопределено);
	update_public_params = Новый Структура("last_event", last_event);
	connection_uuid = get_prop(context_param, "ConnectionUuid", "");
	BlocklyExecutor.ЗаписатьПубличныеПараметрыПодключения(context_param, update_public_params, connection_uuid)
КонецПроцедуры

&НаСервере
Функция ПриВключенииСЭДО()
    
    // Загружаем действующие МЧД по организациям у которых настроен обмен с СФР
    ИмяМодуля = ПрефиксПродукта() + "ЭДОСФСС";
    Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля) <> Неопределено Тогда
		МодульКонфигурации = ОбщийМодульЗначение(ИмяМодуля);
		МодульКонфигурации.ЗагрузитьМЧДСФР();
    КонецЕсли;
    
    Возврат Истина;
    
КонецФункции

&НаСервере
Функция ТребуетсяВывестиСообщениеОНеобходимостиАвторизации()
	ОбработкаSABY = МодульОбъекта();
	Возврат ОбработкаSABY.ПроверитьНаличиеПараметровПодключения() = Неопределено;
КонецФункции

&НаКлиенте
Процедура ЗаписатьОбщиеПараметры()
	ТекущийТранспортИнтеграции = ПолучитьТекущийТранспорт();
	Если ИзмененаДатаОбновленияСтатусов Тогда 
		УстановитьДатуСобытияОбновленияСтатусов(context_params);
	КонецЕсли;
	
	context_params_Записать = Новый Структура;
	context_params_Записать.Вставить("advanced_log", Неопределено);
	context_params_Записать.Вставить("DisableCustomAlgorithms", DisableCustomAlgorithms);
	context_params_Записать.Вставить("Тема", Тема);
	context_params_Записать.Вставить("SendDocNumberDeleteBasePrefix", SendDocNumberDeleteBasePrefix);
	context_params_Записать.Вставить("SendDocNumberDeleteUserPrefix", SendDocNumberDeleteUserPrefix);
	
	ЗаписатьПараметрыПользователя(context_params_Записать);
	ЗаписатьОбщиеПараметрыНаСервере();
	Оповестить("Saby_НастройкиИзменены");
	ОбновитьИнтерфейс(); //Обновление интерфейса после вкл/выкл функциональных опций
	Картинка = КартинкаОшибка();
	Если ТребуетсяВывестиСообщениеОНеобходимостиАвторизации() Тогда
		ПоказатьОповещениеПользователя(
			"Функционал " + ЛокализацияНазваниеПродукта() + " недоступен.",
			Неопределено,
			"Для работы необходимо авторизоваться.",
			Картинка,
			СтатусОповещенияПользователя.Важное);
	КонецЕсли;
	ЭтаФорма.Модифицированность = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда) 
	Если ИзмененыНастройкиПодключения Тогда
		ЗаписатьПодключение();
		СброситьКэшНаСервере();
	КонецЕсли;
	ЗаписатьОбщиеПараметры();
	Закрыть(Истина);
	Если УПользователяПолныеПрава() Тогда
		СохранитьБесшовныйВход();
		ИзменитьНаправленияСинхронизации();
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура Записать(Команда)
	ЗаписатьОбщиеПараметры();
КонецПроцедуры

&НаКлиенте
Функция ЗаписатьПодключение() 
	МассивINI = Новый Массив;
	props = Новый Структура;
	props.Вставить("id",	ЭтаФорма.ИдентификаторПодключения);
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("DisableCustomAlgorithms", ЭтаФорма.DisableCustomAlgorithms);
	props.Вставить("Data", ПараметрыПодключения);
	params = Новый Структура("props,ini", Props, МассивINI);
	Попытка
		res = ТранспортИнтеграции.local_helper_write_connection(context_params, params);
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ВызватьИсключение(NewExtExceptionСтрока(ИнфОбОшибке));
	КонецПопытки;	
	Возврат res;
КонецФункции

