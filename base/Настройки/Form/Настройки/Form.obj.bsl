	ЭлементыФормочки.download_attachments_on_update.Доступность = ЭтаФорма.РеквизитВыгружатьВложения;
	ЭлементыФормочки.download_attachments_on_complete.Доступность = ЭтаФорма.РеквизитВыгружатьВложения;
	Если ЭтаФорма.РеквизитВыгружатьВложения = Ложь Тогда
		ЭтаФорма.download_attachments_on_update		= Ложь;
