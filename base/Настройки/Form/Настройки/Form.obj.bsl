&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметры, Источник)
	Если (ИмяСобытия = "Saby_ЗакрытиеФормыАвторизации" Или ИмяСобытия = ЛокализацияНазваниеПродукта() + "_ЗакрытиеФормыАвторизации") 
			И ФормаОткрыта Тогда
		Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("ФормаНастроек") Тогда
			// Процесс закрытия формы, ни чего не нужно выполнять
			Возврат;
		КонецЕсли;
		//Параметры не важны
		//АвторизацияУспешна = get_prop(Параметры, "АвторизацияУспешна", Ложь);
		//ДальнейшееДействие = get_prop(Параметры, "ДальнейшееДействие", "");
		//Важно перерисовать форму
		ПолучитьАктуальностьВерсии(ФормаОткрыта);
		ПриОткрытииПослеАвторизации(Неопределено);
		ЭтаФорма.context_params = СБИСПараметры();
	КонецЕсли;
	Если ИмяСобытия = "ОбновитьАвтоматическиеОперации" Тогда
		ОбновитьТаблицуАвтоматическиеОперации();
	КонецЕсли;
	Если ИмяСобытия = "ПИМОбновитьСписок" Тогда
		ПИМОбновить(Неопределено);
	КонецЕсли;
КонецПроцедуры

