	УстановитьОформлениеЭлемента(ИмяЛевогоПоля, мУсловиеОформления, мПолейОформления);
	
	ИмяЛевогоПоля = "ДеревоНастроекПодключения.Объект";
	ВидСравненияГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	мУсловиеОформления = Новый Массив();
	мУсловиеОформления.Добавить(Новый Структура("ИмяПоля, ВидСравненияГруппы, ВидСравненияПоля, Значение",
		ИмяЛевогоПоля, ВидСравненияГруппы,	ВидСравненияКомпоновкиДанных.Равно, "Справочники"));
	мУсловиеОформления.Добавить(Новый Структура("ИмяПоля, ВидСравненияГруппы, ВидСравненияПоля, Значение",
		ИмяЛевогоПоля, ВидСравненияГруппы,	ВидСравненияКомпоновкиДанных.Равно, "Документы"));
	мПолейОформления = Новый Массив();
	мПолейОформления.Добавить(	Новый Структура("ИмяПоля, Реквизит, Значение",
		"ДеревоНастроекПодключенияНаправление",	"Текст", ""));
	УстановитьОформлениеЭлемента(ИмяЛевогоПоля, мУсловиеОформления, мПолейОформления);
// BSLLS:NestedFunctionInParameters-on
