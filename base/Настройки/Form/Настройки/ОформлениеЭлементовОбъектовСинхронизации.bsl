		"ДеревоНастроекПодключенияНаправление",	"Текст", "→"));
	УстановитьОформлениеЭлемента(ИмяЛевогоПоля, мУсловиеОформления, мПолейОформления);
	
	мУсловиеОформления = Новый Массив();
	мУсловиеОформления.Добавить(Новый Структура("ИмяПоля, ВидСравненияГруппы, ВидСравненияПоля, Значение",
		ИмяЛевогоПоля, ВидСравненияГруппы,	ВидСравненияКомпоновкиДанных.Равно, 4));
	мПолейОформления = Новый Массив();
