
//
// Возвращаемое значение:
//  - Строка - символ-разделитель каталогов в ОС
//
//DynamicDirective
Функция РазделительКаталоговОС()
	СистемнаяИнформация = Новый СистемнаяИнформация;
	СтрТипПлатформы = СокрЛП(СистемнаяИнформация.ТипПлатформы);
	Если ВРЕГ(Лев(СтрТипПлатформы, 3)) = "WIN" Тогда
		Возврат "\";
	Иначе
		Возврат "/";
	КонецЕсли;
КонецФункции

