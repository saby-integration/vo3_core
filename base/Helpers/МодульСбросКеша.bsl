
Процедура СброситьКэшНаСервере(ИдПодключения = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	//СервераСБИС = СписокСерверовSaby();
	ИмяНастроек = НазваниеПродукта();
	//Для Каждого АдресСбис Из СервераСБИС Цикл
	//	ЗаписатьВХранилище(ИмяНастроек, "Ini" + АдресСбис.Значение, Неопределено, , ИмяНастроек);
	//КонецЦикла;
	СписокНастроек = СписокХранилищеНастроек(ИмяНастроек, ИмяНастроек);
	КлючНастройки = "Ini";
	Если ИдПодключения <> Неопределено Тогда
		КлючНастройки = КлючНастройки + ИдПодключения;
	КонецЕсли;	
	Для Каждого Запись Из СписокНастроек Цикл
		Если Найти(Запись.Значение, КлючНастройки) > 0 Тогда 
			ЗаписатьВХранилище(ИмяНастроек, Запись.Значение, Неопределено, , ИмяНастроек);	
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры
