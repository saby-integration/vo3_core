
Функция СписокСерверовSaby(ОтображатьГОСТСервера = Истина) Экспорт
	СписокСрв = Новый Массив();
	ДобавитьСервер(СписокСрв, "online.saby.ru", 			"online.saby.ru");
	ДобавитьСервер(СписокСрв, "fix-online.saby.ru", 		"fix-online.saby.ru");
	ДобавитьСервер(СписокСрв, "test-online.saby.ru", 		"test-online.saby.ru");
	ДобавитьСервер(СписокСрв, "pre-test-online.saby.ru", 	"pre-test-online.saby.ru");
    Если ОтображатьГОСТСервера Тогда
		ДобавитьСервер(СписокСрв, "g.sbis.ru", 		"g.sbis.ru");
		ДобавитьСервер(СписокСрв, "fix-g.sbis.ru",	"fix-g.sbis.ru");
		ДобавитьСервер(СписокСрв, "test-g.sbis.ru",	"test-g.sbis.ru");
	КонецЕсли;
	ДобавитьСервер(СписокСрв, "online.sabytest.ru",         "online.sabytest.ru");
	Возврат СписокСрв;
КонецФункции

Процедура ДобавитьСервер(СписокСерверов, Адрес, Представление, Индекс = Неопределено)
	АдресСервера = Новый Структура;
	АдресСервера.Вставить("Значение", Адрес);
	АдресСервера.Вставить("Представление", Представление);
	Если Индекс <> Неопределено Тогда
		СписокСерверов.Вставить(Индекс, АдресСервера);
	Иначе	
		СписокСерверов.Добавить(АдресСервера);
	КонецЕсли;		
КонецПроцедуры 

