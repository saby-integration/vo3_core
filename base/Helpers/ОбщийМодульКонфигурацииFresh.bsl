
Функция ОбщийМодульКонфигурации(ИмяМодуля)
	
	Модуль = ОбщийМодульЗначение(ИмяМодуля);
	
	Возврат Модуль;
		
КонецФункции

Функция ОбщийМодульЗначение(ИмяМодуля) Экспорт
	
	Попытка
		Модуль = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);		
	Исключение
		Модуль = Неопределено;
	КонецПопытки;
	
	Возврат Модуль;
		
КонецФункции

