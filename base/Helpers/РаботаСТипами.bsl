
// BSLLS-off

//DynamicDirective
Функция ОписаниеТиповПростыеТипы()

	Возврат Новый ОписаниеТипов(НаборТиповПростыеТипы());

КонецФункции

//DynamicDirective
Функция ОписаниеТиповУниверсальныхКоллекций()

	Возврат Новый ОписаниеТипов(НаборТиповУниверсальныхКоллекций());

КонецФункции

//DynamicDirective
Функция НаборТиповПростыеТипы()

	НаборТиповПТ = Новый Массив;
	НаборТиповПТ.Добавить(Тип("Строка"));
	НаборТиповПТ.Добавить(Тип("Булево"));
	НаборТиповПТ.Добавить(Тип("Число"));
	НаборТиповПТ.Добавить(Тип("Дата"));
	НаборТиповПТ.Добавить(Тип("Неопределено"));
	НаборТиповПТ.Добавить(Тип("Null"));
	НаборТиповПТ.Добавить(Тип("УникальныйИдентификатор"));
	
	Возврат НаборТиповПТ;

КонецФункции

//DynamicDirective
Функция НаборТиповУниверсальныхКоллекций()
	
	НаборТиповУК = Новый Массив;
	НаборТиповУК.Добавить(Тип("Структура"));
	НаборТиповУК.Добавить(Тип("ФиксированнаяСтруктура"));
	НаборТиповУК.Добавить(Тип("Соответствие"));
	НаборТиповУК.Добавить(Тип("Массив"));
	НаборТиповУК.Добавить(Тип("ФиксированныйМассив"));
	НаборТиповУК.Добавить(Тип("СписокЗначений"));
	#Если ТолстыйКлиентОбычноеПриложение Или НаСервере Тогда
		
		НаборТиповУК.Добавить(Тип("ТаблицаЗначений"));
		НаборТиповУК.Добавить(Тип("ДеревоЗначений"));
		
	#КонецЕсли
	
	Возврат НаборТиповУК;
	
КонецФункции

