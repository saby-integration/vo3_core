
// BSLLS:UsingSynchronousCalls-off

//DynamicDirective

Процедура СкопироватьИлиПеренестиФайл(Знач ИмяПапкиОткудаМожноУдалять, Знач ФайлОткуда, Знач ФайлКуда, Знач ПереноситьФайлы)
	// Скопируем/перенесем файл
	СбисНовыйФайл = Новый Файл(ФайлКуда);
	СбисКаталог = Новый Файл(СбисНовыйФайл.Путь);
	Если Не СбисКаталог.Существует() Тогда
		СоздатьКаталог(СбисНовыйФайл.Путь);
	КонецЕсли;
	Если ПереноситьФайлы = Истина Тогда
		// Защита от ошибочного удаления в результате выполнения алгоритма!
		// Проверка на вхождение удаляемого файла/папки в изначально разрешенный каталог
		Если Лев(ФайлОткуда, СтрДлина(ИмяПапкиОткудаМожноУдалять)) <> ИмяПапкиОткудаМожноУдалять Тогда
			ВызватьИсключение "Попытка удалить файл из неразрешенной папки!!!";
		КонецЕсли;
		ПереместитьФайл(ФайлОткуда, ФайлКуда);
	Иначе
		КопироватьФайл (ФайлОткуда, ФайлКуда);
	КонецЕсли;
КонецПроцедуры

//DynamicDirective

Процедура УдалитьВсеПапкиВМассивеФайлов(Знач ИмяПапкиОткудаМожноУдалять, Знач ФайлыДляУдаления)
	// Удалим все найденные папки из исходного массива
	Для Каждого СбисФайлДляУдаления Из ФайлыДляУдаления Цикл
		// Защита от ошибочного удаления в результате выполнения алгоритма!
		// Проверка на вхождение удаляемого файла/папки в изначально разрешенный каталог
		Если Лев(СбисФайлДляУдаления.ПолноеИмя, СтрДлина(ИмяПапкиОткудаМожноУдалять)) <> ИмяПапкиОткудаМожноУдалять Тогда
			ВызватьИсключение "Попытка удалить файл из неразрешенной папки!!!";
		КонецЕсли;
		Попытка
			Если СбисФайлДляУдаления.ЭтоКаталог() Тогда
				УдалитьФайлы(СбисФайлДляУдаления.ПолноеИмя);
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

//DynamicDirective

Функция НайтиИСкопироватьФайлыПоМаске(Знач ИмяПапкиОткудаМожноУдалять, Знач ПапкаОткуда, Знач ПапкаКуда,
			Знач МаскаЧто, Знач ИскатьВПодкаталогах, Знач ПереноситьФайлы)
	Перем РазделительКаталоговОС, Результат;
	
	Результат = Новый Массив; // Пока ничего не копировали. Результат - массив скопированных файлов и папок
	
	// Убираем разделители, если есть
	РазделительКаталоговОС = РазделительКаталоговОС();
	Если Прав(ПапкаОткуда, 1) = РазделительКаталоговОС Тогда
		ПапкаОткуда = Лев(ПапкаОткуда, СтрДлина(ПапкаОткуда) - 1);
	КонецЕсли;
	Если Прав(ПапкаКуда, 1) = РазделительКаталоговОС Тогда
		ПапкаКуда = Лев(ПапкаКуда, СтрДлина(ПапкаКуда) - 1);
	КонецЕсли;
	
	СбисНашлиОбъекты = НайтиФайлы(ПапкаОткуда, МаскаЧто, ИскатьВПодкаталогах);
	Для Каждого СбисНашлиОбъект Из СбисНашлиОбъекты Цикл
		// Файл
		Если Не СбисНашлиОбъект.ЭтоКаталог() Тогда
			// Скопируем/перенесем файл
			СбисНовоеИмяФайла = СтрЗаменить(СбисНашлиОбъект.ПолноеИмя, ПапкаОткуда, ПапкаКуда);
			Результат.Добавить(Новый Файл(СбисНовоеИмяФайла)); // Добавим в результат то, что копировали
			СкопироватьИлиПеренестиФайл(ИмяПапкиОткудаМожноУдалять, СбисНашлиОбъект.ПолноеИмя, СбисНовоеИмяФайла, ПереноситьФайлы);
			Продолжить;
		КонецЕсли;
		// Папка - копируем все вложенное со структурой
		СбисНашлиФайлы = НайтиФайлы(СбисНашлиОбъект.ПолноеИмя, "*", ИскатьВПодкаталогах);
		Для Каждого СбисНашлиФайл Из СбисНашлиФайлы Цикл
			СбисНовоеИмяФайла = СтрЗаменить(СбисНашлиФайл.ПолноеИмя, СбисНашлиОбъект.ПолноеИмя, ПапкаКуда);
			Результат.Добавить(Новый Файл(СбисНовоеИмяФайла)); // Добавим в результат то, что копировали
			// Создадим новый, если это каталог
			Если СбисНашлиФайл.ЭтоКаталог() Тогда
				СоздатьКаталог(СбисНовоеИмяФайла);
				Продолжить;
			КонецЕсли;
			// Скопируем/перенесем файл
			СкопироватьИлиПеренестиФайл(ИмяПапкиОткудаМожноУдалять, СбисНашлиФайл.ПолноеИмя, СбисНовоеИмяФайла, ПереноситьФайлы);
		КонецЦикла;
	КонецЦикла;
	
	// При переносе файлы уже перенесены, удалим исходные найденные папки
	Если ПереноситьФайлы Тогда
		УдалитьВсеПапкиВМассивеФайлов(ИмяПапкиОткудаМожноУдалять, СбисНашлиОбъекты);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

