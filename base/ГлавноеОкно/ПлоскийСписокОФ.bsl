
Процедура ЗаполнитьВидимостьКолонкиПлоскогоСписка(ТабПоле,Колонка,ЭлемФормы,ИмяТаблицы,ОписаниеТипа)
	ИмяКолонки = get_prop(Колонка, "Name", get_prop(Колонка, "NAME"));
	ТекущийРаздел.Колонки = ТекущийРаздел.Колонки + ИмяКолонки + ",";
	ВидимостьКолонки = get_prop(Колонка, "Visibility", get_prop(Колонка, "VISIBLE", Ложь));
	Если ВидимостьКолонки = Ложь Тогда 
		ТабПоле.Значение.Колонки.Добавить(ИмяКолонки, ОписаниеТипа);
		Возврат;
	КонецЕсли;	
	ШаблонКолонки = get_prop(Колонка, "TEMPLATE");
	Если ШаблонКолонки = "column_icon" Тогда
		ЗаполнитьКолонкиИконка(ТабПоле, ИмяТаблицы, ИмяКолонки, Колонка, ЭлемФормы);
		Возврат;
	ИначеЕсли ШаблонКолонки = "column_default" Тогда
		ЗаполнитьКолонкиПоУмолчанию(ТабПоле, ИмяТаблицы, ИмяКолонки, Колонка, ЭлемФормы, ОписаниеТипа);
		Возврат;
	ИначеЕсли ШаблонКолонки = "сolumn_date_number" Тогда
		Колонка["NAME"] = ИмяТаблицы + "_ДатаНомер_";
		ЗаполнитьКолонкиДатаНомер(ТабПоле, ИмяТаблицы, Колонка);
		Возврат;
	ИначеЕсли ШаблонКолонки = "column_document_kedo" Тогда
		Колонка["NAME"] = ИмяТаблицы + "_ДокументКЕДО_";
		ЗаполнитьКолонкиДокументКЭДО(ТабПоле, ИмяТаблицы, Колонка);
		ДобавитьРеквизитыЗагрузитьЕще(ТабПоле, ИмяТаблицы, ОписаниеТипа);
		Возврат;
	ИначеЕсли ШаблонКолонки = "сolumn_employee" Тогда
		Колонка["NAME"] = ИмяТаблицы + "_Сотрудник_";
		ЗаполнитьКолонкиСотрудник(ТабПоле, ИмяТаблицы, Колонка);
		ДобавитьРеквизитыЗагрузитьЕще(ТабПоле, ИмяТаблицы, ОписаниеТипа);
		Возврат;
	Иначе
		ЗаполнитьКолонкиСтарогоФормата(ТабПоле, ИмяТаблицы, ИмяКолонки, Колонка, ЭлемФормы, ОписаниеТипа);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьКолонкиСтарогоФормата(ТабПоле, ИмяТаблицы, ИмяКолонки, Колонка, ЭлемФормы, ОписаниеТипа)
	Поле = ТабПоле.Колонки.Добавить(ИмяТаблицы + ИмяКолонки, Колонка["Title"]);
	Поле.Данные = ИмяКолонки;
	Если get_prop(Колонка, "Properties") <> Неопределено Тогда
		Для Каждого СвойствоПоля Из Колонка["Properties"] Цикл
			Поле[СвойствоПоля.Ключ] = СвойствоПоля.Значение;
		КонецЦикла;
	КонецЕсли;
	Если get_prop(Колонка, "More") = Истина Тогда
		ДобавитьРеквизитыЗагрузитьЕще(ТабПоле, ИмяТаблицы, ОписаниеТипа);
	КонецЕсли;
	Картинка = get_prop(Колонка, "RowIcon");
	Если Картинка <> Неопределено Тогда
		//Поле.КартинкиСтрок = Новый Картинка(МодульОбъекта().ПолучитьМакет(Картинка), Истина);
		Поле.КартинкиСтрок = ЭлемФормы[Картинка].Картинка;
		Поле.ЭлементУправления.ТипЗначения = ОписаниеТипа;
		ИконкиВДанных.Вставить(ИмяТаблицы + ИмяКолонки, ИмяКолонки);
	КонецЕсли;
	ТабПоле.Значение.Колонки.Добавить(ИмяКолонки, ОписаниеТипа);
КонецПроцедуры	

Процедура ЗаполнитьКолонкиИконка(ТабПоле, ИмяТаблицы, ИмяКолонки, Колонка, ЭлемФормы)
	Поле = ТабПоле.Колонки.Добавить(ИмяТаблицы + ИмяКолонки, Колонка["TITLE"]);
	Поле.Данные = get_prop(Колонка, "PROPERTY");
	Если ТипЗнч(get_prop(Колонка, "ICONS")) = Тип("Массив") Тогда
		Для Каждого Иконка Из Колонка["ICONS"] Цикл
			Если Иконка["KEY"] = "Интеграция" Тогда
				Картинка = get_prop(Иконка, "VALUE");
				Если ЗначениеЗаполнено(Картинка) Тогда
					Поле.КартинкиСтрок = ЭлемФормы[Картинка].Картинка;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла
	КонецЕсли;
	Поле.ЭлементУправления.ТипЗначения = Новый ОписаниеТипов("Число");
	Поле.Ширина = ШиринаКолонки(Колонка);
	ИконкиВДанных.Вставить(ИмяТаблицы + ИмяКолонки, Поле.Данные);
КонецПроцедуры

Процедура ЗаполнитьКолонкиПоУмолчанию(ТабПоле, ИмяТаблицы, ИмяКолонки, Колонка, ЭлемФормы, ОписаниеТипа)
	Поле = ТабПоле.Колонки.Добавить(ИмяТаблицы + ИмяКолонки, Колонка["TITLE"]);
	Поле.Данные = ИмяКолонки;
	Поле.ЭлементУправления.ТипЗначения = Новый ОписаниеТипов("Строка");
	Поле.Ширина = ШиринаКолонки(Колонка);
	ТабПоле.Значение.Колонки.Добавить(ИмяКолонки, ОписаниеТипа);
	// Добавляем 1 раз реквизит "ЗагрузитьЕще"
	Если get_prop(Колонка, "MORE_LOAD") = Истина Тогда
		ДобавитьРеквизитыЗагрузитьЕще(ТабПоле, ИмяТаблицы, ОписаниеТипа);
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьРеквизитыЗагрузитьЕще(ТабПоле, ИмяТаблицы, ОписаниеТипа)
	Попытка
		Если ТабПоле.Колонки.Найти(ИмяТаблицы + "ЗагрузитьЕще") = Неопределено Тогда
			Поле = ТабПоле.Колонки.Добавить(ИмяТаблицы + "ЗагрузитьЕще", "Загрузить еще");
			Поле.Данные = "ЗагрузитьЕще";
			Поле.Положение = ПоложениеКолонки.НаСледующейСтроке;
			Поле.Гиперссылка = Истина;
			Поле.ОтображатьВШапке = Ложь;
			// BSLLS:StyleElementConstructors-off
			Поле.ЦветТекстаПоля = Новый Цвет(0, 85, 187);
			// BSLLS:StyleElementConstructors-on
			Если ТабПоле.Значение.Колонки.Найти(ИмяТаблицы + "ЗагрузитьЕще") = Неопределено Тогда
				ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки());
				ТабПоле.Значение.Колонки.Добавить("ЗагрузитьЕще", ОписаниеТипаСтрока);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Поле = Неопределено;
	КонецПопытки;
КонецПроцедуры

Процедура ПрименитьОбщиеПараметрыКолонки(Элем, Колонка, Ширина = Неопределено)
	// Видимость
	Если get_prop(Колонка, "VISIBLE") = Истина Тогда
		Элем.Видимость = Истина;
	Иначе
		Элем.Видимость = Ложь;
	КонецЕсли;
	// Выравнивание
	Выравнивание = get_prop(Колонка, "ALIGN", "2");
	Если Выравнивание = "1" Тогда
		Элем.ГоризонтальноеПоложениеВКолонке = ГоризонтальноеПоложение.Право;
	ИначеЕсли Выравнивание = "2" Тогда
		Элем.ГоризонтальноеПоложениеВКолонке = ГоризонтальноеПоложение.Лево;
	Иначе
		Элем.ГоризонтальноеПоложениеВКолонке = ГоризонтальноеПоложение.Центр;
	КонецЕсли;
	// Ширина
	Если Ширина = Неопределено Тогда
		Элем.Ширина = ШиринаКолонки(Колонка);
	Иначе
		Если Ширина <> Ложь Тогда
			Попытка
				Элем.Ширина = Ширина;
			Исключение
				Элем.Ширина = 0;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, Заголовок, Колонка,
		Положение = "-", Ширина = Неопределено, ДобавитьВТЗ = Истина)
		
	Поле = ТабПоле.Колонки.Добавить(ИмяЭлемента, Заголовок);
	// Группировка
	Если Положение = "-" Тогда
		Поле.Положение = ПоложениеКолонки.НоваяКолонка;
	ИначеЕсли Положение = "|" Тогда
		Поле.Положение = ПоложениеКолонки.НаСледующейСтроке;
	Иначе
		Поле.Положение = ПоложениеКолонки.НоваяКолонка;
	КонецЕсли;
	Поле.Данные = ИмяЭлемента;
	Поле.ЭлементУправления.ТипЗначения = ТипДанных;
	ПрименитьОбщиеПараметрыКолонки(Поле, Колонка, Ширина);
	Если ДобавитьВТЗ Тогда
		ТабПоле.Значение.Колонки.Добавить(ИмяЭлемента, ТипДанных);
	КонецЕсли;
	Возврат Поле;
КонецФункции

Процедура ЗаполнитьКолонкиДатаНомер(ТабПоле, ИмяТаблицы, Колонка)
	ТипДанных = Новый ОписаниеТипов("Строка");
	// Дата
	ИмяЭлемента = Колонка["NAME"] + "_Дата_";
	ИмяДанные = get_prop(Колонка, "DATE_PROPERTY");
	Поле = ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "Дата", Колонка, "-");
	//Поле.ШрифтТекста = Новый Шрифт(Поле.ШрифтТекста,,,Истина); // Жирный шрифт
	Поле.Формат = "ДФ=dd.MM.yy";
	// Номер
	ИмяЭлемента = Колонка["NAME"] + "_Номер_";
	ИмяДанные = get_prop(Колонка, "NUMBER_PROPERTY");
	Поле = ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "Номер", Колонка, "|");
КонецПроцедуры

Процедура ЗаполнитьКолонкиДокументКЭДО(ТабПоле, ИмяТаблицы, Колонка)
	локШирина = ШиринаКолонки(Колонка);
	Если локШирина = 0 Тогда
		локШирина = 60;
	КонецЕсли;
	ОднаТреть = 1 / 3;
	ДвеТрети  = 2 / 3;
	ИмяКолонки = Колонка["NAME"];
	ТипДанных = Новый ОписаниеТипов("Строка");
	
	// Колонка 1
	// Тип
	ИмяЭлемента = ИмяКолонки + "_Тип_";
	ИмяДанные = get_prop(Колонка, "TYPE_PROPERTY");
	Если ЗначениеЗаполнено(ИмяДанные) Тогда
		ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "Тип", Колонка, "-", локШирина * ДвеТрети);
	КонецЕсли;
	// ФИО
	ИмяЭлемента = ИмяКолонки + "_ФИО_";
	ИмяДанные = get_prop(Колонка, "PROPERTY");
	ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "ФИО", Колонка, "|", локШирина * ДвеТрети);
	// Инфо
	ИмяЭлемента = ИмяКолонки + "_Инфо_";
	ИмяДанные = get_prop(Колонка, "INFO_PROPERTY");
	ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "Комментарий", Колонка, "|", локШирина * ДвеТрети);
	// Вложения
	ИмяЭлемента = ИмяКолонки + "_Вложения_";
	ИмяДанные = get_prop(Колонка, "ATTACHMENTS_PROPERTY");
	Если ЗначениеЗаполнено(ИмяДанные) Тогда
		ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "Вложения", Колонка, "|", локШирина * ДвеТрети);
	КонецЕсли;
	
	// Колонка 2
	// Организация
	ИмяЭлемента = ИмяКолонки + "_Организация_";
	ИмяДанные = get_prop(Колонка, "ORG_PROPERTY");
	ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "Организация", Колонка, "-", локШирина * ОднаТреть);
	// Должность
	ИмяЭлемента = ИмяКолонки + "_Должность_";
	ИмяДанные = get_prop(Колонка, "POSITION_PROPERTY");
	ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "Должность", Колонка, "|", локШирина * ОднаТреть);
	// Этап
	ИмяЭлемента = ИмяКолонки + "_Этап_";
	ИмяДанные = get_prop(Колонка, "STAGE_PROPERTY");
	ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "Этап", Колонка, "|", локШирина * ОднаТреть);
КонецПроцедуры

Процедура ЗаполнитьКолонкиСотрудник(ТабПоле, ИмяТаблицы, Колонка)
	локШирина = ШиринаКолонки(Колонка);
	Если локШирина = 0 Тогда
		локШирина = 40;
	КонецЕсли;
	Половина  = 1 / 2;
	ИмяКолонки = Колонка["NAME"];
	ТипДанных = Новый ОписаниеТипов("Строка");
	
	// Столбец 1
	// Организация
	ИмяЭлемента = ИмяКолонки + "_Организация_";
	ИмяДанные = get_prop(Колонка, "ORG_PROPERTY");
	ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "Организация", Колонка, "-", локШирина * Половина);
	// ФИО
	ИмяЭлемента = ИмяКолонки + "_ФИО_";
	ИмяДанные = get_prop(Колонка, "PROPERTY");
	ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "ФИО", Колонка, "|", локШирина * Половина);
	// Должность
	ИмяЭлемента = ИмяКолонки + "_Должность_";
	ИмяДанные = get_prop(Колонка, "POSITION_PROPERTY");
	ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "Должность", Колонка, "|", локШирина * Половина);
	
	// Столбец 2
	// Департамент
	ИмяЭлемента = ИмяКолонки + "_Департамент_";
	ИмяДанные = get_prop(Колонка, "DEPARTMENT_PROPERTY");
	ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "Департамент", Колонка, "-", локШирина * Половина);
	// Телефон
	ИмяЭлемента = ИмяКолонки + "_Телефон_";
	ИмяДанные = get_prop(Колонка, "TEL_PROPERTY");
	ДобавитьКолонкуВЭлементыФормы(ТабПоле, ИмяТаблицы, ИмяЭлемента, ИмяДанные, ТипДанных, "Телефон", Колонка, "|", локШирина * Половина);
КонецПроцедуры

Процедура ЗаполнитьКолонкиПлоскогоСписка() Экспорт
	ЭлемФормы = ПолучитьЭлементыФормыНаСервере();
	ИмяТаблицы = ТекущийРаздел["Шаблон"]; 
	
	ИконкиВДанных = Новый Соответствие;
	ИконкиВДанных.Очистить();
	ТабПоле = ЭлемФормы[ИмяТаблицы];
	ТабПоле.Значение.Очистить();
	ТабПоле.Колонки.Очистить();
	ТабПоле.Значение.Колонки.Очистить();
	Поле = ТабПоле.Колонки.Добавить(ИмяТаблицы + "Отмечен", "V");
	ТабПоле.Значение.Колонки.Добавить("Отмечен", Новый ОписаниеТипов("Булево"));
	Поле.УстановитьЭлементУправления(Тип("Флажок"));
	Поле.ДанныеФлажка = "Отмечен";
	Поле.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;
	Поле.Ширина = 4;
	Поле.ИзменениеРазмера = ИзменениеРазмераКолонки.НеИзменять;
	Поле.ОтображатьИерархию = Истина;
	
	ЭлемФормы.ПлоскийСписок.РежимВыделения = РежимВыделенияТабличногоПоля.Одиночный;
	Если get_prop(ТекущийРаздел, "МножественныйВыбор") <> Истина Тогда
		Поле.Видимость = Ложь;
		ЭлемФормы.ОтметитьВсеПлоскийСписок.Видимость = Ложь;
		ЭлемФормы.ОтметитьВсеПлоскийСписок.Доступность = Ложь;
	КонецЕсли;
	
	ТекущийРаздел.Вставить("Колонки", "");
	КвалификаторыСтроки = Новый КвалификаторыСтроки();
	ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка", ,КвалификаторыСтроки);
	Колонки = КолонкиСписка();
	Для Каждого Колонка Из Колонки Цикл
		ОписаниеТипа = ОписаниеТипаСтрока;
		ТипКолонки = get_prop(Колонка, "TYPE", get_prop(Колонка, "Type"));
		Если ТипКолонки <> Неопределено Тогда
			ОписаниеТипа = ОписаниеТипаКолонки(ТипКолонки);
		КонецЕсли;
		ЗаполнитьВидимостьКолонкиПлоскогоСписка(ТабПоле,Колонка,ЭлемФормы,ИмяТаблицы,ОписаниеТипа);
	КонецЦикла;
	// Принудительно добавляем в ТЗ колонку "ЗагрузитьЕще", если её нет
	Если ТабПоле.Колонки.Найти(ИмяТаблицы + "ЗагрузитьЕще") = Неопределено Тогда
		ДобавитьРеквизитыЗагрузитьЕще(ТабПоле, ИмяТаблицы, ОписаниеТипаСтрока);
	КонецЕсли;
КонецПроцедуры

Процедура ПлоскийСписокПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
	Если ДанныеСтроки.ЗагрузитьЕще <> "" Тогда
		Для Каждого Ячейка Из ОформлениеСтроки.Ячейки Цикл
			Если Ячейка.Имя <> "ПлоскийСписокЗагрузитьЕще" Тогда
				Ячейка.Видимость = Ложь;	
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецЕсли;	
	ОформлениеСтроки.Ячейки.ПлоскийСписокЗагрузитьЕще.Видимость = Ложь;
	Попытка
		Если ТипЗнч(ИконкиВДанных) <> Тип("Соответствие") Тогда
			Возврат;
		КонецЕсли;
		Для Каждого ИконкаВДанных Из ИконкиВДанных Цикл
			Если ОформлениеСтроки.Ячейки.Найти(ИконкаВДанных.Ключ) <> Неопределено Тогда
				Если ДанныеСтроки[ИконкаВДанных.Значение] >= 0 Тогда
					ОформлениеСтроки.Ячейки[ИконкаВДанных.Ключ].ОтображатьКартинку = Истина;
					ОформлениеСтроки.Ячейки[ИконкаВДанных.Ключ].ИндексКартинки = ДанныеСтроки[ИконкаВДанных.Значение];
				КонецЕсли;
				ОформлениеСтроки.Ячейки[ИконкаВДанных.Ключ].ОтображатьТекст = Ложь;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

