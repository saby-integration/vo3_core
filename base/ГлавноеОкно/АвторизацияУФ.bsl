Процедура ПриОткрытииАвторизация() Экспорт
	session = ТранспортИнтеграции.СвойствоСессии(context_params, "session");
	Если НЕ ЗначениеЗаполнено(session) Тогда
		формаАвторизации = ФормаОсновнойОбработки("Вход", КэшФорм.ПутьКФормам,,ЭтаФорма); 
		формаАвторизации.Открыть();
	Иначе
		ПриОткрытииПослеАвторизации(Истина);
	КонецЕсли;
