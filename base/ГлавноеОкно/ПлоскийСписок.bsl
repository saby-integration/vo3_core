	// Этап
	ИмяКолонки = Колонка["NAME"] + "_Этап_";
	ПутьКДанным = Колонка["STAGE_PROPERTY"];
	УстановитьЗначениеВКолонку(ИмяКолонки, ПутьКДанным, Таблица, Стр, СтрТ, МодульОбъекта);
КонецПроцедуры

