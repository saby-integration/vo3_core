
&НаКлиенте
Процедура ПлоскийСписокПриОткрытии(ПараметрыОтображения)
	ЭтаФорма.Страница = 0;
	ОчиститьПанельОпераций(ТекущийРаздел.ПараметрыОтображения);
	ОчиститьКонтекстноеМеню();
	ОчиститьПанельФильтра(ТекущийРаздел.ПараметрыОтображения);
	ТекущийРаздел.Вставить("ПараметрыОтображения", ПараметрыОтображения);
			
	ЗаполнитьФильтр();
	ЗаполнитьКолонкиПлоскогоСписка();
	ЭтаФорма.ФильтрМаска = "";
	ДанныеФильтра.Значения.Вставить("ФильтрМаска", ЭтаФорма.ФильтрМаска);
	ДанныеФильтра.Значения.Вставить("Search", ЭтаФорма.ФильтрМаска);
	ОбновитьСписок(ДанныеФильтра.Значения);
	ДанныеФильтра.ПараметрыОтображения = ФильтрСписка();
	УстановитьВидимостьФильтра();
	ОбновитьПанельФильтра();
	ОбновитьПанельОпераций();
	ОбновитьКонтекстноеМеню();
КонецПроцедуры

&НаКлиенте
Функция КопияФильтраСНастроеннымПериодом(ИсходныйФильтр)
	
	ФильтрКопия = Новый ФиксированнаяСтруктура(ИсходныйФильтр);
	Фильтр = Новый Структура(ФильтрКопия);
	
	Попытка
		Если ТипЗнч(Фильтр.ДатаНач) = Тип("Дата") Тогда
			Фильтр.ДатаНач = Формат(Фильтр.ДатаНач, "ДФ=yyyy-MM-dd");
		КонецЕсли;
		Если ТипЗнч(Фильтр.ДатаКнц)   = Тип("Дата") Тогда
			Фильтр.ДатаКнц   = Формат(Фильтр.ДатаКнц,   "ДФ=yyyy-MM-dd");
		КонецЕсли;
	Исключение
		Возврат Фильтр;
	КонецПопытки;
	
	Возврат Фильтр;
	
КонецФункции

&НаКлиенте
Функция ПолучитьДанныеСписка(Фильтр) Экспорт
	НовыйФильтр = КопияФильтраСНастроеннымПериодом(Фильтр);
	ПолеРодителя = get_prop(ТекущийРаздел.ПараметрыОтображения, "PARENT_PROPERTY");
	Pagination = Новый Структура();
	Pagination.Вставить("PageSize", КоличествоЭлементовСписка());
	Если ПолеРодителя = Неопределено Или get_prop(НовыйФильтр, ПолеРодителя) = Неопределено Тогда
		Pagination.Вставить("Page", Страница);
	Иначе
		ИдИС = get_prop(НовыйФильтр, ПолеРодителя);
		ИдИСВКлюч = "id" + СтрЗаменить(ИдИС, "-", "_");
		ТекущаяСтраницаПоРодителю = get_prop(СтраницыПоРодителям, ИдИСВКлюч, 0);		
		Pagination.Вставить("Page", ТекущаяСтраницаПоРодителю);		
	КонецЕсли; 
	EndpointArgs = Новый Структура;
	EndpointArgs.Вставить("Filter", НовыйФильтр);
	EndpointArgs.Вставить("Pagination", Pagination); 
	ПараметрыКоманды = Новый Структура("Algorithm, Endpoint,EndpointArgs", ТекущийРаздел["Идентификатор"], "main", EndpointArgs);
	РезультатИни = BlocklyExecutor.LocalCalcIni(ПараметрыКоманды);
	Если РезультатИни["Status"] = "error" Тогда
		СтруктураОшибки = NewExtExceptionСтруктура(, "Ошибка выполнения ini: '" + ПараметрыКоманды["Algorithm"]
				+ "', endpoint: '" + ПараметрыКоманды["Endpoint"] + "'" + Символы.ПС + РезультатИни.Result.message,
			РезультатИни.Result.detail, РезультатИни.Result.action);	
		ВызватьИсключение ExtExceptionToMessage(СтруктураОшибки);
	КонецЕсли;	
	Результат = РезультатИни.Result;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеПлоскогоСписка(Таблица, Данные) Экспорт
	МодульОбъекта = МодульОбъекта();
	Список = Данные["Rows"];
	Навигация = Данные["Pagination"];
	
	ЛесенкаПредЗначения = Новый Структура;
	ЛесенкаПредЗначения.Вставить("ПредДата",  Неопределено);
	ЛесенкаПредЗначения.Вставить("ПредНомер", Неопределено);
	КолонкиСписка = КолонкиСписка();
	
	Для Каждого Стр Из Список Цикл
		СтрТ = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТ, Стр);
		Для Каждого Колонка Из КолонкиСписка Цикл
			ШаблонКолонки = get_prop(Колонка, "TEMPLATE");
			Если ЗначениеЗаполнено(ШаблонКолонки) Тогда
				ДанныеПлоскогоСпискаПоШаблону(ШаблонКолонки, Таблица, Колонка, Стр, СтрТ, МодульОбъекта, ЛесенкаПредЗначения);
				Продолжить;
			КонецЕсли;
			ПутьКДанным = get_prop(Колонка, "Data", get_prop(Колонка, "PROPERTY"));
			ИмяКолонки = get_prop(Колонка, "Name", get_prop(Колонка, "NAME"));
			Если ЗначениеЗаполнено(ПутьКДанным) Тогда
				СтрТ[ИмяКолонки] = МодульОбъекта.block_obj_get_path_value(Стр, ПутьКДанным, "");
			Иначе
				СтрТ[ИмяКолонки] = "";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ЕстьЕще = get_prop(Навигация, "HasMore");
	Если ЕстьЕще = Истина Или ЕстьЕще = "Да" Тогда
		СтрТ = Таблица.Добавить();
		СтрТ["ЗагрузитьЕще"] = "Загрузить еще";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДанныеПлоскогоСпискаПоШаблону(ШаблонКолонки, Таблица, Колонка, Стр, СтрТ, МодульОбъекта, Лесенка)
	Если ШаблонКолонки = "column_date_number" Тогда
		ДанныеПлоскогоСпискаПоШаблонуДатаНомер(Таблица, Колонка, Стр, СтрТ, МодульОбъекта, Лесенка);
	ИначеЕсли ШаблонКолонки = "column_document_kedo" Тогда
		ДанныеПлоскогоСпискаПоШаблонуДокументКЭДО(Таблица, Колонка, Стр, СтрТ, МодульОбъекта, Лесенка);
	ИначеЕсли ШаблонКолонки = "column_default" Тогда
		ИмяКолонки = Колонка["NAME"];
		ПутьКДанным = Колонка["PROPERTY"];
		УстановитьЗначениеВКолонку(ИмяКолонки, ПутьКДанным, Таблица, Стр, СтрТ, МодульОбъекта);
	ИначеЕсли ШаблонКолонки = "column_icon" Тогда
		ИмяКолонки = Колонка["NAME"];
		ПутьКДанным = Колонка["PROPERTY"];
		УстановитьЗначениеВКолонку(ИмяКолонки, ПутьКДанным, Таблица, Стр, СтрТ, МодульОбъекта);
	ИначеЕсли ШаблонКолонки = "column_employee" Тогда
		ДанныеПлоскогоСпискаПоШаблонуСотрудник(Таблица, Колонка, Стр, СтрТ, МодульОбъекта, Лесенка);
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеВКолонкуСЛесенкой(ИмяКолонки, ПутьКДанным, Таблица, Колонка, Стр, СтрТ, МодульОбъекта,
		Лесенка, ЛесенкаИмя)

	Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПутьКДанным) Тогда
		ТекДанные = МодульОбъекта.block_obj_get_path_value(Стр, ПутьКДанным, "");
		Если ЛесенкаИмя = "ПредДата" Тогда
			ТекДанные = Формат(ТекДанные, "ДФ=dd.MM.yy");
		КонецЕсли;
		Если get_prop(Колонка, "LADDER") = Истина Тогда
			Если Лесенка[ЛесенкаИмя] <> ТекДанные Тогда
				СтрТ[ИмяКолонки] = ТекДанные;
				Лесенка[ЛесенкаИмя] = ТекДанные;
			Иначе
				СтрТ[ИмяКолонки] = "";
			КонецЕсли;
		Иначе
			СтрТ[ИмяКолонки] = ТекДанные;
		КонецЕсли;
	Иначе
		СтрТ[ИмяКолонки] = "";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеВКолонку(ИмяКолонки, ПутьКДанным, Таблица, Стр, СтрТ, МодульОбъекта)
	Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
		Если ЗначениеЗаполнено(ПутьКДанным) Тогда
			СтрТ[ИмяКолонки] = МодульОбъекта.block_obj_get_path_value(Стр, ПутьКДанным, "");
		Иначе
			СтрТ[ИмяКолонки] = "";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДанныеПлоскогоСпискаПоШаблонуДатаНомер(Таблица, Колонка, Стр, СтрТ, МодульОбъекта, Лесенка)
	// Дата
	ИмяКолонки = Колонка["NAME"] + "_Дата_";
	ПутьКДанным = Колонка["DATE_PROPERTY"];
	УстановитьЗначениеВКолонкуСЛесенкой(ИмяКолонки, ПутьКДанным, Таблица, Колонка, Стр, СтрТ, МодульОбъекта, Лесенка, "ПредДата");
	// Номер
	ИмяКолонки = Колонка["NAME"] + "_Номер_";
	ПутьКДанным = Колонка["NUMBER_PROPERTY"];
	УстановитьЗначениеВКолонкуСЛесенкой(ИмяКолонки, ПутьКДанным, Таблица, Колонка, Стр, СтрТ, МодульОбъекта, Лесенка, "ПредНомер");
КонецПроцедуры

