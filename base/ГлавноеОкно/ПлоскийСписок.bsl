&НаКлиенте
Процедура ПлоскийСписокВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Колонка.Имя = "ПлоскийСписокЗагрузитьЕще" Тогда
		ПлоскийСписок.Удалить(Элемент.ТекущиеДанные);
		ЗагрузитьЕщеПлоскийСписокНажатие();
		Возврат;	
	КонецЕсли;
	ОткрытьФорму1СПоСтрокеПлоскогоСписка(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФорму1СПоСтрокеПлоскогоСписка(Элемент)
	// Обрабатываем эндпоинт "activate_row" в ini, если есть
	// https://link.saby.ru/article/e126fb97-5142-4158-9d38-92e099bc179b
	EndpointArgs = Новый Структура;
	ИмяЭндпоинтаПоСтроке = "activate_row";
	ПараметрыКоманды = Новый Структура("Algorithm, Endpoint, EndpointArgs", ТекущийРаздел["Идентификатор"],
												   ИмяЭндпоинтаПоСтроке, EndpointArgs);
	РезультатИни = BlocklyExecutor.LocalCalcIni(ПараметрыКоманды);
	Результат = РезультатИни.Result;
	Если РезультатИни["Status"] = "error" Тогда
		Если Найти(НРег(Результат["message"]), НРег("Не найден endpoint " + ИмяЭндпоинтаПоСтроке)) = 0 Тогда
			СтруктураОшибки = NewExtExceptionСтруктура(, "Ошибка выполнения ini: '" + ПараметрыКоманды["Algorithm"]
					+ "', endpoint: '" + ПараметрыКоманды["Endpoint"] + "'" + Символы.ПС + РезультатИни.Result.message,
				РезультатИни.Result.detail, РезультатИни.Result.action);	
			ВызватьИсключение ExtExceptionToMessage(СтруктураОшибки);
		КонецЕсли;
	Иначе
		// Если вернулась команда, выполняем
		ИмяКоманды = get_prop(Результат, "NAME");
		Действие = get_prop(Результат, "ACTION");
		Если get_prop(Результат, "TEMPLATE") = "command" И ИмяКоманды <> Неопределено И Действие <> Неопределено Тогда
			RUN_TOOLBAR_COMMAND(ИмяКоманды, get_prop(Результат, "ARGS", Новый Структура), Действие);
		КонецЕсли;
		Возврат; // Выполнили эндпоинт activate_row без ошибок, выходим
	КонецЕсли;	
	
	ВыбраннаяСтрокаДанные = Элемент.ТекущиеДанные;
	Попытка
		ИмяФормыДокумента = ВыбраннаяСтрокаДанные["ФормаПросмотра"];
	Исключение
		ИмяФормыДокумента = Неопределено;	
	КонецПопытки;
	ИмяФормыПоУмолчанию = get_prop(ТекущийРаздел.ПараметрыОтображения, "FORM", 
								get_prop(ТекущийРаздел.ПараметрыОтображения, "Form"));
	Попытка
		ДокументСБИС = ВыбраннаяСтрокаДанные["ДокументСБИС"];
	Исключение
		ДокументСБИС = Неопределено;
	КонецПопытки;
	Попытка
		ДокументИС = ВыбраннаяСтрокаДанные["ДокументИС"]; 
	Исключение
		ДокументИС = Неопределено;
	КонецПопытки;
	Если ДокументИС = Неопределено Тогда
		Попытка
			ДокументИС = ВыбраннаяСтрокаДанные["ОбъектИС"]; 
		Исключение
			ДокументИС = Неопределено;
		КонецПопытки;
	КонецЕсли;
	ShowForm(КэшФорм.Формы, КэшФорм.ИменаФорм, КэшФорм.ПутьКФормам, ДокументИС, ДокументСБИС, ИмяФормыДокумента, ИмяФормыПоУмолчанию);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЕщеПлоскийСписокНажатие()
	БылоСтрок = ПлоскийСписок.Количество(); 
	ЭтаФорма.Страница = ЭтаФорма.Страница + 1;
	ОбновитьСписок(ДанныеФильтра.Значения);
	// позиционируемся на первую из добавленных строк
	ПолучитьЭлементыФормы().ПлоскийСписок.ТекущаяСтрока = СтрокаТаблицыФормы(ПлоскийСписок, БылоСтрок);
КонецПроцедуры

&НаКлиенте
Функция СписокОтмеченныхЗаписей(ЭтоСписокСсылок = Ложь)
	ИмяТаблицы = ТекущийРаздел["Шаблон"];
	Если ИмяТаблицы = "ИерархическийСписок" Тогда 
		Возврат СписокОтмеченныхЗаписейИерархическийСписок();
	Иначе
		Возврат СписокОтмеченныхЗаписейПлоскийСписок();
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция СписокОтмеченныхЗаписейПлоскийСписок()
	
	СписокОтмеченных = Новый Массив;
	Для Каждого Строка Из ПлоскийСписок Цикл
		Если Строка.Отмечен Тогда
			НоваяСтрока = Новый Структура(ТекущийРаздел.Колонки);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			СписокОтмеченных.Добавить(НоваяСтрока);	
		КонецЕсли;
	КонецЦикла;
	Если СписокОтмеченных.Количество()=0 Тогда
		ЭлемФормы = ПолучитьЭлементыФормы();
		Если ЭлемФормы.ПлоскийСписок.ТекущаяСтрока<>Неопределено Тогда
			НоваяСтрока = Новый Структура(ТекущийРаздел.Колонки);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлемФормы.ПлоскийСписок.ТекущиеДанные);
			СписокОтмеченных.Добавить(НоваяСтрока);
		КонецЕсли;
	КонецЕсли;
	Возврат СписокОтмеченных;

КонецФункции

&НаКлиенте
Процедура ОтметитьВсеПлоскийСписокНажатие(Элемент)
	ОтмеченыВсе = Не ОтмеченыВсе;
	Для Каждого Строка Из ПлоскийСписок Цикл 
		Если ЗначениеЗаполнено(get_prop(Строка, "ЗагрузитьЕще")) Тогда
			Продолжить;
		КонецЕсли;	
		Строка.Отмечен = ОтмеченыВсе;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФорму1СПлоскогоСписка(Команда) Экспорт
	ЭлемФормы = ПолучитьЭлементыФормы();
	ОткрытьФорму1СПоСтрокеПлоскогоСписка(ЭлемФормы.ПлоскийСписок);		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТиповуюФормуОбъекта(Команда) Экспорт
	ЭлемФормы = ПолучитьЭлементыФормы();
	ВыбраннаяСтрокаДанные = ЭлемФормы.ПлоскийСписок.ТекущиеДанные;
	Если ВыбраннаяСтрокаДанные <>Неопределено Тогда 
		Попытка
			ДокументИС = ВыбраннаяСтрокаДанные["ДокументИС"]; 
		Исключение
			ДокументИС = Неопределено;
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(ДокументИС) Тогда
			Сообщить("Нет связанных документов 1С");
			Возврат;
		КонецЕсли;
		ОткрытьПоказатьЗначение(ДокументИС);
	КонецЕсли;
КонецПроцедуры
