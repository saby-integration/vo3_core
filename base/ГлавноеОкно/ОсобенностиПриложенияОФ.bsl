
&НаКлиенте
Процедура ПередЗакрытиемГО(Отказ, СтандартнаяОбработка)
	Если ТипЗнч(context_params) = Тип("Структура") И ТекущийРаздел <> Неопределено Тогда
		context_params.Вставить("РазделПоУмолчанию", ТекущийРаздел.Идентификатор);
		ЗаписатьНастройкиНаСервере();
	КонецЕсли;
КонецПроцедуры

