#КонецОбласти

&НаКлиенте
Процедура ОбработатьДействиеНаКлиенте(ИмяДействия, Параметры)
	Если ИмяДействия = "ADDON_CLICK" Тогда
		Если Параметры = "addon_status_version" Тогда
			СбисОбновитьОбработкуНаКлиенте();
		ИначеЕсли Параметры = "addon_version" Тогда
			// BSLLS:UsingSynchronousCalls-off
			ЗапуститьПриложение(СтатусВерсии.СсылкаДляСкачивания);
			// BSLLS:UsingSynchronousCalls-on
		//ИначеЕсли Параметры = "addon_logo" Тогда //пока никак не обрабатывается
		Иначе
			Возврат;
		КонецЕсли
	ИначеЕсли ИмяДействия = "ADDON_NAVIGATE" Тогда
		ТекущийРаздел.Вставить("Идентификатор", Параметры);
		ПоказатьШаблон();
	Иначе
		ОбработатьДействие(ИмяДействия, Параметры);
	КонецЕсли;
КонецПроцедуры 

&НаСервере
Функция ОбработатьДействие(Знач ИмяДействия, Знач Параметры)
	МодульОбъекта = МодульОбъекта();
	Если ИмяДействия = "ADDON_READSYSTEMINFO" Тогда
		МодульОбъекта.API_ADDON_READSYSTEMINFO(Параметры);	
	Иначе
		ВызватьИсключение NewExtExceptionСтрока(,"Неизвестная команда", ИмяДействия);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

