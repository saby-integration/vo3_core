&НаКлиенте
Процедура ОбработкаОповещенияНаКлиенте(ИмяСобытия, Параметр, Источник)
	НазваниеПродукта = ЛокализацияНазваниеПродукта();
	ОбработкаОповещения(ИмяСобытия, Параметр, НазваниеПродукта);
	Если ИмяСобытия = НазваниеПродукта + "_ЗакрытиеФормыАвторизации" Тогда
		Если get_prop(Параметр, "АвторизацияУспешна", Ложь) = Ложь Тогда
			Если ЭтаФорма.Открыта() Тогда
				ЭтаФорма.Закрыть();
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = НазваниеПродукта + "_ЗакрытиеФормыАвторизации" Или ИмяСобытия = "Saby_НастройкиИзменены" Тогда
		Если ПроверитьНаличиеПараметровПодключенияНаСервере() = Неопределено Тогда
			ПоказатьОповещениеПользователя(
				"Функционал " + НазваниеПродукта + " недоступен.",
				Неопределено,
				"Для работы необходимо авторизоваться.",
				КартинкаОшибка(),
				СтатусОповещенияПользователя.Важное);
			Возврат;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТекущийРаздел["Идентификатор"]) Тогда
			ПриОткрытииПослеАвторизации(Истина);
		Иначе
			ОбновитьЗаголовокФормы();
			ПоказатьШаблон();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, НазваниеПродукта)
	Если ИмяСобытия = НазваниеПродукта + "_ЗакрытиеФормыАвторизации" Или ИмяСобытия = "Saby_НастройкиИзменены" Тогда
		ЭтаФорма.context_params = СБИСПараметры();
	ИначеЕсли ИмяСобытия = "Saby_ЗавершениеВыполнитьДействие" Тогда
		ПослеВыполненияДействия(Параметр);
	ИначеЕсли ИмяСобытия = "SabySignOut" Тогда
		// Перечитаем настройки при выходе
		ЭтаФорма.context_params = СБИСПараметры();
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

