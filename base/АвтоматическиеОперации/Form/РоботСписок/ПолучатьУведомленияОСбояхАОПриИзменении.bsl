
&НаКлиенте
Процедура ПолучатьУведомленияОСбояхАОПриИзменении(Элемент)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	
	ДоступностьПочта = ЭтаФорма.ПолучатьУведомленияОСбояхАО;
	Если  Не ДоступностьПочта Тогда
		ДоступностьПочта = Ложь;
		ЭтаФорма.ЭлектроннаяПочтаДляРассылки = "";
	КонецЕсли;
	
	ЭлементыФормочки.ЭлектроннаяПочтаДляРассылки.Доступность = ДоступностьПочта;
	ЭлементыФормочки.ПроверитьОтправку.Доступность = ДоступностьПочта;
КонецПроцедуры
