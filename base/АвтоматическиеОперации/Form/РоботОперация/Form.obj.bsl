   		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура СоздатьУзелПланаОбмена()
	УзелПланаОбмена = ПланыОбмена[НазваниеПланаОбмена].ПолучитьСсылку(
		Новый УникальныйИдентификатор(ЭтаФорма.ИдентификаторПодключения));
	Если ЗначениеЗаполнено(УзелПланаОбмена.Код) Тогда 
		Возврат;
	КонецЕсли;	
	Если Метаданные.Константы.Найти("ИспользоватьСинхронизациюДанных") <> Неопределено Тогда
		Константы["ИспользоватьСинхронизациюДанных"].Установить(Истина);
	КонецЕсли;	
	УзелСоздан = Ложь;
	Для Сч = 0 По 100 Цикл	
		Попытка 
			КодУзла = "S"+Сч; 
			НовыйУзел = ПланыОбмена[НазваниеПланаОбмена].СоздатьУзел(); 
			НовыйУзел.УстановитьСсылкуНового(УзелПланаОбмена);	
			НовыйУзел.Код = КодУзла;
			НовыйУзел.Наименование = ЛокализацияНазваниеПродукта() + " " + НаименованиеПодключения;
			МетаданныеПланаОбмена = Метаданные.ПланыОбмена.Найти(НазваниеПланаОбмена);
			Если МетаданныеПланаОбмена.Реквизиты.Найти("СинхронизироватьДанныеПоОрганизациям") <> Неопределено Тогда
				НовыйУзел.СинхронизироватьДанныеПоОрганизациям = Истина;
			КонецЕсли;	
			Если МетаданныеПланаОбмена.Реквизиты.Найти("РегистрироватьИзменения") <> Неопределено Тогда
				НовыйУзел.РегистрироватьИзменения = Истина;
			КонецЕсли;
			Если МетаданныеПланаОбмена.ТабличныеЧасти.Найти("РазделыДанных") <> Неопределено Тогда
				НовыйРаздел = НовыйУзел.РазделыДанных.Добавить();
				НовыйРаздел.Идентификатор = "ОбщиеДанные";
				НовыйРаздел = НовыйУзел.РазделыДанных.Добавить();
				НовыйРаздел.Идентификатор = "РегламентированныеДанные";
			КонецЕсли; 
			НовыйУзел.Записать();
			УзелСоздан = Истина;
			Прервать;
		Исключение
			Продолжить;
		КонецПопытки;			
	КонецЦикла;	
	УзелПланаОбмена = ПланыОбмена[НазваниеПланаОбмена].ПолучитьСсылку(
		Новый УникальныйИдентификатор(ЭтаФорма.ИдентификаторПодключения));
	Если УзелСоздан = Истина Тогда
		Сообщить("Для настройки обмена создан узел " + УзелПланаОбмена.Наименование);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораАлгоритма(Результат, ДополнительныеПараметры) Экспорт 
	Если Результат <> Неопределено И ТипЗнч(Результат) = Тип("Строка") Тогда
		Этаформа.Алгоритм = Результат; 
		ЗаполнитьФормуПоПараметрамАлгоритма(); 
		ИзменитьМодифицированность(Истина);
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте 
Процедура ПараметрыБлокаВСтруктуре(ПараметрыАлгоритма)
    ПараметрыАлгоритма = ПолучитьПараметрыАлгоритма(ПараметрыАлгоритма);
    Если ТипЗнч(ПараметрыАлгоритма) = Тип("Соответствие") Тогда
        Если ПараметрыАлгоритма.Получить("ЭтоСинхронизация") = Истина Тогда
            ВидимостьОбъектовСинхронизации(Истина);
            Этаформа.НазваниеПланаОбмена = ПараметрыАлгоритма.Получить("ПланОбмена");
            ЗаполнитьДеревоНастроек();
        Иначе
            ВидимостьОбъектовСинхронизации(Ложь);
        КонецЕсли;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидимостьОбъектовСинхронизации(Видимость)
    ЭлемФормы = ПолучитьЭлементыФормы();
    ВидимостьГруппаОбъектыОбмена(Видимость);
    Этаформа.ЭтоСинхронизация = Видимость;
    ЭлемФормы.ГруппаПараметрыФильтры.Видимость = Видимость;     
    ВидимостьГруппаИсторияОбмена(Видимость);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыСинхронизации(ПараметрыАлгоритма)
    Если get_prop(ПараметрыАлгоритма, "extsys_objects") = Неопределено Тогда
        ВидимостьОбъектовСинхронизации(Ложь);  
        Возврат;
    КонецЕсли;    
    ВидимостьОбъектовСинхронизации(Истина);
    ЗаполнитьДеревоНастроек();
КонецПроцедуры    

&НаКлиенте
Процедура ЗаполнитьМеткиБрокера(ПараметрАлгоритма)
    LastEventEdo = get_prop(ПараметрАлгоритма, "LastEventEdo");
    Если LastEventEdo = Неопределено Тогда
        LastEventEdo = get_prop(ПараметрАлгоритма, "BrokerMarkEdo");
        LastEventEdo = get_prop(LastEventEdo, "edo");
    КонецЕсли;
    Если LastEventEdo <> Неопределено Тогда
        Попытка 
            ЭтаФорма["Param_LastEventEdo"] = get_prop(LastEventEdo, "datetime"); 
        Исключение
            Возврат;
        КонецПопытки;
    КонецЕсли;    
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыАлгоритмаСПодключения()  
        
    Data = local_helper_json_decode(dataСтрокой);  
    public_params = get_prop(Data, "public_params", Новый Соответствие);
	Для Каждого ПараметрАлгоритма Из public_params Цикл
        ИмяПараметра = ПараметрАлгоритма.Ключ;
        Если ИмяПараметра = "last_event" Тогда 
            ЗаполнитьМеткиБрокера(ПараметрАлгоритма.Значение); 
            Продолжить;
        КонецЕсли;
        Попытка 
            ЭтаФорма["Param_" + ИмяПараметра] = ПараметрАлгоритма.Значение;
        Исключение
            Продолжить;
        КонецПопытки;    
    КонецЦикла;    
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьФормуПоПараметрамАлгоритма()
    ПараметрыВызова    = Новый Соответствие(); 
    ПараметрыВызова.Вставить("params",            context_params );
    ПараметрыВызова.Вставить("ConnectionId",    РеквизитИдентификаторПодключения());
    ПараметрыВызова.Вставить("CommandsResult",    Новый Массив);
    ПараметрыВызова.Вставить("Endpoint",        "info");
    ПараметрыВызова.Вставить("Algorithm",        Алгоритм);
    ПараметрыВызова.Вставить("object",            Новый Структура());
    ПараметрыАлгоритма = BlocklyExecutor.API_BLOCKLY_RUN(ПараметрыВызова);
	ПараметрыАлгоритмаРезультат = get_prop(ПараметрыАлгоритма, "Result");
// ПараметрыАлгоритма.Result["Params"]
	Если ЗначениеЗаполнено(get_prop(ПараметрыАлгоритмаРезультат, "Params")) Тогда
        ПараметрыБлокаВСтруктуре(ПараметрыАлгоритма); // Для совместимости со старым исполнением
        Возврат;
    КонецЕсли; 
    ВидимостьОбъектовСинхронизации(Ложь); 
    ЭтаФорма.РеквизитыПараметров = "";
	РезультатПарамс = get_prop(ПараметрыАлгоритмаРезультат, "params", Новый Массив);
    Для Каждого ПараметрАлгоритма Из РезультатПарамс Цикл
        ИмяПараметра = get_prop(ПараметрАлгоритма, "name"); 
        Если ИмяПараметра = "extsys_objects" Тогда
            ВидимостьОбъектовСинхронизации(Истина);
            Продолжить;
        КонецЕсли;     
        Если НЕ ПустаяСтрока(ЭтаФорма.РеквизитыПараметров) Тогда
            ЭтаФорма.РеквизитыПараметров = ЭтаФорма.РеквизитыПараметров + ",";   
        КонецЕсли;   
        ЭтаФорма.РеквизитыПараметров = ЭтаФорма.РеквизитыПараметров + ИмяПараметра;
	КонецЦикла;
	Если РезультатПарамс.Количество() > 0 Тогда
	    СоздатьЭлементыПараметровАлгоритма(РезультатПарамс);
	    ЗаполнитьПараметрыАлгоритмаСПодключения();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыАлгоритма(Знач ПараметрыАлгоритма)
	МодульОбъекта = МодульОбъекта();
	ИнтерфейсныеПараметры = Новый Соответствие;
	Записьsyncobj = МодульОбъекта.BlocklyGetInfoParams(ПараметрыАлгоритма.Result, "type", "syncobj");
	ЗаписьПланОбмена = МодульОбъекта.BlocklyGetInfoParams(ПараметрыАлгоритма.Result, "name", "ПланОбмена");
	Если Записьsyncobj <> Неопределено Тогда
		ИнтерфейсныеПараметры.Вставить("ЭтоСинхронизация", Истина);
		Если ЗаписьПланОбмена <> Неопределено Тогда 
			ИнтерфейсныеПараметры.Вставить("ПланОбмена", ЗаписьПланОбмена.Получить("default"));
		КонецЕсли;	
	Иначе
		ИнтерфейсныеПараметры.Вставить("ЭтоСинхронизация", Ложь);
	КонецЕсли;	
		
	Возврат ИнтерфейсныеПараметры;
КонецФункции

&НаКлиенте
Процедура ОбновитьОтображениеОграничениеВремени() 
	ВидимостьГруппаВремяЗапуска(ЛОЖЬ);	
	ВидимостьГруппаБезОграничений(ЛОЖЬ);
	ВидимостьГруппаРазВДень(ЛОЖЬ);
	Если ПериодичностьДня = "24:00" Тогда
		ВидимостьГруппаРазВДень(ИСТИНА);
	Иначе	
		ВидимостьГруппаВремяЗапуска(НЕ БезОграниченийВремени);	
		ВидимостьГруппаБезОграничений(БезОграниченийВремени);
	КонецЕсли;		
КонецПроцедуры
	

&НаКлиенте
Процедура ЗаполнитьАвтоматическийЗапуск() 
	Если Периодичность = 1 Тогда
		ВидимостьГруппаАвтоЗапускаДниНедели(Ложь);
	Иначе
		ВидимостьГруппаАвтоЗапускаДниНедели(Истина)
	КонецЕсли;	
	ОтобразитьЦветКнопкиДняНедели("Пн", ЭтаФорма["Пн"]);
	ОтобразитьЦветКнопкиДняНедели("Вт", ЭтаФорма["Вт"]);
	ОтобразитьЦветКнопкиДняНедели("Ср", ЭтаФорма["Ср"]);
	ОтобразитьЦветКнопкиДняНедели("Чт", ЭтаФорма["Чт"]);
	ОтобразитьЦветКнопкиДняНедели("Пт", ЭтаФорма["Пт"]);
	ОтобразитьЦветКнопкиДняНедели("Сб", ЭтаФорма["Сб"]);
	ОтобразитьЦветКнопкиДняНедели("Вс", ЭтаФорма["Вс"]);
	ОбновитьАвтозапуск();	
КонецПроцедуры

&НаСервере
Функция МассивПоДнямНедели(ВсеДни = ЛОЖЬ) 
	Массив = Новый Массив(); 
	Если Пн ИЛИ ВсеДни Тогда Массив.Добавить("1"); КонецЕсли; 
	Если Вт ИЛИ ВсеДни Тогда Массив.Добавить("2"); КонецЕсли; 
	Если Ср ИЛИ ВсеДни Тогда Массив.Добавить("3"); КонецЕсли; 
	Если Чт ИЛИ ВсеДни Тогда Массив.Добавить("4"); КонецЕсли; 
	Если Пт ИЛИ ВсеДни Тогда Массив.Добавить("5"); КонецЕсли; 
	Если Сб ИЛИ ВсеДни Тогда Массив.Добавить("6"); КонецЕсли; 
	Если Вс ИЛИ ВсеДни Тогда Массив.Добавить("7"); КонецЕсли; 
	Возврат Массив;
КонецФункции	

&НаКлиенте
Функция МеткиБрокера()  
    МассивМетокБрокера = Новый Массив;
    МассивМетокБрокера.Добавить("LastEventEdo");
    Возврат МассивМетокБрокера;
КонецФункции    


&НаКлиенте
Процедура СохранитьПараметрыАлгоритмаВПодключение(public_params)
    МеткиБрокераМассив = МеткиБрокера();
    МассивПареметровАлгоритма = СтрРазделить82(ЭтаФорма.РеквизитыПараметров, ",");
    public_params_last_event = get_prop(public_params, "last_event", Новый Соответствие);  
    ПрефиксПараметра = "Param_";
    Для Каждого ИмяПараметраАлгоритма Из МассивПареметровАлгоритма Цикл
		Если Не ЗначениеЗаполнено(ИмяПараметраАлгоритма) Тогда
			Продолжить;
		КонецЕсли;
        Если МеткиБрокераМассив.Найти(ИмяПараметраАлгоритма) <> Неопределено Тогда 
            public_params_last_event = get_prop(public_params, "last_event", Новый Соответствие);
            Если ИмяПараметраАлгоритма = "LastEventEdo" Тогда
                public_params_last_event.Удалить("BrokerMarkEdo");
                LastEventEdo = Новый Соответствие;
                LastEventEdo.Вставить("datetime", ЭтаФорма[ПрефиксПараметра + ИмяПараметраАлгоритма]);
                LastEventEdo.Вставить("id", Неопределено);
                LastEventEdo.Вставить("doc_id", Неопределено);
				public_params_last_event.Вставить("LastEventEdo", LastEventEdo);
            КонецЕсли;
            Продолжить;
        КонецЕсли;
        public_params.Вставить(ИмяПараметраАлгоритма, ЭтаФорма[ПрефиксПараметра + ИмяПараметраАлгоритма]);
    КонецЦикла;
    Если public_params_last_event.Количество() > 0 Тогда 
        public_params.Вставить("last_event", public_params_last_event);    
    КонецЕсли;    
КонецПроцедуры

&НаКлиенте
Функция СоответствиеData() 
	НачальнаяДатаВремя = Дата(1, 1, 1, 0, 0, 0);
	connectionParam = Новый Соответствие;
	Если ЭтаФорма.БезОграниченийВремени Тогда 
		ВремяНачала = НачальнаяДатаВремя;	
		ВремяОкончания = КонецДня(НачальнаяДатаВремя);	
	КонецЕсли;	
	connectionParam.Вставить("PeriodicityType", Периодичность);
	connectionParam.Вставить("RepeatTime", 		ПериодичностьДня);
	connectionParam.Вставить("DaysSelect", 		МассивПоДнямНедели(Периодичность = 1));
	connectionParam.Вставить("StartTime", 		Формат(ВремяНачала,"ДФ=ЧЧ:мм")); 
	Если ВремяНачала = НачальнаяДатаВремя Тогда 
		connectionParam.Вставить("StartTime", 		"00:00");
	КонецЕсли;	
	Если ПериодичностьДня = "24:00" Тогда 
		connectionParam.Вставить("EndTime", 	"");
	Иначе
		connectionParam.Вставить("EndTime", 	Формат(ВремяОкончания,"ДФ=ЧЧ:мм"));
	КонецЕсли;
	Data = ТранспортИнтеграции.local_helper_json_decode(dataСтрокой);
	Data.Вставить("connectionParam",	connectionParam);
	Data.Вставить("isRobot",	Истина);
	Если Алгоритм <> "<выберите алгоритм>" Тогда
		Data.Вставить("OperationType",	"Blockly");
		Data.Вставить("OperationId",	Алгоритм);
	Иначе 
		Data.Удалить("OperationId");
	КонецЕсли;               
	Data.Вставить("Endpoint",	endpoint);
	NDate = "";
	Если Автозапуск = Истина Тогда 
		NDate = ПересчитатьДатуСледующегоЗапуска();	
	КонецЕсли;	
	Data.Вставить("NDate",	NDate);
	Filter = ПодготовитьФильтр();
	public_params = get_prop(Data, "public_params", Новый Структура);
	СохранитьПараметрыАлгоритмаВПодключение(public_params);
	public_params.Вставить("Filter", Filter);
	Data.Вставить("public_params", public_params);
	Data.Вставить("Filter", Неопределено);
	dataСтрокой = ТранспортИнтеграции.local_helper_json_encode(Data);	
	Возврат Data;
КонецФункции

