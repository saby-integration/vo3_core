&НаКлиенте
Перем ТранспортИнтеграции Экспорт; 

&НаКлиенте
Перем BlocklyExecutor Экспорт;
// BSLLS:ExportVariables-on 

#Область ОписаниеПеременных

#КонецОбласти

#Область include_core_base_Helpers_ПоказатьОповещениеПользователя
#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	МодульОбъекта = МодульОбъекта(); 
    ЗаполнитьПараметрыОкнаПоУмолчанию();
	Если Параметры <> Неопределено Тогда 
		ЭтаФорма.Сервис = get_prop(Параметры, "Сервис", "Dom1C");	
		ЭтаФорма.Версия = get_prop(Параметры, "Версия", ВерсияМетаданных());	
		ЭтаФорма.Подсистема = get_prop(Параметры, "Подсистема", ""); 	
		ЭтаФорма.context_params = get_prop(Параметры, "context_param", Неопределено);
		// ConnectionId -  Кладем сюда ид коннекшина робота
		ЭтаФорма.ИдентификаторПодключения = get_prop(Параметры, "Идентификатор", ""); 	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ТранспортИнтеграции = ПолучитьФормуТранспорта(context_params);
	BlocklyExecutor = ПолучитьФормуBlockly(ЭтаФорма);
	
	ЗаполнитьРеквизитыПоОперации();
	Если Не ЗначениеЗаполнено(ЭтаФорма.ИдентификаторПодключения) Тогда
		ЗаполнитьПараметрыОкнаПоУмолчанию();
	КонецЕсли; 
	ОбновитьАвтозапуск(); 
	ЗаполнитьИсториюОбмена();
	ЭтаФорма.ШрифтНеактивногоЭлемента = WebЦвета.Черный;
	ЭтаФорма.ШрифтАктивногоЭлемента = WebЦвета.Зеленый;
	ЭтоВнешняяОбработка = ЭтоВнешняяОбработка();
	Если ЭтоВнешняяОбработка Тогда
		ЭтаФорма.ИмяОбработки = ИмяФайлаОбработки();
	Иначе
		ЭтаФорма.ИмяОбработки = ИмяОбработки();
	КонецЕсли;
	Если ЭтаФорма.Алгоритм <> "<выберите алгоритм>" Тогда 
		ЗаполнитьФормуПоПараметрамАлгоритма();           
	КонецЕсли;
	ЗаполнитьАвтоматическийЗапуск();  
	ОбновитьОтображениеОграничениеВремени();
	ЭтаФорма.Заголовок = ИмяФормы();
	ПодсказкаКопировать();
	ДанныеФильтра = Новый Структура("ПараметрыОтображения, Значения");
	ЗаполнитьФильтрыПодключения(); 
	ДанныеФильтра.Вставить("Значения", ЗначенияФильтровПодключения());
	ОбновитьПанельФильтра();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФильтрыПодключения() 
	ПараметрыОтображения = get_prop(ДанныеФильтра, "ПараметрыОтображения");
	Если ПараметрыОтображения = Неопределено Тогда
		Результат = ТранспортИнтеграции.local_helper_api3_calc_objects_filter(context_params, РеквизитИдентификаторПодключения(), "Blockly");
		ПараметрыОтображения = Новый Массив;	
		Если ТипЗнч(Результат) = Тип("Соответствие") Тогда
			Для Каждого Запись Из Результат Цикл
				ПараметрыОтображения.Добавить(Запись.Значение);
			КонецЦикла;	
		КонецЕсли;  
		ДанныеФильтра.Вставить("ПараметрыОтображения", ПараметрыОтображения);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция СписокЗначенийФильтраИзМассива(МассивЗначенийФильтра)
	МодульОбъекта = МодульОбъекта(); 
	СписокЗначений = Новый СписокЗначений;
	Для Каждого Запись Из МассивЗначенийФильтра Цикл
		ЗначениеСписка = Запись;
		Если ТипЗнч(ЗначениеСписка) = Тип("Соответствие") Тогда 
			ИмяИС = get_prop(ЗначениеСписка, "ИмяИС"); 
			ИдИС = get_prop(ЗначениеСписка, "ИдИС"); 
			ЗначениеСписка = МодульОбъекта.ПолучитьСсылкуПоИдИС(ИмяИС, ИдИС);
		КонецЕсли;
		СписокЗначений.Добавить(ЗначениеСписка, Строка(ЗначениеСписка));
	КонецЦикла;
	Возврат СписокЗначений;
КонецФункции

&НаСервере
Функция ФильтрУжеЕсть(ФильтрЗначения, ИмяФильтра)
	Для Каждого КлючЗначение Из ФильтрЗначения Цикл
		Если КлючЗначение["Ключ"] = ИмяФильтра Тогда 
			Возврат Истина;
		КонецЕсли;	
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ПереложитьФильтрыToFrom(ФильтрЗначения)
	Отступ3 = 3;
	Отступ5 = 5;
	МассивКлючейToFrom = Новый Массив;
	Для Каждого ЗаписьФильтр Из ФильтрЗначения Цикл
		Если Прав(ЗаписьФильтр.Ключ, Отступ3) = "_To" Или Прав(ЗаписьФильтр.Ключ, Отступ5) = "_From" Тогда  
			МассивКлючейToFrom.Добавить(ЗаписьФильтр.Ключ);	
		КонецЕсли;
	КонецЦикла;	
	Для Каждого КлючToFrom Из МассивКлючейToFrom Цикл
		ИмяФильтра = "";
		ЗначениеФильтра = Неопределено;
		Если Прав(КлючToFrom, Отступ3) = "_To" Тогда 
			ИмяФильтра = Лев(КлючToFrom, СтрДлина(КлючToFrom) - Отступ3) + "Кнц";
			ЗначениеФильтра = get_prop(ФильтрЗначения, КлючToFrom);
		КонецЕсли;
		Если Прав(КлючToFrom, Отступ5) = "_From" Тогда
			ИмяФильтра = Лев(КлючToFrom, СтрДлина(КлючToFrom) - Отступ5) + "Нач";
			ЗначениеФильтра = get_prop(ФильтрЗначения, КлючToFrom);
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяФильтра) И ФильтрУжеЕсть(ФильтрЗначения, ИмяФильтра) = Ложь Тогда
			ФильтрЗначения.Вставить(ИмяФильтра, ЗначениеФильтра);	
		КонецЕсли;
		ФильтрЗначения.Вставить(КлючToFrom, Неопределено);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ДополнитьФильтрамиПоУмолчанию(ФильтрЗначения) 
	Для Каждого Поле Из ДанныеФильтра.ПараметрыОтображения Цикл
    	Name = get_prop(Поле, "NAME", get_prop(Поле, "Name"));
		Если get_prop(ФильтрЗначения, Name) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	   
		TEMPLATE = get_prop(Поле, "TEMPLATE", Неопределено);
		Если TEMPLATE <> "filter_period" Тогда  
			ФильтрЗначения.Вставить(Name, Неопределено);	
		    Продолжить;
		КонецЕсли;
		Если get_prop(ФильтрЗначения, Name+"Нач",Неопределено) = Неопределено Тогда
			ФильтрЗначения.Вставить(Name+"Нач", Неопределено);
		КонецЕсли;
		Если get_prop(ФильтрЗначения, Name+"Кнц",Неопределено) = Неопределено  Тогда
			ФильтрЗначения.Вставить(Name+"Кнц", Неопределено);
		КонецЕсли;
		Если get_prop(ФильтрЗначения, Name+"Период",Неопределено) = Неопределено  Тогда
			ФильтрЗначения.Вставить(Name+"Период", Неопределено);
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФильтрЗначения(ФильтрЗначения)
	МодульОбъекта = МодульОбъекта(); 
	ЭтоНовоеПодключение = Не ЗначениеЗаполнено(ЭтаФорма.ИдентификаторПодключения);
	Если Не ЭтоНовоеПодключение Тогда 
		Data = МодульОбъекта.local_helper_json_decode(dataСтрокой);  
		ФильтрЗначения = Data.Получить("Filter"); 
		Если ФильтрЗначения = Неопределено Тогда 
			public_params =  get_prop(Data, "public_params", Неопределено);
			ФильтрЗначения = get_prop(public_params, "Filter", Неопределено);	
		КонецЕсли;
	КонецЕсли;	
	Если ФильтрЗначения = Неопределено Тогда
		ФильтрЗначения = Новый Структура;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗначенияФильтровПодключения()
	МодульОбъекта = МодульОбъекта(); 
	ФильтрЗначения = Новый Структура;
	ЗаполнитьФильтрЗначения(ФильтрЗначения);
	
	// Убрать после 26.1100
	ПереложитьФильтрыToFrom(ФильтрЗначения);

	Для Каждого ЗаписьФильтр Из ФильтрЗначения Цикл
		Отступ3 = 3;
		Отступ5 = 5;
		
		Если Прав(ЗаписьФильтр.Ключ, Отступ3) = "Нач" Или Прав(ЗаписьФильтр.Ключ, Отступ3) = "Кнц" Тогда  
			ФильтрЗначения[ЗаписьФильтр.Ключ] = МодульОбъекта.ПреобразоватьСтрокуВДату("yyyy-MM-dd", ЗаписьФильтр.Значение);
		ИначеЕсли get_prop(ЗаписьФильтр.Значение, "Api3Link") <> Неопределено Тогда 
			Api3Link = get_prop(ЗаписьФильтр.Значение, "Api3Link");
			ИмяИС = get_prop(Api3Link, "ИмяИС"); 
			ТипИС = get_prop(Api3Link, "ТипИС");   
			Если  ЗначениеЗаполнено(ТипИС) Тогда
				ИмяИС = ТипИС + "." + ИмяИС;
			КонецЕсли;
			ИдИС = get_prop(Api3Link, "ИдИС"); 
			ФильтрЗначения[ЗаписьФильтр.Ключ] = МодульОбъекта.ПолучитьСсылкуПоИдИС(ИмяИС, ИдИС);
		ИначеЕсли ТипЗнч(ЗаписьФильтр.Значение) = Тип("Соответствие") Тогда
			ИмяИС = get_prop(ЗаписьФильтр.Значение, "ИмяИС"); 
			ИдИС = get_prop(ЗаписьФильтр.Значение, "ИдИС");
			Попытка
				ФильтрЗначения[ЗаписьФильтр.Ключ] = МодульОбъекта.ПолучитьСсылкуПоИдИС(ИмяИС, ИдИС);
			Исключение
				Продолжить;
			КонецПопытки;	
		ИначеЕсли ТипЗнч(ЗаписьФильтр.Значение) = Тип("Массив") Тогда 	
			ФильтрЗначения[ЗаписьФильтр.Ключ] = СписокЗначенийФильтраИзМассива(ЗаписьФильтр.Значение);
		Иначе
			Продолжить;
		КонецЕсли;	
	КонецЦикла;	
	ДополнитьФильтрамиПоУмолчанию(ФильтрЗначения);
	Возврат ФильтрЗначения;
КонецФункции

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не ЗавершениеРаботы И Модифицированность = Истина Тогда
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
		ОповещениеПослеВыбораОтветаПередЗакрытием = Новый ОписаниеОповещения("ПослеВыбораОтветаПередЗакрытием",ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");	
		ПоказатьВопрос(ОповещениеПослеВыбораОтветаПередЗакрытием, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "SabySignOut" Тогда
		Закрыть();	
	ИначеЕсли ИмяСобытия = "ПослеВыполненияАлгоритма" Тогда
		ПослеВыполненияАлгоритма(Неопределено,Неопределено);
	Иначе
		Возврат;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодичностьПриИзменении(Элемент)
	ЗаполнитьАвтоматическийЗапуск();
	ПересчитатьДатуСледующегоЗапуска();
	ИзменитьМодифицированность(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьДняПриИзменении(Элемент)
	ОбновитьОтображениеОграничениеВремени();
	ПересчитатьДатуСледующегоЗапуска();
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияУбратьОграничениеВремениНажатие(Элемент)
	ЭтаФорма.БезОграниченийВремени = Истина;
	ОбновитьОтображениеОграничениеВремени();
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПодключенияПриИзменении(Элемент)
	ЭтаФорма.Заголовок = ИмяФормы();
	ИзменитьМодифицированность(Истина);
КонецПроцедуры  

&НаКлиенте
Процедура Пн(Команда)
	ЭтаФорма[Команда.Имя] = НЕ ЭтаФорма[Команда.Имя];  
	ОтобразитьЦветКнопкиДняНедели(Команда.Имя, ЭтаФорма[Команда.Имя]);
	ПересчитатьДатуСледующегоЗапуска();
	ИзменитьМодифицированность(Истина);
КонецПроцедуры

&НаКлиенте
Процедура АлгоритмНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;   
	ПараметрыПередачи = Новый Структура("Идентификатор,Версия,context_param", РеквизитИдентификаторПодключения(), Версия, context_params);
	ОписаниеЗакрытиеОкна = Новый ОписаниеОповещения("ПослеВыбораАлгоритма", ЭтаФорма);
	Попытка   
		ОткрытьФормуОбработки("РоботВыборАлгоритма", ПараметрыПередачи, ЭтаФорма, , ОписаниеЗакрытиеОкна);
	Исключение  
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = ExtExceptionAnalyse(ИнфОбОшибке);
		Если ОшибкаСтруктура <> Неопределено Тогда
			ТекстОшибки = ExtExceptionToMessage(ОшибкаСтруктура); 
			ПоказатьСкрытьОшибкуПолученияДанных(Истина, ТекстОшибки);
		КонецЕсли;	
	КонецПопытки;	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояниеРобота(ПараметрыВызова, РезультатВыполнения) 
    ПересчитатьДатуСледующегоЗапуска();
    
    СтатусОбмена = 100;    
    
    Если РезультатВыполнения.Status = "error" Тогда
        СтатусОбмена = 101;
    ИначеЕсли РезультатВыполнения.Свойство("data") Тогда 
        data = РезультатВыполнения.data;  
        CountError = data.Получить(CountError);
        Если CountError<> Неопределено 
            И CountError <> 0 Тогда
            СтатусОбмена = 101;    
        КонецЕсли;
    Иначе
        СтатусОбмена = 100;        
    КонецЕсли;
        
    props = Новый Структура;
    props.Вставить("id",        ПараметрыВызова.Получить("ConnectionUuid"));
    props.Вставить("NextRun",    УниверсальноеВремяСтрокой(ДатаВремяСледующегоЗапуска));
    // BSLLS:DeprecatedCurrentDate-off ВызовНаКлиенте
    props.Вставить("LastRun",    УниверсальноеВремяСтрокой(ТекущаяДата()));
    // BSLLS:DeprecatedCurrentDate-on
    props.Вставить("StatusID",    СтатусОбмена);
    МассивINI = Новый Массив;
    params = Новый Структура("props,ini", Props, МассивINI);
    
    ТранспортИнтеграции.local_helper_integration_api(context_params, "IntegrationConnection.WriteConnection", params, "int-settings");
КонецПроцедуры

&НаКлиенте
Процедура ЗапускНаКлиенте()
	Data = local_helper_json_decode(dataСтрокой);
	СтруктураСоединения = Новый Структура;
	СтруктураСоединения.Вставить("connection_uuid", ЭтаФорма.ИдентификаторПодключения);
	СтруктураСоединения.Вставить("operation_uuid",  Неопределено);
	СтруктураСоединения.Вставить("isRobot", 		Истина);
	context_params.Вставить("operation", СтруктураСоединения);
	
	ПараметрыВызова	= Новый Соответствие(); 
	ПараметрыВызова.Вставить("ContextId", 		Неопределено);
	ПараметрыВызова.Вставить("ConnectionId",	ЭтаФорма.ИдентификаторПодключения);
	ПараметрыВызова.Вставить("params",			context_params );
	ПараметрыВызова.Вставить("CommandsResult",	Новый Массив);
	ПараметрыВызова.Вставить("Endpoint",		get_prop(Data, "Endpoint",""));
	ПараметрыВызова.Вставить("Algorithm",		get_prop(Data, "OperationId"));
	ПараметрыВызова.Вставить("object",			Новый Структура());
	ПараметрыВызова.Вставить("isRobot", 		Истина);
	ПараметрыВызова.Вставить("Data", 			Data);
    РезультатВыполнения = BlocklyExecutor.API_BLOCKLY_RUN(ПараметрыВызова);
    ОбновитьСостояниеРобота(ПараметрыВызова, РезультатВыполнения);
КонецПроцедуры

&НаКлиенте
Процедура ФиксацияНачалаОбмена()
    ПараметрыВызова = Новый Структура("Direction", 1);
    Попытка
		param = Новый Структура("ConnectionId, ExtSyncDoc, ExtSyncObj", 
			ЭтаФорма.ИдентификаторПодключения, 
			ПараметрыВызова, 
			Неопределено);
		params = Новый Структура("param", param);
		ТранспортИнтеграции.local_helper_integration_api(context_params, "ExtSyncDoc.Write", params, "integration-sync");
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ВызватьИсключение(NewExtExceptionСтрока(ИнфОбОшибке));		
	КонецПопытки;        
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)  
	Если НаименованиеПодключения = "" Тогда 
		СтрокаСообщения = НСтр("ru = 'Необходимо заполнить наименование подключения';");		
		СоощениеПользователю = Новый СообщениеПользователю;
		СоощениеПользователю.ПутьКДанным = "НаименованиеПодключения";
		СоощениеПользователю.Текст = СтрокаСообщения;
		СоощениеПользователю.Сообщить();
	КонецЕсли; 
	
	Если Алгоритм = "<выберите алгоритм>" Тогда 
		СтрокаСообщения = НСтр("ru = 'Необходимо заполнить алгоритм';");		
		СоощениеПользователю = Новый СообщениеПользователю;
		СоощениеПользователю.ПутьКДанным = "Алгоритм";
		СоощениеПользователю.Текст = СтрокаСообщения;
		СоощениеПользователю.Сообщить();
	КонецЕсли;

	Попытка
		СохранитьПодключение();
		ИзменитьМодифицированность(Ложь); 
		ПоказатьСкрытьОшибкуПолученияДанных(Ложь, ""); 
		
		СтрокаСообщения = НСтр("ru = 'Автоматическая операция успешно сохранена';");		
		СоощениеПользователю = Новый СообщениеПользователю;
		СоощениеПользователю.Текст = СтрокаСообщения;
		СоощениеПользователю.Сообщить();
	Исключение  
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = ExtExceptionAnalyse(ИнфОбОшибке);
		Если ОшибкаСтруктура <> Неопределено Тогда
			ТекстОшибки = ExtExceptionToMessage(ОшибкаСтруктура); 
			ПоказатьСкрытьОшибкуПолученияДанных(Истина, ТекстОшибки);
		КонецЕсли;	
	КонецПопытки;	
КонецПроцедуры

&НаКлиенте
Процедура Редактировать(Команда)
	Если Алгоритм <> "<выберите алгоритм>" Тогда   
		НазваниеАлгоритма = КодироватьСтрокуНаСервере(Алгоритм);
		ПараметрыФормы = Новый Структура;
		АдресСтраницы = context_params.ApiUrl;
		connector = КоннекторLPP(context_params);
		АдресСтраницы = АдресСтраницы + "/blockly_editor_1c2/page/?connection_id=";
		АдресСтраницы = АдресСтраницы + ЭтаФорма.ИдентификаторПодключения;
		АдресСтраницы = АдресСтраницы + "&connector=" + connector + "&command=" + connector + "&algorithm=";
		АдресСтраницы = АдресСтраницы + НазваниеАлгоритма;
		ПараметрыФормы.Вставить("Заголовок", "Редактор файлов настроек");
		ПараметрыФормы.Вставить("АдресСтраницы", АдресСтраницы);
        ОткрытьФормуОбработки("Browser", ПараметрыФормы, Этаформа.ВладелецФормы);
	Иначе
		СтрокаСообщения = НСтр("ru = 'Не указан алгоритм';");		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрокаСообщения;
		Сообщение.Поле = "Алгоритм";
		Сообщение.Сообщить();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура Запуск(Команда)
	Если ИдетПроцессВыполнения = Истина Тогда
		Возврат;
	КонецЕсли;	
	
	Если Модифицированность = Истина Тогда  
		ПослеВыбораСохраненияАлгоритма = Новый ОписаниеОповещения("ПослеВыбораСохраненияАлгоритма", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'Перед выполнением алгоритма необходимо сохранить настройки';");
		ПоказатьВопрос(ПослеВыбораСохраненияАлгоритма, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена,,КодВозвратаДиалога.Да);
	Иначе
		ЗапускАлгоритма();
	КонецЕсли;
	
КонецПроцедуры

