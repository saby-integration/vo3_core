&НаКлиенте
Функция ЗаписатьПодключение(ЭтоНовоеПодключение) 
	МассивINI = Новый Массив;
	props = Новый Структура;
	props.Вставить("id"					,ЭтаФорма.ИдентификаторПодключения);
	props.Вставить("service"           	,"Dom1C");
	props.Вставить("subsystem"			,Подсистема);
	props.Вставить("version"			,ВерсияМетаданных());
	props.Вставить("name_connection"	,НаименованиеПодключения);
	props.Вставить("for_all"			,Ложь);			
	props.Вставить("auto_update"		,Ложь);
	// BSLLS:DeprecatedCurrentDate-off Для использования на клиенте
	props.Вставить("update_date"		,УниверсальноеВремяСтрокой(ТекущаяДата()));
	// BSLLS:DeprecatedCurrentDate-on
	props.Вставить("Data"				,СоответствиеData());
	props.Вставить("sync"				,Автозапуск);
	props.Вставить("parent"				,parent);
	props.Вставить("SystemId"			,"");
	props.Вставить("Connector"			,"Robot1C");
	props.Вставить("ProductId"			,"robot_blockly_1c");
	NextRun = ПересчитатьДатуСледующегоЗапуска();
	NextRun = УниверсальноеВремяСтрокой(NextRun);
	Если Автозапуск = Истина Тогда
		props.Вставить("NextRun"			,NextRun);
	Иначе
		props.Вставить("NextRun"			,Неопределено);
	КонецЕсли;
	props.Вставить("StatusID"			,100);
	ЗаписатьСвойствоParentНаСервере(parent);
	params = Новый Структура("props,ini", Props, МассивINI); 
	res = ТранспортИнтеграции.local_helper_write_connection(context_params, params);
	Возврат res;
КонецФункции

&НаСервере
Процедура ЗаполнитьПериодДействия(connectionParam)
	Если connectionParam.Получить("StartTime") <> Неопределено Тогда
		ЭтаФорма.ВремяНачала = "01.01.01 " + connectionParam["StartTime"] + ":00";
	КонецЕсли;
	Если connectionParam.Получить("EndTime") <> Неопределено Тогда
		ЭтаФорма.ВремяОкончания = "01.01.01 " + connectionParam["EndTime"] + ":00";
	КонецЕсли;
	НачальнаяДатаВремя = Дата(1, 1, 1, 0, 0, 0);	
	Секунды59 = 59;
	Если ЭтаФорма.ВремяНачала = НачальнаяДатаВремя 
		И ЭтаФорма.ВремяОкончания = КонецДня(НачальнаяДатаВремя) - Секунды59 Тогда  
		ЭтаФорма.БезОграниченийВремени = Истина;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьconnectionParam(Data)
	connectionParam = get_prop(Data, "connectionParam", Неопределено); 
	Если ТипЗнч(connectionParam) <> Тип("Соответствие") Тогда 
		Возврат;
	КонецЕсли;	
	Периодичность = get_prop(connectionParam, "PeriodicityType", Периодичность);
	ПериодичностьДня = get_prop(connectionParam, "RepeatTime", ПериодичностьДня);
	ЗаполнитьПериодДействия(connectionParam);
	ВидимостьГруппаАвтоЗапускаДниНедели(Периодичность = 1);
	МассивПоДнямНедели = connectionParam.Получить("DaysSelect");	
	Если ТипЗНч(МассивПоДнямНедели) <> Тип("Массив") Тогда 
		Возврат;
	КонецЕсли;	
	Этаформа.Пн = Ложь; Этаформа.Вт = Ложь; Этаформа.Ср = Ложь; 
	Этаформа.Чт = Ложь; Этаформа.Пт = Ложь; Этаформа.Сб = Ложь; Этаформа.Вс = Ложь;
	Для Каждого Запись ИЗ МассивПоДнямНедели Цикл 
		Если Запись = "1" Тогда Этаформа.Пн = Истина 
		ИначеЕсли Запись = "2" Тогда Этаформа.Вт = Истина	
		ИначеЕсли Запись = "3" Тогда Этаформа.Ср = Истина	
		ИначеЕсли Запись = "4" Тогда Этаформа.Чт = Истина	
		ИначеЕсли Запись = "5" Тогда Этаформа.Пт = Истина	
		ИначеЕсли Запись = "6" Тогда Этаформа.Сб = Истина	
		Иначе Этаформа.Вс = Истина
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиData(Data)  
	ЗаполнитьconnectionParam(Data);	
	Если Data.Получить("OperationId") <> Неопределено Тогда
		Этаформа.Алгоритм = Data["OperationId"];
	КонецЕсли;	
	Этаформа.endpoint = get_prop(Data, "Endpoint", "");
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыПоОперации()
	МассивИНИ = Неопределено;
	ПараметрыОперации = Новый Структура("id,Версия,INI", РеквизитИдентификаторПодключения(), Версия, МассивИНИ); 
    АвтоматическаяОперация = ТранспортИнтеграции.local_helper_read_connection(context_params, ПараметрыОперации);
 	ЭтаФорма.parent = АвтоматическаяОперация.Получить("parent");
	ЭтаФорма.Автозапуск = АвтоматическаяОперация.Получить("sync");
	LastRun = АвтоматическаяОперация.Получить("LastRun"); 
	Этаформа.Подсистема = АвтоматическаяОперация.Получить("subsystem");
	Если ЗначениеЗаполнено(LastRun) Тогда
		Этаформа.ДатаВремяПоследнегоЗапуска = ПреобразоватьСтрокуВДатуСЧасовымПоясом(LastRun);
	КонецЕсли;
	NextRun = АвтоматическаяОперация.Получить("NextRun"); 
	Если ЗначениеЗаполнено(NextRun) Тогда
		Этаформа.ДатаВремяСледующегоЗапуска = ПреобразоватьСтрокуВДатуСЧасовымПоясом(NextRun);
	КонецЕсли;
	Статус = get_prop(АвтоматическаяОперация, "StatusID", Неопределено);
	ЭлемФормы = ПолучитьЭлементыФормы();
	Если ЗначениеЗаполнено(Статус) И Статус > 0 И Статус <> 100 Тогда  
		ЭлемФормы.ДекорацияСтатусОшибка.Видимость = Истина;
		ЭлемФормы.ДекорацияСтатусВыполнено.Видимость = ЛОЖЬ;
	Иначе
		ЭлемФормы.ДекорацияСтатусВыполнено.Видимость = Истина;
		ЭлемФормы.ДекорацияСтатусОшибка.Видимость = ЛОЖЬ;
	КонецЕсли;
	Data = АвтоматическаяОперация["Data"]; 
	ЭтаФорма.dataСтрокой = local_helper_json_encode(Data);
	ЗаполнитьНастройкиData(Data);
	ЭтаФорма.НаименованиеПодключения = АвтоматическаяОперация.Получить("name_connection");                                         
	ЗаполнитьДеревоНастроек();

	//ExtSysUid = АвтоматическаяОперация.Получить("SystemId");
КонецПроцедуры

