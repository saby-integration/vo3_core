Функция Api3ObjectНаСервере(Знач СсылкаНаОбъект)
	МодульОбъекта = МодульОбъекта();
	Возврат МодульОбъекта.Api3Object(СсылкаНаОбъект, "",,, Истина);	
КонецФункции

&НаКлиенте
Функция ПодготовитьApi3Object(СсылкаНаОбъект) 
	Api3Object = Api3ObjectНаСервере(СсылкаНаОбъект);
	Api3Object.Вставить("Название", get_prop(Api3Object, "Title"));  
	IntegrationId = get_prop(context_params, "IntegrationId");
	ClientType = get_prop(Api3Object, "ИмяИС");
	ClientId = Новый Массив;
	ClientId.Добавить(get_prop(Api3Object, "ИдИС"));
	МассивОбъектовМаппинга = ТранспортИнтеграции.local_helper_mapping_obj_findbyclientid(context_params, IntegrationId, ClientType, ClientId);
	Если МассивОбъектовМаппинга.Количество() = 0 Тогда
		Возврат Api3Object;		
	КонецЕсли;
	Для Каждого Запись Из МассивОбъектовМаппинга Цикл 
		Статус = get_prop(Запись, "Status");
		Если Статус = 1 Тогда 
			Api3Object.Вставить("ИдСБИС", get_prop(Запись, "SbisId"));	
			Api3Object.Вставить("ИмяСБИС", get_prop(Запись, "SbisType"));
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	Возврат Api3Object;		
КонецФункции

&НаКлиенте
Функция ПодготовитьФильтр()
	ТипыСтрокаЧислоБулево = Новый Массив;
	ТипыСтрокаЧислоБулево.Добавить(Тип("Строка"));
	ТипыСтрокаЧислоБулево.Добавить(Тип("Число"));
	ТипыСтрокаЧислоБулево.Добавить(Тип("Булево"));
	ФильтрПодключения = Новый Соответствие;
	Для Каждого Запись Из ДанныеФильтра.Значения Цикл
		Если НЕ ЗначениеЗаполнено(Запись.Значение) Тогда  
			Значение = Неопределено;
		ИначеЕсли ТипЗнч(Запись.Значение) = Тип("Дата") Тогда
			Значение = Формат(Запись.Значение, "ДФ=гггг-ММ-дд");
		ИначеЕсли ТипЗнч(Запись.Значение) = Тип("СписокЗначений") Тогда
			Значение = Новый Массив;
			Для Каждого ЗаписьМассива Из Запись.Значение Цикл 
				ЗначениеМассива = ЗаписьМассива.Значение;
				Если ТипЗнч(ЗаписьМассива) <> Тип("Строка") Тогда 
					ЗначениеМассива = ПодготовитьApi3Object(ЗаписьМассива.Значение);
				КонецЕсли;
				Значение.Добавить(ЗначениеМассива);
			КонецЦикла;
		ИначеЕсли ТипыСтрокаЧислоБулево.Найти(ТипЗнч(Запись.Значение)) = Неопределено Тогда
			Значение = ПодготовитьApi3Object(Запись.Значение);
		Иначе	
			Значение = Запись.Значение;
		КонецЕсли;
		ФильтрПодключения.Вставить(Запись.Ключ, Значение);
	КонецЦикла;
	Возврат ФильтрПодключения;
КонецФункции

