&НаКлиенте
Процедура СохранитьПодключение() 
	ЭтоНовоеПодключение = Не ЗначениеЗаполнено(ЭтаФорма.ИдентификаторПодключения);
	Если ЭтоНовоеПодключение Тогда
		ЭтаФорма.ИдентификаторПодключения = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	Если ЭтоСинхронизация И ЗначениеЗаполнено(НазваниеПланаОбмена) Тогда   
		БазоваяКонфигурация = ЭтоБазоваяКонфигурация();
		Если БазоваяКонфигурация Тогда  
			ТекстСообщения = "Для базовой конфигурации выбранный алгоритм невозможно выполнить: 
							 |отсутствует возможность работы с планами обмена";
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		СоздатьУзелПланаОбмена();
	КонецЕсли;
	ЗаписатьПодключение(ЭтоНовоеПодключение);
	ЗаписатьСтатистику(ЭтоНовоеПодключение);
	Если ЭтоСинхронизация Тогда
		ИзменитьНаправленияСинхронизации();	
		Если ЭтоНовоеПодключение Тогда 
			ФиксацияНачалаОбмена();
		КонецЕсли;
	КонецЕсли;
	Если Автозапуск Тогда
		АктивироватьРегламентноеЗаданиеАвтоматическихОперацийНаСервере();	
	КонецЕсли;
	Оповестить("ОбновитьАвтоматическиеОперации");
КонецПроцедуры

