
Процедура ДобавитьКомандуАвтоматическиеОперации(ТзКоманды)
	НоваяКоманда = ТзКоманды.Добавить();
	НоваяКоманда.Представление = НСтр("ru = 'Выполнить автоматические операции (" + ЛокализацияНазваниеПродукта() + ")'");
	НоваяКоманда.Идентификатор = "АвтоматическиеОперации";
	НоваяКоманда.Использование = "ВызовСерверногоМетода";
	НоваяКоманда.ПоказыватьОповещение = Истина;	
