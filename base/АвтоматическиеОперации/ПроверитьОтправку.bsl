
&НаКлиенте
Процедура ПроверитьОтправку(Команда)
	Если ПустаяСтрока(ЭтаФорма.ЭлектроннаяПочтаДляРассылки) Тогда
		ПоказатьОповещениеПользователя(
			"Ошибка отправки", ,
			"Укажите e-mail получателя"
			, ,СтатусОповещенияПользователя.Важное);
		Возврат;
	КонецЕсли;
	ФормаТранспорта = ПолучитьФормуТранспорта(ЭтаФорма.context_params);
	Попытка
		ПараметрыПочтыПолученные = Неопределено;
		ФормаТранспорта.SabySendMail(
			"Тестовое письмо Автоматической операции",
			ЭтаФорма.ЭлектроннаяПочтаДляРассылки, "", ПараметрыПочтыПолученные);
			
		ПоказатьОповещениеПользователя(
			"Письмо успешно отправлено", , ""
			, ,СтатусОповещенияПользователя.Важное);  
		ЭтаФорма.ПараметрыПочты = ПараметрыПочтыПолученные;	
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		СтруктураОшибки = ExtExceptionAnalyse(ИнфоОбОшибке);
		ПоказатьОповещениеПользователя(
			"Ошибка отправки", ,
			СтруктураОшибки.message
			, ,СтатусОповещенияПользователя.Важное);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьНастройкиПочты(Команда)
	Если ЭтаФорма.ПараметрыПочты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	context_params_Записать = Новый Структура;
	SendMessage	= Новый Структура;
	SendMessage.Вставить("EmailFailAutoOperation",  ЭтаФорма.ЭлектроннаяПочтаДляРассылки);
	SendMessage.Вставить("EmailSenderSettings",  ЭтаФорма.ПараметрыПочты);
	context_params_Записать.Вставить("SendMessage", SendMessage);
	ЗаписатьПараметрыПочты(context_params_Записать);


КонецПроцедуры

&НаСервере
Процедура ЗаписатьПараметрыПочты(Знач context_params_Записать);
	МодульОбъекта = МодульОбъекта();
	Если context_params = Неопределено Тогда 
		context_params = Новый Структура;
	КонецЕсли;
	Для каждого context_param_Записать Из context_params_Записать Цикл
		context_params.Вставить(context_param_Записать.Ключ, context_param_Записать.Значение);
	КонецЦикла;		
	МодульОбъекта.НастройкиПодключенияЗаписать(context_params);
КонецПроцедуры

