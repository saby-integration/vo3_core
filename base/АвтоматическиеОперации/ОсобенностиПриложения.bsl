
&НаСервере

Функция ПолучитьМакетНаСервере(ИмяМакета)  
	Обработка =  РеквизитФормыВЗначение("Объект");
	Макет = Обработка.ПолучитьМакет(ИмяМакета);
	Возврат Макет;
КонецФункции

Функция РеквизитИсторияОбмена()
	Возврат ИсторияОбменаТабличныйДокумент;
КонецФункции

&НаКлиенте

Процедура ВыборИзСписка(СписокВыбора)
	ПослеВыбораВариантаУстановкиНаправления = Новый ОписаниеОповещения("ПослеВыбораВариантаУстановкиНаправления", ЭтаФорма);
	ЭлемФормы = ПолучитьЭлементыФормы();
	ЭлементУстановитьСнятьФлажки = ЭлемФормы.ДеревоНастроекПодключенияУстановитьНаправление;
	ПоказатьВыборИзСписка(ПослеВыбораВариантаУстановкиНаправления, СписокВыбора, ЭлементУстановитьСнятьФлажки);	
КонецПроцедуры

&НаСервере

Процедура ОтобразитьДеревоНастроекПодключения(ДеревоЗначений)
	ЗначениеВРеквизитФормы(ДеревоЗначений, "ДеревоНастроекПодключения");
	// Без этого кода дерево становится в свернутом виде после обновления формы
	ЭлемФормы = ПолучитьЭлементыФормыНаСервере(); 
	ЭлемФормы.ДеревоНастроекПодключения.НачальноеОтображениеДерева = НачальноеОтображениеДерева.НеРаскрывать;	
	ЭлемФормы.ДеревоНастроекПодключения.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;	
КонецПроцедуры

&НаСервере

Функция ЭлементДеревоНастроекПодключения() 
	Возврат РеквизитФормыВЗначение("ДеревоНастроекПодключения");	
КонецФункции

&НаКлиенте
Процедура ДеревоНастроекПодключенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ДеревоНастроекПодключенияНаправление" Тогда
		ОповещениеВыбора = Новый ОписаниеОповещения("ПослеВыбораЗначенияНаправления", ЭтотОбъект);
		
		ТекущиеДанные = Элемент.ТекущиеДанные;
		ЭлемФормы = ПолучитьЭлементыФормы();
		НаправленияВозможные0		= 0;
		НаправленияВозможныеОткл	= 1;
		НаправленияВозможныеВОбе	= 2;
		НаправленияВозможныеВСБИС	= 3;
		НаправленияВозможныеВИС		= 4;
		
		СписокВыбора = Новый СписокЗначений;
		
		// BSLLS:LineLength-off
		Если ТекущиеДанные.НаправленияВозможные = НаправленияВозможные0 Тогда
			ЭлемФормы.ДеревоНастроекПодключения.ПодчиненныеЭлементы.ДеревоНастроекПодключенияНаправление.ТолькоПросмотр = Истина;
		Иначе
			ЭлемФормы.ДеревоНастроекПодключения.ПодчиненныеЭлементы.ДеревоНастроекПодключенияНаправление.ТолькоПросмотр = Ложь;
			Если ТекущиеДанные.НаправленияВозможные = НаправленияВозможныеВОбе Тогда   
				СтрокаСостояния = "Синхронизировать в обе стороны";
				СписокВыбора.Добавить(НаправленияВозможныеВОбе, СтрокаСостояния, , ЭлемФормы.Направление_1.Картинка);
			КонецЕсли;
			
			Если ТекущиеДанные.НаправленияВозможные = НаправленияВозможныеВСБИС
				ИЛИ ТекущиеДанные.НаправленияВозможные = НаправленияВозможныеВОбе Тогда
				СтрокаСостояния = "В Saby";
				СписокВыбора.Добавить(НаправленияВозможныеВСБИС, СтрокаСостояния, , ЭлемФормы.Направление_2.Картинка);
			КонецЕсли;
			
			Если ТекущиеДанные.НаправленияВозможные = НаправленияВозможныеВИС 
				ИЛИ ТекущиеДанные.НаправленияВозможные = НаправленияВозможныеВОбе Тогда
				СтрокаСостояния = "В ИС";
				СписокВыбора.Добавить(НаправленияВозможныеВИС, СтрокаСостояния, , ЭлемФормы.Направление_3.Картинка);
			КонецЕсли;	
			СтрокаСостояния = "Отключено";
			СписокВыбора.Добавить(НаправленияВозможныеОткл, СтрокаСостояния, , ЭлемФормы.Направление_4.Картинка);
		КонецЕсли;		
		// BSLLS:LineLength-on
		
		ПоказатьВыборИзСписка(ОповещениеВыбора, СписокВыбора, Элемент);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьРодителя(Элемент)
	Возврат Элемент.ПолучитьРодителя();
КонецФункции
