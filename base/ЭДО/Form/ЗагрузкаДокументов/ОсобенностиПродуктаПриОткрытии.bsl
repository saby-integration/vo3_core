&НаКлиенте
Функция ПараметрыПереотправки()
	// BSLLS:UnusedLocalVariable-on
	
	ОбъектыОтправки = Новый Массив;
	Для Каждого СтрокаТбл Из Объекты Цикл
		ОбъектыОтправки.Добавить(СтрокаТбл.Объект);
	КонецЦикла;
	ПараметрыПереотправки = Новый Структура();
	ПараметрыПереотправки.Вставить("ОбъектыОтправки", ОбъектыОтправки);
	ПараметрыПереотправки.Вставить("ВладелецФормы", ЭтаФорма.ВладелецФормы);
	Возврат ПараметрыПереотправки;	
	// BSLLS:UnusedLocalVariable-off Переменная используется в склеянных областях

КонецФункции	

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ФормаОткрыта = Ложь;
	ЭтаФорма.ВыполнитьЗакрытиеФормы = Ложь;
	context_param = СБИСПараметры();
	ТранспортИнтеграции = ПолучитьФормуТранспорта(context_param);
	ОбработчикПослеАвторизации = SabyОписаниеОповещения("ПриОткрытииПослеАвторизации", ЭтаФорма);
	ОткрытьФормуАвторизацииПриОтсутствииСессии(context_param, ТранспортИнтеграции, ОбработчикПослеАвторизации);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытииПослеАвторизации(Результат, ДопПараметры = Неопределено) Экспорт
	Если Результат = Неопределено Тогда
		ЭтаФорма.Закрыть();
		Возврат;	
	КонецЕсли;
	context_param = Результат;
	СтатусЧерновик = 0;
	СтатусЗавершено = 7;
	СтатусОшибка = 9;
	

	// BSLLS:UnusedLocalVariable-off Заполнение переменных формы
	BlocklyExecutor = ПолучитьФормуBlockly();
	ФормаОткрыта = Истина;
	ПроверкаВведенныхДанныхАутентификации = Неопределено;
	// BSLLS:UnusedLocalVariable-on
	
		
	СтатусВерсии = ПолучитьИнформациюОВерсииПоУмолчанию();
	СтатусВерсии = ПолучитьСтатусВерсииНаФорме(Ложь);
	
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочкиСтраницы = ЭлементыФормочки.Найти("Страницы");
	Если ЭлементыФормочкиСтраницы <> Неопределено Тогда
		ЭлементыФормочкиСтраницы.Видимость = Ложь;
	КонецЕсли;

	ОбновитьИнформациюОВерсии(СтатусВерсии);  
	Если ЭлементыФормочки.ПерезапуститьДО.Видимость = Ложь Тогда
		ВыполнитьПроверкуДокументов(context_param);
	Иначе
		ПослеПроверкиДокументовНаСервере(Неопределено);
		ПослеПроверкиДокументов(Неопределено, Неопределено);
	КонецЕсли;	
	
	УстановитьТипВыгружаемогоОбъектаВсемОбъектам();
КонецПроцедуры

