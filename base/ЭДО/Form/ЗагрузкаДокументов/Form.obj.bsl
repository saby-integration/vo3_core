&НаКлиенте
Процедура ОбъектыПередУдалением(Элемент, Отказ)
	Отказ = Истина;
	ИдентификаторыСтрок = Новый Массив;
	Для Каждого ИдСтроки Из Элемент.ВыделенныеСтроки Цикл
		ИдентификаторыСтрок.Добавить(ИдСтроки);
	КонецЦикла;
	Оповещение = SabyОписаниеОповещения("ПроверитьОтветНаВопросОбУдаленииВыгружаемыхОбъектов", ЭтаФорма, ИдентификаторыСтрок);
	SabyПоказатьВопрос(
		Оповещение,
		"Удалить выбранные объекты из списка отправляемых?",
		РежимДиалогаВопрос.ДаНет,
		0,
		КодВозвратаДиалога.Нет,
		"Удаление объектов из списка.");
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВложение(Команда)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ДанныеСтроки = ЭлементыФормочки.ВложенияТипаДокумента.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено ИЛИ ДанныеСтроки.ТипВложения = "ПечатнаяФорма" Тогда
		Возврат;
	КонецЕсли;
	//Удаление из общей таблицы
	УдалитьВложениеИзТаблицы("ВложенияПоТипамОбъектов1С", ДанныеСтроки);
	//Удаление из таблицы на форме
	УдалитьВложениеИзТаблицы("ВложенияТекущегоТипаОбъекта1С", ДанныеСтроки);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеОВыбранномРегламенте(ТекущиеДанныеОбъекты, ИмяИни,
	ВыбРегламент, НазваниеРегламентаПользоваателя)
	
	ТипОбъектаПоИмени = ТипОбъектаПоИмениИни(ИмяИни);
	Отбор = Новый Структура("ВидОбъекта,ТипОбъекта", ТекущиеДанныеОбъекты.ВидОбъекта, ТипОбъектаПоИмени);
	СписокРегламентов = РегламентТекущегоТипаДокумента.НайтиСтроки(Отбор);
	Для каждого Регл из СписокРегламентов Цикл
	 	Регл.Регламент	= ВыбРегламент;
	 	Регл.ПроизвольноеНазваниеРегламента	= НазваниеРегламентаПользоваателя;
		// Сменим регламент всем объектам одного типа
	КонецЦикла;	
	
	ЗаписатьРегламентыПоУмолчанию(
		ТекущиеДанныеОбъекты.ВидОбъекта,
		ТипОбъектаПоИмени,
		ВыбРегламент,
		НазваниеРегламентаПользоваателя,
		ТекущиеДанныеОбъекты.Представление);
КонецПроцедуры

&НаКлиенте
Процедура РегламентПриИзменении(Элемент)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ТД = ЭлементыФормочки.Объекты.ТекущиеДанные;
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбновитьДанныеОВыбранномРегламенте(ТД, ЭтаФорма.ТипОбъекта, ЭтаФорма.Регламент, ЭтаФорма.ПроизвольноеНазваниеРегламента);
	ТипОбъектаПоИмени = ТипОбъектаПоИмениИни(ЭтаФорма.ТипОбъекта);
	УстановитьПроизвольноеНазваниеРегламента(ТД.ВидОбъекта, ТипОбъектаПоИмени, ЭтаФорма.Регламент);
	УстановитьВидимостьПроизвольногоНазванияРегламента(Регламент, ТД.ВидОбъекта, ЭтаФорма.ТипОбъекта);
	УстановитьВидимостьКомандВложения(ТД.Объект, Регламент, ТипОбъекта);
КонецПроцедуры

&НаКлиенте
Процедура ПроизвольноеНазваниеРегламентаПриИзменении(Элемент)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ТД = ЭлементыФормочки.Объекты.ТекущиеДанные;
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьДанныеОВыбранномРегламенте(
		ТД,
		ЭтаФорма.ТипОбъекта, 
		ЭтаФорма.Регламент, 
		ЭтаФорма.ПроизвольноеНазваниеРегламента);
КонецПроцедуры

