&НаСервере
Процедура ЗаписатьВыборПФДляВидаДокумента(Знач ВидОбъекта )
	МассивПечатныхФорм	= Новый Массив();
	мВыбрПечатныхФорм = ВложенияТекущегоТипаОбъекта1С.НайтиСтроки(
		Новый Структура("ОтметкаВыбора, ВидОбъекта", Истина, ВидОбъекта));
	Для Каждого ПФорма из мВыбрПечатныхФорм Цикл
		МассивПечатныхФорм.Добавить( ПФорма.Представление );
	КонецЦикла;
	
	//Обновим отметки в глобальной таблице ПечатныхФорм
	мВыбрПечатныхФорм = ВложенияТекущегоТипаОбъекта1С.НайтиСтроки(Новый Структура("ВидОбъекта", ВидОбъекта));
	Для Каждого ПФорма из мВыбрПечатныхФорм Цикл
		мПФ	= ВложенияПоТипамОбъектов1С.НайтиСтроки(
			Новый Структура("Представление, ВидОбъекта", ПФорма.Представление, ВидОбъекта));
		Для Каждого СтрокаВл Из мПФ Цикл
			СтрокаВл.ОтметкаВыбора = ПФорма.ОтметкаВыбора;
			Прервать;
		КонецЦикла;
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить("Saby_ПФ_КОтправке", ВидОбъекта, МассивПечатныхФорм);
КонецПроцедуры

&НаСервере
Процедура ПрочитатьВыборПФДляВидаДокумента(Знач ВидОбъекта )
 	МассивПечатныхФорм = ХранилищеОбщихНастроек.Загрузить("Saby_ПФ_КОтправке", ВидОбъекта);
	Если ТипЗнч(МассивПечатныхФорм) = Тип("Массив") Тогда
		Для Каждого ПФорма из МассивПечатныхФорм Цикл
			//Обновим общие данные
			мПФ	= ВложенияПоТипамОбъектов1С.НайтиСтроки(
				Новый Структура("Представление, ВидОбъекта", ПФорма, ВидОбъекта));
			Для Каждого СтрокаВл Из мПФ Цикл
				СтрокаВл.ОтметкаВыбора = Истина;
			КонецЦикла;
			//Обновим данные на форме
			мПФ	= ВложенияТекущегоТипаОбъекта1С.НайтиСтроки(
				Новый Структура("Представление, ВидОбъекта", ПФорма, ВидОбъекта));
			Для Каждого СтрокаВл Из мПФ Цикл
				СтрокаВл.ОтметкаВыбора = Истина;
			КонецЦикла;
		КонецЦикла;
	Иначе
		Для Каждого СтрокаВл Из ВложенияПоТипамОбъектов1С Цикл
			СтрокаВл.ОтметкаВыбора = Ложь;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРегламентыПоУмолчанию(Знач ВидОбъекта, Знач ТипОбъекта, Знач ТекРегламент, 
	Знач ПроизвольноеНазвание, Знач ПредставлениеОбъекта)
	ХранилищеОбщихНастроек.Сохранить("Saby_Регламенты", ВидОбъекта + ТипОбъекта,
		Новый Структура("Регламент ,ПроизвольноеНазвание", ТекРегламент, ПроизвольноеНазвание));
	ХранилищеОбщихНастроек.Сохранить("Saby_Регламенты", ВидОбъекта + ТипОбъекта + ПредставлениеОбъекта,
		Новый Структура("Регламент ,ПроизвольноеНазвание", ТекРегламент, ПроизвольноеНазвание));	
КонецПроцедуры

&НаСервере
Функция ПрочитатьРегламентПоУмолчанию(Знач ВидОбъекта, Знач ТипОбъекта, Знач ПредставлениеОбъекта)
	РегламентПоУмолчанию = ХранилищеОбщихНастроек.Загрузить("Saby_Регламенты", ВидОбъекта + ТипОбъекта + ПредставлениеОбъекта);
	Если не ЗначениеЗаполнено(РегламентПоУмолчанию) Тогда
		РегламентПоУмолчанию = ХранилищеОбщихНастроек.Загрузить("Saby_Регламенты", ВидОбъекта + ТипОбъекта);
	КонецЕсли;	
	Возврат РегламентПоУмолчанию;
КонецФункции

&НаСервере
Процедура ЗаписатьТипОбъектаПоУмолчанию(Знач ВидОбъекта, Знач ТипОбъекта)
	ХранилищеОбщихНастроек.Сохранить("Saby_ОбъектВыгружаемый", ВидОбъекта,
		Новый Структура("ТипОбъекта", ТипОбъекта));
КонецПроцедуры

&НаСервере
Функция ПрочитатьТипОбъектаПоУмолчанию(Знач ВидОбъекта, Знач ЗначениеПоУмолчанию)
	ТипОбъектаИзХранилища = ХранилищеОбщихНастроек.Загрузить("Saby_ОбъектВыгружаемый", ВидОбъекта);
	ТипОбъектаУмолчанию = get_prop(ТипОбъектаИзХранилища, "ТипОбъекта", ЗначениеПоУмолчанию);
	Если ПустаяСтрока(ТипОбъектаУмолчанию) Тогда
		ТипОбъектаУмолчанию = ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат ТипОбъектаУмолчанию;
КонецФункции

&НаКлиенте
Функция ПервыйТипВыгружаемогоОбъекта()
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ПервоеЗначение = Новый Структура("Значение", "");
	Если ЭлементыФормочки.ТипОбъекта.СписокВыбора.Количество() > 0 Тогда 
		ПервоеЗначение = ЭлементыФормочки.ТипОбъекта.СписокВыбора[0];
	КонецЕсли;
	Возврат ПервоеЗначение.Значение;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьВыборТипыВыгружаемогоОбъекта(ВидОбъекта)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.ТипОбъекта.СписокВыбора.Очистить();
	
	ОтборСтруктура = Новый Структура("ВидОбъекта", ВидОбъекта);
	СтрокиТаблицыОбъектов = ТипыВыгружаемыхОбъектов.НайтиСтроки(ОтборСтруктура);
	Если СтрокиТаблицыОбъектов.Количество() = 0 Тогда
		ЭлементыФормочки.ТипОбъекта.СписокВыбора.Добавить(ВидОбъекта, ВидОбъекта);
	Иначе
		Для Каждого СтрокаОбъекта Из СтрокиТаблицыОбъектов Цикл 
			ЭлементыФормочки.ТипОбъекта.СписокВыбора.Добавить(СтрокаОбъекта.ТипыОбъекта, СтрокаОбъекта.КрасивоеНазвание);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьСписокРегламентовВыбранногоВидаОбъекта(ВидОбъекта, ТипОбъекта, ПредставлениеОбъекта)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементыФормочки.Регламент.СписокВыбора.Очистить();
	Отбор = Новый Структура("ВидОбъекта, ТипОбъекта", ВидОбъекта, ТипОбъекта);
    СтрокиРегламента = РегламентПоТипамДокументов.НайтиСтроки(Отбор);
	Для Каждого Регл Из СтрокиРегламента Цикл
		Если Регл.ПредставлениеОбъекта = ПредставлениеОбъекта Тогда 
	 		_Строка = ЭлементыФормочки.Регламент.СписокВыбора.Добавить();
	 		_Строка.Значение = Регл.Регламент.Значение;
			_Строка.Представление = Регл.Регламент.Представление;
		КонецЕсли;	
	КонецЦикла;
	
	ЭлементыФормочки.Регламент.Видимость = (ЭлементыФормочки.Регламент.СписокВыбора.Количество() > 0);
КонецПроцедуры	

&НаКлиенте
Функция РанееВыбранныйРегламент(ВидОбъекта, ТипОбъекта, ПредставлениеОбъекта)
	Если НЕ ФормаОткрыта Тогда
		Возврат Неопределено;
	КонецЕсли;
	//Выбренем запомненый Регламент
	Отбор = Новый Структура("ПредставлениеОбъекта, ТипОбъекта", ПредставлениеОбъекта, ТипОбъекта);
	СтрокиРегл = РегламентТекущегоТипаДокумента.НайтиСтроки(Отбор);
	Если СтрокиРегл.Количество() > 0 Тогда
		Для каждого Регл из СтрокиРегл Цикл
			ВремРегламент = Регл.Регламент;
			Прервать;
		КонецЦикла;
	Иначе
		//Этого быть не может но пусть отработает этот вариант
		ЭлементыФормочки = ПолучитьЭлементыФормы();
		Если ЭлементыФормочки.Регламент.СписокВыбора.Количество() > 0 Тогда 
			// На случай отстуствия регламентов
			ВремРегламент = ЭлементыФормочки.Регламент.СписокВыбора[0].Значение;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат ВремРегламент;
КонецФункции	

&НаСервере
Процедура ДобавитьПараметрыВОбщиеНастройки(context_params, СтруктураПараметров)
	МодульОбъекта = МодульОбъекта();
	ОбщиеНастройки	= МодульОбъекта.ОбщиеНастройкиПрочитать();
	ПубличныеОбщиеНастройки	= get_prop(ОбщиеНастройки, "public", Новый Структура);
	Для каждого ЭлемСтруктуры из СтруктураПараметров Цикл
		ПубличныеОбщиеНастройки.Вставить(ЭлемСтруктуры.Ключ, ЭлемСтруктуры.Значение);
	КонецЦикла;
	ОбщиеНастройки.Вставить("public", ПубличныеОбщиеНастройки);
	МодульОбъекта.ОбщиеНастройкиЗаписать(ОбщиеНастройки);
	context_params["public"] = ПубличныеОбщиеНастройки;
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы(КоличествоДок, ПервыйДок)
	//Элементы.ГрПредпросмотр.Видимость = (КоличествоДок = 1);
	//Элементы.ГрСписокДокументов.Видимость = НЕ (КоличествоДок = 1);
