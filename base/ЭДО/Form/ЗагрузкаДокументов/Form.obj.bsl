&НаСервере
Процедура ЗаполнитьОбъекты(мДокументы)
	Для Каждого ОтпДокумент Из мДокументы Цикл
		нСтрока 				= Объекты.Добавить();
		Если ТипЗнч(ОтпДокумент) = Тип("Структура") Тогда
			СсылкаНаОбъект = get_prop(ОтпДокумент, "ОбъектИС", get_prop(ОтпДокумент, "Ссылка"));
		Иначе
			СсылкаНаОбъект = ОтпДокумент.Ссылка
		КонецЕсли;
		Если СсылкаНаОбъект = Неопределено Тогда
			ВызватьИсключение "Не удалось определить объект 1С для загрузки";
		КонецЕсли;
		нСтрока.Объект			= СсылкаНаОбъект.Ссылка;
		нСтрока.Представление	= СсылкаНаОбъект.Ссылка;
		нСтрока.СтатусОшибки	= 0;
		нСтрока.ВидОбъекта		= СсылкаНаОбъект.Метаданные().Имя;
		нСтрока.ТипОбъекта 		= нСтрока.ВидОбъекта;
	КонецЦикла;	

КонецПроцедуры

