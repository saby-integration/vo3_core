// BSLLS:CognitiveComplexity-off

&НаКлиенте
Процедура ЗаполнитьТЗДоступныхРегламентов()
	ПоддерживаемыТипыВыгрузки = Новый Соответствие;
	ТипыОбъектов	= Новый Соответствие;
	
	// Подготовка данных
	Для Каждого СтрДокум Из ЭтаФорма.Объекты Цикл
		ИмяВидаОбъектаДокумента	= СтрДокум.ВидОбъекта;
		ПредставлениеДокумента	= СтрДокум.Представление;
		
		ОбработанТип = ТипыОбъектов[ИмяВидаОбъектаДокумента];
		Если ОбработанТип =Истина Тогда
			Продолжить;
		КонецЕсли;
		ТипыОбъектов.Вставить(ИмяВидаОбъектаДокумента, Истина);

		ИмяОбъектаИС = ПолучитьИмяОбъектаИС(СтрДокум.Объект);
		ЗаполнитьТипВыгружаемыхОбъектов(ИмяОбъектаИС);
		
		СписокРегламентов = ВызовПолученияСпискаРегламентов(ИмяВидаОбъектаДокумента);
		
		// Регламент по умолчанию для каждого типа выгружаемых документов
		СписокТиповДок = Новый Соответствие;
		Для каждого Регл Из СписокРегламентов Цикл
			ТипВыгружаемогоДокумента = get_prop(Регл, "DocType");
			СписокТиповДок.Вставить(ТипВыгружаемогоДокумента, ТипВыгружаемогоДокумента);
		КонецЦикла;
		Если СписокТиповДок.Количество() = 0 Тогда
			СписокТиповДок.Вставить(ИмяВидаОбъектаДокумента, ИмяВидаОбъектаДокумента);
		КонецЕсли;
		
		// Заполнить по каждому документу/объекту
		ОтборДокументов = Новый Структура("ВидОбъекта", ИмяВидаОбъектаДокумента);
		СтрокиОбъектовОдногоТипа = ЭтаФорма.Объекты.НайтиСтроки(ОтборДокументов);
		Для Каждого СтрокаДокументаОбъекта Из СтрокиОбъектовОдногоТипа Цикл
			ДанныеОбОбъекте = Новый Структура;
			ДанныеОбОбъекте.Вставить("ВидОбъекта", СтрокаДокументаОбъекта.ВидОбъекта);
			ДанныеОбОбъекте.Вставить("Представление", СтрокаДокументаОбъекта.Представление);
			ДанныеОбОбъекте.Вставить("СписокТиповДок", СписокТиповДок);
			ДанныеОбОбъекте.Вставить("СписокРегламентов", СписокРегламентов);
			ПоддерживаемыТипыВыгрузки.Вставить(ДанныеОбОбъекте.Представление, ДанныеОбОбъекте);
		КонецЦикла;
	КонецЦикла; // ЭтаФорма.Объекты
		
	// Заполнение таблиц
	Для Каждого СтрокаДанныхОбъекта Из ПоддерживаемыТипыВыгрузки Цикл
		
		мРегламентыОбъекта = Новый Массив();
		
		ИмяВидаОбъектаДокумента	= СтрокаДанныхОбъекта.Значение.ВидОбъекта;
		ПредставлениеДокумента	= СтрокаДанныхОбъекта.Значение.Представление;
		СписокТиповДок			= СтрокаДанныхОбъекта.Значение.СписокТиповДок;
		СписокРегламентов		= СтрокаДанныхОбъекта.Значение.СписокРегламентов;

		// Обход Выгружаемого Типа для каждого документа - СтрокаДанныхОбъекта.ВидОбъекта
		Для Каждого ТипВыгружаемогоДокументаКЗ Из СписокТиповДок Цикл

			// Регламент по умолчанию
			ТипВыгружаемогоДокумента = ТипВыгружаемогоДокументаКЗ.Значение;
			НовыйРегл = РегламентПоТипамДокументов.Добавить();
			НовыйРегл.Регламент = Новый Структура("Значение, Представление, ПроизвольноеНазваниеРегламента",
				"", 
				"По умолчанию",
				Ложь);
			НовыйРегл.ВидОбъекта = ИмяВидаОбъектаДокумента;
			НовыйРегл.ТипОбъекта = ТипВыгружаемогоДокумента;
			НовыйРегл.ПредставлениеОбъекта = ПредставлениеДокумента;
			
			// Регламеты по типу документа		
			Для каждого Регл из СписокРегламентов Цикл
				DocType = get_prop(Регл, "DocType");
				Если DocType <> ТипВыгружаемогоДокумента Тогда
					Продолжить;
				КонецЕсли;	
				
				НовыйРегл = РегламентПоТипамДокументов.Добавить();
				НовыйРегл.Регламент = Новый Структура("Значение, Представление, ПроизвольноеНазваниеРегламента",
				Регл["Name"] + "[/" + ТипОбъектаАПИПоТипуСБИС(DocType, "", "", Неопределено) + "/]",
				Регл["Name"],
				get_prop(get_prop(Регл,"AdditionalData", Новый Соответствие), "DocOtherCustomTitle", Ложь));
				НовыйРегл.ВидОбъекта = ИмяВидаОбъектаДокумента;
				НовыйРегл.ТипОбъекта = ТипВыгружаемогоДокумента;
				НовыйРегл.ПредставлениеОбъекта = ПредставлениеДокумента;
				мРегламентыОбъекта.Добавить(Регл["Name"] + "[/" + ТипОбъектаАПИПоТипуСБИС(DocType, "", "", Неопределено) + "/]");
			КонецЦикла;
			
			//*********************************************
			
			// Получим первый по списку регламент
			ПервыйРегламент = "";
			Если мРегламентыОбъекта.Количество() > 0 Тогда
				ПервыйРегламент = мРегламентыОбъекта[0];
			КонецЕсли;
			
			// Получим Регламент по умолчанию для Объекта
			ВремРегламент = "";
			РегламентПоУмолчанию = ПрочитатьРегламентПоУмолчанию(ИмяВидаОбъектаДокумента,
				ТипВыгружаемогоДокумента,
				ПредставлениеДокумента);
			Если РегламентПоУмолчанию <> Неопределено Тогда
				ВремРегламент = get_prop(РегламентПоУмолчанию, "Регламент", ПервыйРегламент);
			КонецЕсли;
			
			// Установить значение в таблице выбраных Регламентов
			Отбор = Новый Структура("ПредставлениеОбъекта, ТипОбъекта", ПредставлениеДокумента, ТипВыгружаемогоДокумента);
			СписокРегламентовТекущегоТипаДокумента = РегламентТекущегоТипаДокумента.НайтиСтроки(Отбор);
			Если СписокРегламентовТекущегоТипаДокумента.Количество() = 0 Тогда
				РедактируемаСтрока = РегламентТекущегоТипаДокумента.Добавить();
			Иначе
				РедактируемаСтрока = СписокРегламентовТекущегоТипаДокумента.Получить(0);
			КонецЕсли ;
			РедактируемаСтрока.ВидОбъекта	= ИмяВидаОбъектаДокумента;
			РедактируемаСтрока.ТипОбъекта	= ТипВыгружаемогоДокумента;
			РедактируемаСтрока.ПредставлениеОбъекта = ПредставлениеДокумента;
			РедактируемаСтрока.Регламент	= ВремРегламент;
			РедактируемаСтрока.ПроизвольноеНазваниеРегламента	= get_prop(
				РегламентПоУмолчанию,
				"ПроизвольноеНазвание", 
				ПолучитьПроизвольноеНазваниеИзПолногоНазванияРегламента(ВремРегламент));
		КонецЦикла; // СписокДоступныхРегламентов
		
	КонецЦикла; // Объекты
	
КонецПроцедуры	
