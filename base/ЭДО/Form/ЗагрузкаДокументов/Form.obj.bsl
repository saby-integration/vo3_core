&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "SabySignOut" Тогда
		Закрыть();
	ИначеЕсли ИмяСобытия = "AddonActionResponse" Тогда
		ОбработатьРезультатСобытия(Параметр);
	ИначеЕсли ИмяСобытия = "ПереносСтатусовSABY" Тогда
		ПоказатьТекстСообщения();
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПФЕслиНеДокумент()
	ТипМетаданных = ТипОбъектаМетаданных(Объекты[0].Объект);
	Если Не ТипМетаданных = "Документы" Тогда 
		ВидимостьЭлементаФормы("ВложенияТипаДокумента", Ложь);
		ВидимостьЭлементаФормы("грДобавитьФайл", Ложь);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция РегламентПоНаименованию(ТекРегламент, ВидОбъекта, ТипОбъекта)
	НайденныйРегламент = Неопределено;
	Отбор = Новый Структура("ВидОбъекта, ТипОбъекта", ВидОбъекта, ТипОбъекта);
    СтрокиРегламента = РегламентПоТипамДокументов.НайтиСтроки(Отбор);
	Для каждого Регламента из СтрокиРегламента Цикл
		Если Регламента.Регламент.Значение = ТекРегламент Тогда
			НайденныйРегламент = Регламента.Регламент;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	Возврат НайденныйРегламент;
КонецФункции

&НаКлиенте
Процедура ТипОбъектаПриИзменении(Элемент)
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ТД = ЭлементыФормочки.Объекты.ТекущиеДанные;
	Если ТД = Неопределено Тогда 
		Возврат;
	КонецЕсли;
    ЗаписатьТипОбъектаПоУмолчанию(ТД.ВидОбъекта, ЭтаФорма.ТипОбъекта);

	ОтборСтруктура = Новый Структура("ВидОбъекта", ТД.ВидОбъекта);
	СтрокиОбъектов = ЭтаФорма.Объекты.НайтиСтроки(ОтборСтруктура);
	// Установить тип выгружаемого объекта у списка объектов
	Для Каждого СтрокаОбъекта Из СтрокиОбъектов Цикл
		СтрокаОбъекта.ТипОбъекта = ЭтаФорма.ТипОбъекта;
	КонецЦикла;
	
	УстановитьИмяИни(ТД.ВидОбъекта, ЭтаФорма.ТипОбъекта);
	ДокументыКОтправкеПриАктивизацииСтроки(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИмяИни(ВидОбъекта, ТипОбъекта)
	ОтборСтруктура = Новый Структура("ВидОбъекта", ВидОбъекта);
	СтрокиОбъектов = ЭтаФорма.Объекты.НайтиСтроки(ОтборСтруктура);
	Для Каждого СтрокаОбъекта Из СтрокиОбъектов Цикл
		ОтборИниСтруктура = Новый Структура("ВидОбъекта, ТипыОбъекта", ВидОбъекта, ТипОбъекта);
		СтрокиИни = ТипыВыгружаемыхОбъектов.НайтиСтроки(ОтборИниСтруктура);
		// Установить ИмяИНИ выгружаемого объекта в списке объектов
		Для Каждого СтрокаИни из СтрокиИни Цикл 
			СтрокаОбъекта.ИмяИни = СтрокаИни.ФайлНастроек;
			// Одна запись
			Прервать;
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры

