&НаКлиенте
Процедура ЗаполнитьТЗДоступныхРегламентов()
	СписокДоступныхРегламентов = Новый Соответствие;
	
	Для Каждого СтрДокум Из Объекты Цикл
		ИмяТипаДокумента = СтрДокум.ВидОбъекта;
		ПредставлениеДокумента = СтрДокум.Представление;
		
		ИмяОбъектаИС = ПолучитьИмяОбъектаИС(СтрДокум.Объект);
		ЗаполнитьТипВыгружаемыхОбъектов(ИмяОбъектаИС);
	
		// Регламенты по Виду докумета
		мРегламентыОбъекта = Новый Массив();
		СписокРегламентов = СписокДоступныхРегламентов[ИмяТипаДокумента];
		Если НЕ ЗначениеЗаполнено(СписокРегламентов) Тогда
			СписокРегламентов = ВызовПолученияСпискаРегламентов(ИмяТипаДокумента);
			
			СписокДоступныхРегламентов.Вставить(ИмяТипаДокумента, СписокРегламентов);
		КонецЕсли;
		
		// Регламент по умолчанию для каждого типа выгружаемых документов
		СписокТиповДок = Новый Соответствие;
		Для каждого Регл Из СписокРегламентов Цикл
			ТипВыгружаемогоДокумента = get_prop(Регл, "DocType");
			СписокТиповДок.Вставить(ТипВыгружаемогоДокумента, ТипВыгружаемогоДокумента);
		КонецЦикла;
		Если СписокТиповДок.Количество() = 0 Тогда
			СписокТиповДок.Вставить(ИмяТипаДокумента, ИмяТипаДокумента);
		КонецЕсли;
		
		// Все действия в разрезе Типа выгружаемого документа
		Для Каждого ТипВыгружаемогоДокументаКЗ Из СписокТиповДок Цикл
			// Регламент по умолчанию
			ТипВыгружаемогоДокумента = ТипВыгружаемогоДокументаКЗ.Значение;
			НовыйРегл = РегламентПоТипамДокументов.Добавить();
			НовыйРегл.Регламент = Новый Структура("Значение, Представление, ПроизвольноеНазваниеРегламента",
			"", 
			"По умолчанию",
			Ложь);
			НовыйРегл.ВидОбъекта = ИмяТипаДокумента;
			НовыйРегл.ТипОбъекта = ТипВыгружаемогоДокумента;
			НовыйРегл.ПредставлениеОбъекта = ПредставлениеДокумента;
			
			// Регламеты по типу документа		
			Для каждого Регл из СписокРегламентов Цикл
				DocType = get_prop(Регл, "DocType");
				Если DocType <> ТипВыгружаемогоДокумента Тогда
					Продолжить;
				КонецЕсли;	
				
				НовыйРегл = РегламентПоТипамДокументов.Добавить();
				НовыйРегл.Регламент = Новый Структура("Значение, Представление, ПроизвольноеНазваниеРегламента",
				Регл["Name"] + "[/" + ТипОбъектаАПИПоТипуСБИС(DocType) + "/]",
				Регл["Name"],
				get_prop(get_prop(Регл,"AdditionalData", Новый Соответствие), "DocOtherCustomTitle", Ложь));
				НовыйРегл.ВидОбъекта = ИмяТипаДокумента;
				НовыйРегл.ТипОбъекта = ТипВыгружаемогоДокумента;
				НовыйРегл.ПредставлениеОбъекта = ПредставлениеДокумента;
				мРегламентыОбъекта.Добавить(Регл["Name"] + "[/" + ТипОбъектаАПИПоТипуСБИС(DocType) + "/]");
			КонецЦикла;
			
			//*********************************************
			
			//Получим первый по списку регламент
			ПервыйРегламент = "";
			Если мРегламентыОбъекта.Количество() > 0 Тогда
				ПервыйРегламент = мРегламентыОбъекта[0];
			КонецЕсли;
			
			//Получим Регламент по умолчанию для Объекта
			ВремРегламент = "";
			РегламентПоУмолчанию = ПрочитатьРегламентПоУмолчанию(ИмяТипаДокумента, ТипВыгружаемогоДокумента, ПредставлениеДокумента);
			Если РегламентПоУмолчанию <> Неопределено Тогда
				ВремРегламент = get_prop(РегламентПоУмолчанию, "Регламент", ПервыйРегламент);
			КонецЕсли;
			
			//Установить значение в таблице выбраных Регламентов
			Отбор = Новый Структура("ПредставлениеОбъекта, ТипОбъекта", ПредставлениеДокумента, ТипВыгружаемогоДокумента);
			СписокРегламентовТекущегоТипаДокумента = РегламентТекущегоТипаДокумента.НайтиСтроки(Отбор);
			Если СписокРегламентовТекущегоТипаДокумента.Количество() = 0 Тогда
				РедактируемаСтрока = РегламентТекущегоТипаДокумента.Добавить();
			Иначе
				РедактируемаСтрока = СписокРегламентовТекущегоТипаДокумента.Получить(0);
			КонецЕсли ;
			РедактируемаСтрока.ВидОбъекта	= ИмяТипаДокумента;
			РедактируемаСтрока.ТипОбъекта	= ТипВыгружаемогоДокумента;
			РедактируемаСтрока.ПредставлениеОбъекта = ПредставлениеДокумента;
			РедактируемаСтрока.Регламент	= ВремРегламент;
			РедактируемаСтрока.ПроизвольноеНазваниеРегламента	= get_prop(
			РегламентПоУмолчанию,
			"ПроизвольноеНазвание", 
			ПолучитьПроизвольноеНазваниеИзПолногоНазванияРегламента(ВремРегламент));
		КонецЦикла; // СписокТиповДок
	КонецЦикла; // Объекты
КонецПроцедуры	
