&НаКлиенте
Функция ТипВыгружаемогоОбъектаПоВидуОбъекта(ВидОбъекта)
	ПервыйТипОбъекта = ПервыйТипВыгружаемогоОбъекта(ВидОбъекта);
	ТипОбъектаБЛ = ПрочитатьТипОбъектаПоУмолчанию(ВидОбъекта, get_prop(ПервыйТипОбъекта, "ИмяИни", ""));
	Возврат ТипОбъектаБЛ;
КонецФункции

&НаКлиенте
Процедура УстановитьТипВыгружаемогоОбъектаВсемОбъектам()
	ОбработанныйВид = Новый Соответствие;
	Для Каждого СтрокаОбъекта Из ЭтаФорма.Объекты Цикл
		Если ОбработанныйВид[СтрокаОбъекта.ВидОбъекта] = Истина Тогда
			// Этот тип уже обработали
			Продолжить;
		КонецЕсли;
		ОбработанныйВид[СтрокаОбъекта.ВидОбъекта] = Истина;
		
		// Получим тип выгружаемого объек4та и установим его на все объеккты Вида
		ПервыйТипОбъекта = ПервыйТипВыгружаемогоОбъекта(СтрокаОбъекта.ВидОбъекта);  
		_ИмяИниНовый = get_prop(ПервыйТипОбъекта, "ИмяИни", "");
		_ИмяИни = ПрочитатьТипОбъектаПоУмолчанию(СтрокаОбъекта.ВидОбъекта, _ИмяИниНовый);
		_ИмяИни = КорректноеЗначениеИмениИни(_ИмяИни, ПервыйТипОбъекта);
		ТипОбъектаБЛ = ТипОбъектаПоИмениИни(_ИмяИни);
		мВидовОбъектов = ЭтаФорма.Объекты.НайтиСтроки(Новый Структура("ВидОбъекта", СтрокаОбъекта.ВидОбъекта));
		Для Каждого мВидовОбъектов Из мВидовОбъектов Цикл
			мВидовОбъектов.ИмяИни = _ИмяИни;
			мВидовОбъектов.ТипОбъекта = ТипОбъектаБЛ;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДокументыКОтправкеПриАктивизацииСтроки(Элемент)
	Если НЕ ФормаОткрыта Тогда
		Возврат;
	КонецЕсли;
	ЭтаФорма.ТипОбъекта = "";
	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ТД = ЭлементыФормочки.Объекты.ТекущиеДанные;
	ВложенияТекущегоТипаОбъекта1С.Очистить();
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПрочитатьВыборПФДляВидаДокумента(ТД.ВидОбъекта);
	УстановитьФильтрПФПоТипуДокумента(ТД.ВидОбъекта);

	ЗаполнитьСписокВыбораТиповВыгружаемогоОбъекта(ТД.ВидОбъекта);
	ПервыйТипОбъекта = ПервыйТипВыгружаемогоОбъекта(ТД.ВидОбъекта);  
	_ИмяИни = КорректноеЗначениеИмениИни(ТипВыгружаемогоОбъектаПоВидуОбъекта(ТД.ВидОбъекта), ПервыйТипОбъекта);
	ЭтаФорма.ТипОбъекта = _ИмяИни;
	ЗаполнитьСписокРегламентовВыбранногоВидаОбъекта(ТД, ЭтаФорма.ТипОбъекта);
	ТипОбъектаПоИмени = ТипОбъектаПоИмениИни(ЭтаФорма.ТипОбъекта);
	ЭтаФорма.Регламент = РанееВыбранныйРегламент(ТД, ТипОбъектаПоИмени);
	УстановитьПроизвольноеНазваниеРегламента(ТД.ВидОбъекта, ТипОбъектаПоИмени, ЭтаФорма.Регламент);
	УстановитьВидимостьПроизвольногоНазванияРегламента(ЭтаФорма.Регламент, ТД.ВидОбъекта, ТипОбъектаПоИмени);
	
	//После выбора регламента для тек объекта
	УстановитьВидимостьКомандВложения(ТД.Объект, Регламент, ТипОбъекта);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтветНаВопросОбУдаленииВыгружаемыхОбъектов(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если Объекты.Количество() = Параметры.Количество() Тогда
			//Удалены все объекты, имеет смысл сразу же закрыть форму
			Закрыть();
		Иначе
			Если Параметры.Количество() > 0 Тогда
				УдалитьСтрокуВыбранногоОбъекта(Параметры);	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

