#Область ЗагрузитьВСБИС

&НаСервере
Процедура ДобавитьВФильтрДанныеПоТипу()
	ВыбранныеПечатныеФормы = ЗаполнитьСтруктуруПечатныхФормДляПередачиНаСервере();
	ВидОбъектаТипОбъекта = КопияТаблицыФормы(Объекты);		
    ВидОбъектаТипОбъекта.Свернуть("ВидОбъекта,ТипОбъекта,ИмяИни");
	Фильтр.Selection.Вставить("DefaultValueForType", Новый Структура);
	Для Каждого Запись Из ВидОбъектаТипОбъекта Цикл 
		Отбор = Новый Структура("ВидОбъекта,ТипОбъекта", Запись.ВидОбъекта, Запись.ТипОбъекта);
		ТекущиеРегламенты = РегламентТекущегоТипаДокумента.НайтиСтроки(Отбор);
		НазваниеРегламента = "";
		ПроизвольноеНазваниеРегламента = "";
		Если ТекущиеРегламенты.Количество() > 0 Тогда
			ТекущийРегламент = ТекущиеРегламенты.Получить(0); 
			НазваниеРегламента = ПолучитьПроизвольноеНазваниеИзПолногоНазванияРегламента(ТекущийРегламент.Регламент);
			ПроизвольноеНазваниеРегламента = ТекущийРегламент.ПроизвольноеНазваниеРегламента;
		КонецЕсли;
		РегламентПоТипу = Новый Структура;
		РегламентПоТипу.Вставить("НазваниеРегламента", НазваниеРегламента);
		РегламентПоТипу.Вставить("ПроизвольноеНазваниеРегламента", ПроизвольноеНазваниеРегламента);
		Вложения = Неопределено;
		ВыбранныеПечатныеФормы.Свойство(Запись.ВидОбъекта, Вложения);
		СтруктураПоВидуОбъекта = Новый Структура;
		СтруктураПоВидуОбъекта.Вставить("Algorithm", Запись.ИмяИни);
		СтруктураПоВидуОбъекта.Вставить("Regulation", РегламентПоТипу);
		Если Вложения <> Неопределено Тогда
			СтруктураПоВидуОбъекта.Вставить("Attachments", Вложения);	
		КонецЕсли;
		Фильтр.Selection.DefaultValueForType.Вставить(Запись.ВидОбъекта, СтруктураПоВидуОбъекта);	
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВСБИС(Команда)

	ЭлементыФормочки = ПолучитьЭлементыФормы();
	ЭлементЗагрузитьВСБИС = ЭлементыФормочки.Найти("ЗагрузитьВСБИС");
	Если ЭлементЗагрузитьВСБИС <> Неопределено Тогда
		ЭлементЗагрузитьВСБИС.Доступность = Ложь;
	КонецЕсли;

	мИсполнители = Новый Массив;
	Если ПростойЗапросПодписи Тогда
		Для Каждого Исполнитель Из СписокИсполнителей Цикл
			Если НЕ ЗначениеЗаполнено(Исполнитель.Сотрудник) Тогда
				Продолжить;
			КонецЕсли;
			_Исполнитель = Новый Структура;
			_Исполнитель.Вставить("Роль", ?(ЗначениеЗаполнено(Исполнитель.Роль), Исполнитель.Роль, "Сотрудник"));
			_Исполнитель.Вставить("ТабельныйНомер", Исполнитель.ТабельныйНомер);
			_Исполнитель.Вставить("ЭлПочта", Исполнитель.ЭлПочта);
			_Исполнитель.Вставить("МобильныйТелефон", Исполнитель.МобильныйТелефон);
			мИсполнители.Добавить(_Исполнитель);
		КонецЦикла;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Фильтр) Тогда
		ОбрабатываемыеОбъекты = ПолучитьОбрабатываемыеОбъекты();
	Иначе
		ДобавитьВФильтрДанныеПоТипу();
		ОбрабатываемыеОбъекты = Неопределено;
	КонецЕсли;

	EndpointArgs = Новый Структура;
	EndpointArgs.Вставить("list_doc_ref",       ОбрабатываемыеОбъекты);
	EndpointArgs.Вставить("Исполнители",          мИсполнители);
	EndpointArgs.Вставить("ПростойЗапросПодписи", ПростойЗапросПодписи);
	EndpointArgs.Вставить("КаналИнформации",      ?(ЗначениеЗаполнено(КаналИнформации), КаналИнформации, 0));
	EndpointArgs.Вставить("МаршрутОзнакомления",  ?(ЗначениеЗаполнено(МаршрутОзнакомления), МаршрутОзнакомления, 0));
	EndpointArgs.Вставить("ПерезапуститьДО",  	ПерезапуститьДО);
	EndpointArgs.Вставить("Filter", Фильтр);
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("EndpointArgs",       EndpointArgs);

	Контекст = Новый Структура;
	Контекст.Вставить("ПараметрыВызова", ПараметрыВызова);
	Контекст.Вставить("context_params", context_param);
	Контекст.Вставить("algorithm", "Документы_send");
	Контекст.Вставить("НазваниеОперации", "Загрузка в " + ЛокализацияНазваниеПродукта());
	ОбработчикРезультата = SabyОписаниеОповещения("ЗагрузитьВСБИСПослеОбновленияКэшаЛокальныхСертификатов", ЭтаФорма, Контекст);

	ОбновитьКэшЛокальныхСертификатов(ОбработчикРезультата);

КонецПроцедуры

&НаКлиенте
Функция ПолучитьОбрабатываемыеОбъекты()
	ОбрабатываемыеОбъекты = Новый Массив;
	ВыбранныеПечатныеФормы = ЗаполнитьСтруктуруПечатныхФормДляПередачиНаСервере();

	ТипМетаданных = ТипОбъектаМетаданных(Объекты[0].Объект);
	Для Каждого ВыгружаемыйДокумент Из Объекты Цикл

		Отбор = Новый Структура("ПредставлениеОбъекта, ТипОбъекта", ВыгружаемыйДокумент.Представление, ВыгружаемыйДокумент.ТипОбъекта);
    	СписокРегламентов = РегламентТекущегоТипаДокумента.НайтиСтроки(Отбор);
		ПроизвольноеНазваниеРегламента = "";
		Для каждого Регл из СписокРегламентов Цикл
		 	ПолноеНазваниеРегламента = Регл.Регламент;
			ПроизвольноеНазваниеРегламента = Регл.ПроизвольноеНазваниеРегламента;
		КонецЦикла;
		НазваниеРегламента = ПолучитьПроизвольноеНазваниеИзПолногоНазванияРегламента(ПолноеНазваниеРегламента);

		API3_ref = Новый Структура;
		API3_ref.Вставить("ИдИС",			СокрЛП(ВыгружаемыйДокумент.Объект.УникальныйИдентификатор()));
		API3_ref.Вставить("ТипИС",			ТипМетаданных);
		API3_ref.Вставить("ИмяИС",			ВыгружаемыйДокумент.ВидОбъекта);
		API3_ref.Вставить("ini_name",		ВыгружаемыйДокумент.ИмяИни);
		API3_ref.Вставить("Название",		СокрЛП(ВыгружаемыйДокумент.Объект));
		API3_ref.Вставить("Регламент",		?(ЗначениеЗаполнено(НазваниеРегламента), НазваниеРегламента, Неопределено));
		API3_ref.Вставить("ПроизвольноеНазваниеРегламента",	ПроизвольноеНазваниеРегламента);
		API3_ref.Вставить("_print_forms",	?(ВыбранныеПечатныеФормы.Свойство(ВыгружаемыйДокумент.ВидОбъекта),
			ВыбранныеПечатныеФормы[ВыгружаемыйДокумент.ВидОбъекта], Неопределено));
		ОбрабатываемыеОбъекты.Добавить(API3_ref);
	КонецЦикла;

	Возврат ОбрабатываемыеОбъекты;
КонецФункции

