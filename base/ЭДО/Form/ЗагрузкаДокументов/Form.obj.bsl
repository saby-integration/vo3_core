&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭлементыФормочки = ПолучитьЭлементыФормыНаСервере();
	УстановитьЛокализацию();
	ДобавитьИнформациюОВерсии(ЭлементыФормочки.ВерсияПродукта);
	мДокументы = Неопределено;
	Объекты.Очистить();
	ТипыВыгружаемыхОбъектов.Очистить();
	ЭтаФорма.Фильтр = Неопределено;

	Если Параметры.Свойство("Filter") Тогда
		мДокументы = Параметры.Filter.Selection.Marked;
		ЭтаФорма.Фильтр = Параметры.Filter;
		ПереданныеПараметрыКоманды = get_prop(Параметры, "ПараметрыКоманды", Новый Структура);
		Для Каждого Парам Из ПереданныеПараметрыКоманды Цикл
			Попытка
				ЭтаФорма[Парам.Ключ] = Парам.Значение
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЦикла;	

	ИначеЕсли Параметры.Свойство("Источник") Тогда
		мДокументы = Параметры.Источник
	Иначе
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если мДокументы.Количество() > 0 Тогда
		ПервыйДок = мДокументы[0];
	Иначе
		//Закроем форму при отсутствии документов
		Отказ = Истина;
		Возврат;
	КонецЕсли;  
	ЗаполнитьОбъекты(мДокументы);
	ЭлементыФормочки.ПерезапуститьДО.Видимость = has_prop(Параметры, "ПерезапуститьДО");
	ПриСозданииНаСервереПереопределяемый();
КонецПроцедуры

