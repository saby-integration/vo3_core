&НаСервере
Функция ДокументШтатноеРасписание(Знач СсылкаОбъект)
	ДокументШР = СсылкаОбъект.Метаданные().Имя = "ШтатноеРасписание" 
		И  Метаданные.Документы.Найти("ШтатноеРасписание") <> Неопределено;
	Возврат ДокументШР;
КонецФункции

&НаСервере
Функция ИсключающийОбъектПерезапускаДО(СсылкаОбъект)
	мИсключения = Новый Массив;
	мИсключения.Добавить("Справочник.Сотрудники");
	мИсключения.Добавить("Справочник.ФизическиеЛица");
	
	НайденОбъект = Неопределено;
	ТипМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(СсылкаОбъект));
	Если ТипМетаданных <> Неопределено Тогда
		ИмяОбъекта = ТипМетаданных.ПолноеИмя();
	КонецЕсли;
	НайденОбъект = мИсключения.Найти(ИмяОбъекта);
	
	Возврат НайденОбъект <> Неопределено;
КонецФункции

