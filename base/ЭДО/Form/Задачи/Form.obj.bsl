&НаКлиенте
Функция АлгоритмПоВидуЗадачи() 
	СоответствиеАлгоритмов = Новый Соответствие;
	СоответствиеАлгоритмов.Вставить("Мои", 					"Blockly_TasksInWork_list");
	СоответствиеАлгоритмов.Вставить("ОтМеня", 				"Blockly_TasksFromMe_list");
	СоответствиеАлгоритмов.Вставить("Нераспределенные", 	"Blockly_TasksUnallocated_list");
	СоответствиеАлгоритмов.Вставить("Выполненные", 			"Blockly_TasksCompleted_list");	
	Возврат СоответствиеАлгоритмов[Тип];
		
КонецФункции	

&НаКлиенте
Функция ТулбарЗадач(context_params)
	_data = "Result";
	ИмяИни = АлгоритмПоВидуЗадачи();
	ПараметрыВызова = Новый Структура();
	ПараметрыВызова.Вставить("Algorithm", ИмяИни);
	ПараметрыВызова.Вставить("object", Новый Структура("object", Неопределено));
	ПараметрыВызова.Вставить("Endpoint", "toolbar"); 
	ПараметрыВызова.Вставить("EndpointArgs", Неопределено); 
	ПараметрыВызова.Вставить("ContextId", Неопределено); 
	ПараметрыВызова.Вставить("ConnectionId", context_params.ConnectionUuid);
	ПараметрыВызова.Вставить("ReadPublicParam", Ложь);
	result	= BlocklyExecutor.API_BLOCKLY_RUN(ПараметрыВызова);
	Если get_prop(result, "Status", Неопределено) = "complete" Тогда
		data = get_prop(result, _data, Неопределено);
		Возврат data;	
	КонецЕсли;
	ПараметрыВызова.Вставить("Endpoint", "view"); 
	result	= BlocklyExecutor.API_BLOCKLY_RUN(ПараметрыВызова);
	Если get_prop(result, "Status", Неопределено) = "complete" Тогда
		data = get_prop(result, _data, Неопределено);
		toolbar = get_prop(data, "Toolbar", get_prop(data, "ACTIONS", Неопределено));
		Если ЗначениеЗаполнено(toolbar) Тогда
			Возврат toolbar; 
		КонецЕсли;	
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура СписокЗадачОбработкаВыбораСтроки()
	
	ТекущиеДанные = Элементы.СписокЗадач.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущийЭлементСпискаЗадач = Элементы.СписокЗадач.ТекущийЭлемент;
	
	Если ТекущиеДанные.Подразделение = "Загрузить ещё" Тогда
		ТекущаяСтраница = ТекущаяСтраница + 1;
		СписокЗадач.Удалить(ТекущиеДанные);
		ОбновитьСписокЗадач(Ложь);
		Возврат;
	КонецЕсли;
	
	Если ТекущийЭлементСпискаЗадач.Имя = "СписокЗадачДокумент1С" и Не ТекущиеДанные.Документ1С = Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Документ1С);
	Иначе
		ПараметрыФормы = Новый Структура();
		
		ПараметрыФормы.Вставить("Идентификатор", ТекущиеДанные["Идентификатор"]);
		ПараметрыФормы.Вставить("ИдСБИС", ТекущиеДанные["ИдСБИС"]);
		ПараметрыФормы.Вставить("Сотрудник", ТекущиеДанные["Сотрудник"]);
		ПараметрыФормы.Вставить("Подразделение", ТекущиеДанные["Подразделение"]);
		ПараметрыФормы.Вставить("Название", ТекущиеДанные["Название"]);
		ПараметрыФормы.Вставить("Примечание", ТекущиеДанные["Примечание"]);
		
		Форма = ФормаОсновнойОбработки("ПросмотрДокумента", ПутьКФормамОбработки(), ПараметрыФормы, ЭтаФорма, ТекущиеДанные["Идентификатор"]);  
		context_params	= ПроверитьНаличиеПараметровПодключенияНаСервере();	
		КомандыПанели = ТулбарЗадач(context_params);
		
		Форма.Показать(ТекущиеДанные["Идентификатор"], ТекущиеДанные["Документ1С"], context_params, Новый Структура("КомандыПанели", КомандыПанели));

	КонецЕсли;
	
КонецПроцедуры

