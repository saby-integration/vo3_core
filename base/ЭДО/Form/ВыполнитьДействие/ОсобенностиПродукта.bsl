
#Область include_core_base_Helpers_ОпределениеТиповКонтента
#КонецОбласти

&НаСервере
Процедура УстановитьКартинкуНаКнопеДействия(КнопкаДействие, Действие,ТребуетсяВыборИсполнителя,ТребуетсяКомментарий)
	МодульОбъекта = МодульОбъекта();
	ПрефиксПродукта = ПрефиксПродукта();
	
	КнопкаДействие.Картинка		= БиблиотекаКартинок[ПрефиксПродукта+"Отступ"];
	Если ВРег(Действие["ТребуетИсполнителя"]) = "ДА" Тогда
		ТребуетсяВыборИсполнителя = Истина;
		КнопкаДействие.Отображение	= ОтображениеКнопки.КартинкаИТекст;
		КнопкаДействие.Картинка		= БиблиотекаКартинок[ПрефиксПродукта+"ТребуетсяИсполнитель"];
	КонецЕсли;
	Если ВРег(Действие["ТребуетКомментария"]) = "ДА" Тогда	
		ТребуетсяКомментарий = Ложь;
		КнопкаДействие.Отображение	= ОтображениеКнопки.КартинкаИТекст;
		КнопкаДействие.Картинка		= БиблиотекаКартинок[ПрефиксПродукта+"ТребуетсяКомментарий"];
	КонецЕсли;
	Если ТребуетсяВыборИсполнителя И ТребуетсяКомментарий Тогда	
		КнопкаДействие.Отображение	= ОтображениеКнопки.КартинкаИТекст;
		КнопкаДействие.Картинка		= БиблиотекаКартинок[ПрефиксПродукта+"ТребуетсяКомментарийИИсполнителя"];
	КонецЕсли;

	Если ВРег(Действие["ТребуетПодписания"]) = "ДА" Тогда
		Попытка
			КнопкаДействие.Картинка	= БиблиотекаКартинок[ПрефиксПродукта+"SignBlue"];
		Исключение
			КнопкаДействие.Картинка	= БиблиотекаКартинок.ЭлектронноЦифроваяПодпись;
		КонецПопытки
	КонецЕсли;
КонецПроцедуры

