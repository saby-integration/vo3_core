&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Идентификатор 	= Параметры.Идентификатор;
	ЭтаФорма.Документ1С 		= Параметры.Документ1С;
	ЭтаФорма.ИдСБИС			= Параметры.ИдСБИС;
	ЭтаФорма.СсылкаСБИС	 	= Параметры.СсылкаСБИС;
	ЭтаФорма.Сотрудник	 	= СтрЗаменить(Параметры.Сотрудник, Символы.ПС, "; ");
	ЭтаФорма.Название		= Параметры.Название;
	ЭтаФорма.Сотрудник	 	= СтрЗаменить(Параметры.Сотрудник, Символы.ПС, "; ");
	ЭтаФорма.Подразделение	= СтрЗаменить(Параметры.Подразделение, Символы.ПС, "; ");	
	ЭтаФорма.Регламент		= "";
	ЭтаФорма.Примечание      = СтрЗаменить(Параметры.Примечание, Символы.ПС, "; ");
	
	ОбработкаМодуль = МодульОбъекта();
	ЭтаФорма.context_params	= ОбработкаМодуль.ПроверитьНаличиеПараметровПодключения();
	
	УстановитьЛокализацию();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ТранспортИнтеграции = ПолучитьФормуТранспорта(context_params);
	BlocklyExecutor = ПолучитьФормуBlockly();

	Попытка
		ДокументСБИС = ПрочитатьДокумент();
		ДанныеДокументаРегламент = get_prop(ДокументСБИС, "Регламент");
		ЭтаФорма.Название = Тип1СПоТипуБЛ(
			get_prop(ДокументСБИС, "Тип"),
			get_prop(ДокументСБИС, "Примечание", ""));
		ЭтаФорма.Регламент = get_prop(ДанныеДокументаРегламент, "Название");
		
		// Переберем все доп поля, и получим все их знаяения
		ДопПоляЗначения = Новый Массив;
		ДанныеПоля = get_prop(ДокументСБИС, "ДополнительныеПоля");
		
		ЗначениеПоля = "";
		КолвоЭлементовВСтроке = 4;
		СимволовОтрезать = 2;
		Если ТипЗнч(ДанныеПоля) = Тип("Соответствие") Тогда 
			СчетЭлементов = 0;
			Для Каждого ПолеЭлементМассива Из ДанныеПоля Цикл
				СчетЭлементов = СчетЭлементов + 1;
				ЗначениеПоля = 	ЗначениеПоля + Символы.ВК;
				Если СчетЭлементов = КолвоЭлементовВСтроке Тогда
					ЗначениеПоля = 	ЗначениеПоля + Символы.ВК;
					СчетЭлементов = 0;
				КонецЕсли;
				ЗначениеПоля = 	ЗначениеПоля + СокрЛП(ПолеЭлементМассива.Ключ) + ": " + СокрЛП(ПолеЭлементМассива.Значение) + ", ";
			КонецЦикла;
			ЗначениеПоля = 	ЗначениеПоля + Символы.ВК;
			ДопПоляЗначения.Добавить(Лев(ЗначениеПоля, СтрДлина(ЗначениеПоля) - СимволовОтрезать));
		КонецЕсли;
		ЭтаФорма.ДополнительныеПоля = СтрСоединить82(ДопПоляЗначения, "; ");
		
		Если не ЗначениеЗаполнено(Подразделение) Тогда
			ПодразделениеВрем = get_prop(ДокументСБИС,"Подразделение");
			ДанныеДокументаПодразделение = get_prop(ДокументСБИС, "ПодразделениеСотрудника", ПодразделениеВрем);
			ЭтаФорма.Подразделение = get_prop(ДанныеДокументаПодразделение, "Название");
		КонецЕсли;
	Исключение
		// Нужны для дебага
		ИнфОбОшибке = ИнформацияОбОшибке();
		Ошибка = ExtExceptionAnalyse(ИнфОбОшибке);
	КонецПопытки;
	// Обнулим значения переменных
	Ошибка = Неопределено;
	ИнфОбОшибке = Ошибка;
	
	ЗаполнитьОсновныеРеквизиты();
	ЗаполнитьДанныеВложенныхФайлов();
	УстановитьДоступностьРеквизитовФормы();
КонецПроцедуры

&НаКлиенте
Функция ПрочитатьДокумент()
	context_params = ПроверитьНаличиеПараметровПодключенияНаСервере(); 
	Документ = Новый Структура("Идентификатор, ПервичныйКлюч, ДопПоля", Идентификатор, ИдСБИС, "Расширение,ДополнительныеПоля");
	Возврат ТранспортИнтеграции.ПрочитатьДокумент(context_params, Документ);	
КонецФункции

&НаКлиенте
Процедура СообщениеПользователю(ТекстСообщения) Экспорт 

	СообщениеПользователю = Новый СообщениеПользователю;
	СообщениеПользователю.Текст = ТекстСообщения;
	СообщениеПользователю.Сообщить();	
	
КонецПроцедуры

