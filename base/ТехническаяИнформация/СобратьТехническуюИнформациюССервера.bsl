
&НаСервере
Функция СобратьТехническуюИнформациюФайлПоКонстантам(Константы) Экспорт
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.ДобавитьСтроку("" + Символы.ПС
						  + ";  Константы конфигурации внешней системы" + Символы.ПС + Символы.ПС + "[Константы]");
	Для Каждого ТекущаяКонстанта Из Константы Цикл
		Попытка
			ТекстДок.ДобавитьСтроку("; " + СокрЛП(ТекущаяКонстанта.Синоним));
			ТекстДок.ДобавитьСтроку(ТекущаяКонстанта.Имя + " = " + СокрЛП(ТекущаяКонстанта.Значение) + Символы.ПС);
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	Возврат ТекстДок;
КонецФункции

&НаСервере
Функция СобратьТехническуюИнформациюПоКонстантам() Экспорт
	ТехИнфоКонстанты = Новый Массив;
	Для Каждого ТекущаяКонстанта Из Метаданные.Константы Цикл
		Попытка
			ИмяКонстанты = ТекущаяКонстанта.Имя;
			ЗначениеКонстанты = СокрЛП(Константы[ИмяКонстанты].Получить());
			ТехИнфоКонстанта = Новый Структура;
			ТехИнфоКонстанта.Вставить("Имя", ИмяКонстанты);
			ТехИнфоКонстанта.Вставить("Синоним", СокрЛП(ТекущаяКонстанта.Синоним));
			ТехИнфоКонстанта.Вставить("Значение", ЗначениеКонстанты);
			ТехИнфоКонстанты.Добавить(ТехИнфоКонстанта);
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	Возврат Новый Структура("Константы", ТехИнфоКонстанты);
КонецФункции

