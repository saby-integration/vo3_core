
&НаКлиенте
Процедура СобратьТехническуюИнформацию(Команда)
	ФормаТехИнфо = ФормаОсновнойОбработки("ТехИнформация", ПутьКФормамОбработки());
	Результат = ФормаТехИнфо.СобратьТехническуюИнформацию(Истина); // Ссылка с файлом архива
	Картинка = КартинкаУспешно();
	ДействиеПриНажатии = SabyОписаниеОповещения("ОбработкаСсылкиАрхива", ЭтотОбъект, Результат);
	Попытка
		ПоказатьВажноеОповещениеПользователя(
			"Техническая информация",
			ДействиеПриНажатии,
			Результат,
			Картинка);
	Исключение
		// Для старых платформ
		ПоказатьВажноеОповещениеПользователя(
			"Техническая информация",
			"",
			Результат,
			Картинка);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте 
Процедура ОбработкаСсылкиАрхива(ПутьКФайлу) Экспорт
	Попытка
		// Открываем каталог с файлом как в ВО2
		Файл = Новый Файл(ПутьКФайлу);
		КаталогФайла = Файл.Путь;
		Saby_ЗапуститьПриложение(КаталогФайла);	
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

