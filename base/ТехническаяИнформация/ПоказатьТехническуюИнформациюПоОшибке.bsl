
// BSLLS:NumberOfOptionalParams-off

&НаКлиенте
Процедура ПоказатьВажноеОповещениеОбОшибке(Текст = Неопределено, НавигационнаяСсылка = Неопределено,
			Пояснение = Неопределено, Картинка = Неопределено,
			ИнфОбОшибке = Неопределено, ИмяОперации = "", ИмяКоманды = "", МестоВыполненияКоманды = "", ИмяПИМ = "",
			ПараметрыКоманды = Неопределено, РезультатОперации = Неопределено, ОтчетОбмена = "")
	ПоказатьОповещениеОбОшибке(Текст, НавигационнаяСсылка, Пояснение, Картинка,
		ИнфОбОшибке, ИмяОперации, ИмяКоманды, МестоВыполненияКоманды, ИмяПИМ,
		ПараметрыКоманды, РезультатОперации, ОтчетОбмена);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОповещениеОбОшибке(Текст = Неопределено, НавигационнаяСсылка = Неопределено,
			Пояснение = Неопределено, Картинка = Неопределено,
			ИнфОбОшибке = Неопределено, ИмяОперации = "", ИмяКоманды = "", МестоВыполненияКоманды = "", ИмяПИМ = "",
			ПараметрыКоманды = Неопределено, РезультатОперации = Неопределено, ОтчетОбмена = "")
	Перем hint;
	
	Если ИнфОбОшибке = Неопределено Тогда
		ИнфОбОшибке = ИнформацияОбОшибке(); // Пустая информация об ошибке, если не указана
	КонецЕсли;
	Если ТипЗнч(ИнфОбОшибке) = Тип("ИнформацияОбОшибке") Тогда
		ИнфОбОшибке = NewExtExceptionСтруктура(ИнфОбОшибке);
	КонецЕсли;
	hint = get_prop(ИнфОбОшибке, "hint", ""); // Инструкция
	
	// Дополнительные данные по технической информации
	ПоследняяОшибка = Новый Структура;
    // BSLLS:DeprecatedCurrentDate-off
	ПоследняяОшибка.Вставить("ДатаВремяСбора", Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'"));
    // BSLLS:DeprecatedCurrentDate-on
	ПоследняяОшибка.Вставить("ТипВнешнейСистемы", "1С");
	ПоследняяОшибка.Вставить("ИмяОперации", ИмяОперации);
	
	Команда = Новый Структура;
	Команда.Вставить("ИмяКоманды", ИмяКоманды);
	Команда.Вставить("МестоВыполненияКоманды", МестоВыполненияКоманды);
	Команда.Вставить("ПараметрыКоманды", ПараметрыКоманды);
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ИмяПИМ", ИмяПИМ);
	ПараметрыОперации.Вставить("Команда", Команда);
	
	ПоследняяОшибка.Вставить("ПараметрыОперации", ПараметрыОперации);
	ПоследняяОшибка.Вставить("РезультатОперации", РезультатОперации);
	ПоследняяОшибка.Вставить("ОтчетОбмена", ОтчетОбмена);
	ПоследняяОшибка.Вставить("ExtException", ИнфОбОшибке);
	ПоследняяОшибка.Вставить("РекомендацияДляИсправления", hint);
	ПоследняяОшибка.Вставить("ПользовательскаяДокументация", "");
	
	ЗаписатьНастройкуДопТехИнфо("ПоследняяОшибка", ПоследняяОшибка);
	
	// Заполняем форму
	ФормаТехИнфо = ФормаОсновнойОбработки("ТехИнформация", ПутьКФормамОбработки());
	ФормаТехИнфо.Информация = Текст;
	ФормаТехИнфо.РасшифровкаИнформации = Пояснение;
	ФормаТехИнфо.hint = hint;
	ФормаТехИнфо.Открыть();
КонецПроцедуры

// BSLLS:NumberOfOptionalParams-on

