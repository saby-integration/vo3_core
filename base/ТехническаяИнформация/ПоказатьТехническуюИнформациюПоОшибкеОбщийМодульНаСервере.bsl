
Процедура ЗаписатьНастройкуДопТехИнфо(ИмяНастройки, ЗначениеНастройки)
	// Обновляем дополнительную техническую информацию по имени настройки
	ДопТехИнфо = МодульВстраиваниеВСтандартныеФормы().ДополнительнаяТехническаяИнформацияПрочитать();
	Если НЕ ЗначениеЗаполнено(ДопТехИнфо) Тогда
		ДопТехИнфо = Новый Структура;
	КонецЕсли;
	ДопТехИнфо.Вставить(ИмяНастройки, ЗначениеНастройки);
	МодульВстраиваниеВСтандартныеФормы().ДополнительнаяТехническаяИнформацияЗаписать(ДопТехИнфо);
КонецПроцедуры

