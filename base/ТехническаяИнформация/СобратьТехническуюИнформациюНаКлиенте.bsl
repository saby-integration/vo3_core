
&НаСервере
Функция СобратьТехническуюИнформациюНаСервере(Знач ТехИнфо)
	МодульОбъекта = МодульОбъекта();
	Возврат МодульОбъекта.СобратьТехническуюИнформациюССервера(ТехИнфо);
КонецФункции

&НаКлиенте
Функция СобратьТехническуюИнформациюОкружениеНаКлиенте()
	ТехИнфоОкружение = Новый Структура("ОС", Новый Структура);
	
	//"ОС": {
	//  "Клиент": {
	//    "ТипОС": "<значение>",
	//    "ЭтоLinux": "<Истина/Ложь>"
	//  }
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ТипОС = СокрЛП(СистемнаяИнформация.ТипПлатформы);
	ЭтоЛинукс = НРег(Лев(ТипОС, 5)) = "linux";
	
	ТехИнфоОкружение.ОС.Вставить("Клиент", Новый Структура);
	ТехИнфоОкружение.ОС.Клиент.Вставить("ТипОС",    ТипОС);
	ТехИнфоОкружение.ОС.Клиент.Вставить("ЭтоLinux", ЭтоЛинукс);
	
	//"Приложение": {
	//  "УправляемоеПриложение": "<Истина/Ложь>",
	//  "РежимЗапускаПриложения": "<ТолстыйКлиентУправляемоеПриложение/ТолстыйКлиентОбычноеПриложение/ТонкийКлиент/Веб-клиент/МобильныйКлиент>",
	//  "ВстроенныйЯзык": "<значение>"
	//},
	ТехИнфоОкружение.Вставить("Приложение", Новый Структура);
	ТехИнфоОкружение.Приложение.Вставить("УправляемоеПриложение",
											ТекущийРежимЗапуска() = РежимЗапускаКлиентскогоПриложения.УправляемоеПриложение);
	ТехИнфоОкружение.Приложение.Вставить("РежимЗапускаПриложения", РежимЗапускаПриложенияНаКлиенте());
	ТехИнфоОкружение.Приложение.Вставить("ВстроенныйЯзык", ТекущийЯзыкСистемы());
	
	Возврат Новый Структура("Окружение", ТехИнфоОкружение);
КонецФункции

#Область include_core_base_ТехническаяИнформация_ПереопределяемыйНаКлиенте
#КонецОбласти

&НаКлиенте
Функция СобратьТехническуюИнформациюНаКлиенте()
	ТехИнфо = Новый Структура;
	
	// Сбор тех.информации окружения на клиенте в структуру
	ОкружениеНаКлиенте = СобратьТехническуюИнформациюОкружениеНаКлиенте();
	ОбновитьСтруктуруРекурсивно(ТехИнфо, ОкружениеНаКлиенте);
	
	Возврат ТехИнфо;
КонецФункции

&НаКлиенте
Процедура НачатьСборТехническойИнформации(ПараметрыСбора) Экспорт
	
	Если get_prop(ПараметрыСбора, "ПолучитьСсылкуНаФайл") = Истина Тогда
		#Если ВебКлиент Тогда
			РасширениеРаботыСФайламиПодключить(ПараметрыСбора);
		#Иначе
			СборТехническойИнформацииВыбратьКаталогДляСохранения(ПараметрыСбора);
		#КонецЕсли
	Иначе
		СборТехническойИнформацииПродолжить(ПараметрыСбора);
	КонецЕсли;
КонецПроцедуры

#Если ВебКлиент Тогда

&НаКлиенте 
Процедура РасширениеРаботыСФайламиПодключить(ДопПараметры) Экспорт
    НачатьПодключениеРасширенияРаботыСФайлами(
        Новый ОписаниеОповещения(
            "РасширениеРаботыСФайламиПослеПодключения",
            ЭтотОбъект,
            ДопПараметры));
КонецПроцедуры

&НаКлиенте
Процедура РасширениеРаботыСФайламиПослеПодключения(Подключено, ДопПараметры) Экспорт
	// Расширение работы с файлами подключено
	Если Подключено Тогда
		СборТехническойИнформацииВыбратьКаталогДляСохранения(ДопПараметры);
	// Нужна установка расширения работы с файлами
	Иначе
		НачатьУстановкуРасширенияРаботыСФайлами(
			SabyОписаниеОповещения(
				"РасширениеРаботыСФайламиПодключить",
				ЭтотОбъект,
				ДопПараметры));
	КонецЕсли;
КонецПроцедуры

#КонецЕсли

&НаКлиенте
Процедура СборТехническойИнформацииВыбратьКаталогДляСохранения(ПараметрыСбора) Экспорт
	ОбработчикВыборКаталогаЗавершение = SabyОписаниеОповещения("СборТехническойИнформацииВыбратьКаталогВыбран",
																ЭтаФорма, ПараметрыСбора);
	ДиалогОткрытия = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогОткрытия.Заголовок = "Сохранить информацию для техподдержки в:";
	ДиалогОткрытия.Показать(ОбработчикВыборКаталогаЗавершение);
КонецПроцедуры

&НаКлиенте
Процедура СборТехническойИнформацииВыбратьКаталогВыбран(ВыбранныйКаталог, ПараметрыСбора) Экспорт
	Если ВыбранныйКаталог = Неопределено Тогда
		// Завершающее оповещение для передачи результата
		ОбработчикЗавершить = get_prop(ПараметрыСбора, "ОбработчикЗавершить");
		Если ОбработчикЗавершить <> Неопределено Тогда
			ВыполнитьSabyОписаниеОповещения(ОбработчикЗавершить, Неопределено);
		КонецЕсли;
	Иначе
		ПараметрыСбора.Вставить("КаталогДляСохраненияТехИнфо", ВыбранныйКаталог[0]);
		СборТехническойИнформацииПродолжить(ПараметрыСбора);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СборТехническойИнформацииПродолжить(ПараметрыСбора)
	ТехИнфо = Новый Структура;
	
	// 1. Сбор тех.информации окружения на клиенте в структуру
	ТехИнфоНаКлиенте = СобратьТехническуюИнформациюНаКлиенте();
	ОбновитьСтруктуруРекурсивно(ТехИнфо, ТехИнфоНаКлиенте);
	
	// 2. Асинхронно получим переопределяемый блок на клиенте и пойдём далее
	ПараметрыСбора.Вставить("ТехИнфо", ТехИнфо);
	ОбработчикДалее = SabyОписаниеОповещения("СборТехническойИнформацииЗавершение", ЭтаФорма, ПараметрыСбора,
											 "СборТехническойИнформацииОшибка", ЭтаФорма);
	СобратьТехническуюИнформациюПереопределяемыйНаКлиентеАсинх(ОбработчикДалее);
КонецПроцедуры

// BSLLS:UsingSynchronousCalls-off - для совместимости со старыми платформами

&НаКлиенте
Процедура СборТехническойИнформацииЗавершение(Результат, ПараметрыСбора) Экспорт
	
	// Если получили асинхронно данные на клиенте в переопределяемом блоке
	Если Результат <> Неопределено Тогда
		Если ТипЗнч(Результат) = Тип("Файл") Тогда
			ПараметрыСбора.ТехИнфо.Вставить("ФайлПереопределяемыйНаКлиентеАсинх", Новый ДвоичныеДанные(Результат.ПолноеИмя));
			УдалитьФайлы(Результат.Путь); // Удаляем весь временный каталог
		КонецЕсли;
	КонецЕсли;
	
	ТехИнфо = ПараметрыСбора.ТехИнфо;
	
	// 3. Сбор информации на сервере + доп. информация на сервере + переопределяемый на сервере
	//    Результат = сразу архив строкой в base64, т.к. ЗаписьZipФайла нет на веб-клиенте
	Результат = СобратьТехническуюИнформациюНаСервере(ТехИнфо);
	
	// Если требуется загрузка на диск
	Если get_prop(ПараметрыСбора, "ПолучитьСсылкуНаФайл") = Истина Тогда
		// BSLLS:TempFilesDir-off
		// BSLLS:DeprecatedCurrentDate-off
		ИмяВременногоФайла = get_prop(ПараметрыСбора, "КаталогДляСохраненияТехИнфо")
						   + РазделительКаталоговОС()
						   + Формат(ТекущаяДата(), "ДФ=гггг_ММ_дд_ЧЧ_мм_сс") // каталог с датой как в ВО2
						   + РазделительКаталоговОС()
						   + "ТехническаяИнформацияВнешнейСистемы.zip";
		// BSLLS:DeprecatedCurrentDate-on
		// BSLLS:TempFilesDir-on
		ДвоичныеДанные = Base64Значение(Результат);
		#Если ВебКлиент Тогда
			АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
			ОписаниеПередаваемогоФайла = Новый ОписаниеПередаваемогоФайла(ИмяВременногоФайла, АдресФайлаВоВременномХранилище);
			ПолучаемыеФайлы = Новый Массив;	
			ПолучаемыеФайлы.Добавить(ОписаниеПередаваемогоФайла);
			ОповещениеОЗавершении = SabyОписаниеОповещения("ВыполнитьПослеПолученияФайла", ЭтаФорма, ПараметрыСбора);
			НачатьПолучениеФайлов(ОповещениеОЗавершении, ПолучаемыеФайлы,, Ложь);
			Возврат; // Завершится после получения файла асинхронно
		#Иначе
			ДвоичныеДанные.Записать(ИмяВременногоФайла);
			Результат = ИмяВременногоФайла;
		#КонецЕсли
	КонецЕсли;
	
	// Завершающее оповещение для передачи результата
	ОбработчикЗавершить = get_prop(ПараметрыСбора, "ОбработчикЗавершить");
	Если ОбработчикЗавершить <> Неопределено Тогда
		ВыполнитьSabyОписаниеОповещения(ОбработчикЗавершить, Результат);
	КонецЕсли;
	
КонецПроцедуры

// BSLLS:UsingSynchronousCalls-on

#Если ВебКлиент Тогда

&НаКлиенте
Процедура ВыполнитьПослеПолученияФайла(ВыбранныеФайлы, ПараметрыСбора) Экспорт
	Если ВыбранныеФайлы = Неопределено Тогда
		Результат = "";
	Иначе
		Результат = ВыбранныеФайлы[0].ПолноеИмя;
	КонецЕсли;
	ОбработчикЗавершить = get_prop(ПараметрыСбора, "ОбработчикЗавершить");
	Если ОбработчикЗавершить <> Неопределено Тогда
		ВыполнитьSabyОписаниеОповещения(ОбработчикЗавершить, Результат);
	КонецЕсли;
КонецПроцедуры

#КонецЕсли

&НаКлиенте
Процедура СборТехническойИнформацииОшибка(ИнформацияОбОшибке, СтандартнаяОбработка, ПараметрыСбора) Экспорт
	ЭтаФорма.СсылкаНаАрхив = "";
	ОбновитьФормуПоОшибкеВЭтойФорме(ИнформацияОбОшибке, "Ошибка сбора технической информации");
КонецПроцедуры

