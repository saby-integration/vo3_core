
&НаСервере
Функция СобратьТехническуюИнформациюПереопределяемый(ИмяКаталога, ЗаписьZipФайла, ТехИнфо) Экспорт
	Перем ИмяФайла, ВремАрхив, ИмяКаталогаВремАрхива, ИмяПапкиОткудаМожноУдалять, КаталогОткуда, КаталогКуда;
	
	ВремАрхив = get_prop(ТехИнфо, "ФайлПереопределяемыйНаКлиентеАсинх");
	Если ВремАрхив = Неопределено ИЛИ ТипЗнч(ВремАрхив) <> Тип("ДвоичныеДанные") Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
	// BSLLS:UsingSynchronousCalls-off - для совместимости со старыми платформами
	// BSLLS:TempFilesDir-off
	ИмяКаталогаВремАрхива = КаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор());
	// BSLLS:TempFilesDir-on			
	ИмяФайлаВремАрхива = ИмяКаталогаВремАрхива + ".zip";
	ВремАрхив.Записать(ИмяФайлаВремАрхива); // Сохранили архив во врем.файл
    // Распакуем все файлы во врем каталог
	ВремZipФайл = Новый ЧтениеZipФайла(ИмяФайлаВремАрхива);
    ВремZipФайл.ИзвлечьВсе(ИмяКаталогаВремАрхива, РежимВосстановленияПутейФайловZIP.Восстанавливать);
	УдалитьФайлы(ИмяФайлаВремАрхива); // Удаляем тек.временный файл архива после распаковки
	
	// Перенесем нужные файлы архива ТИ ВО2 под новую структуру
	КаталогОткуда = ИмяКаталогаВремАрхива;
	ИмяПапкиОткудаМожноУдалять = ИмяКаталогаВремАрхива; // ДЛЯ ЗАЩИТЫ ОТ УДАЛЕНИЯ!!! Папка, откуда могут быть удалены, перемещены файлы/папки
	
	// 5. Логи
	КаталогКуда = ИмяКаталога + "Логи";
	ЕстьЧтоЗаписатьВАрхив = НайтиИСкопироватьФайлыПоМаске(ИмяПапкиОткудаМожноУдалять, КаталогОткуда, КаталогКуда,
														  "Log", Истина, Истина);
	Если ЗначениеЗаполнено(ЕстьЧтоЗаписатьВАрхив) Тогда
		ЗаписьZipФайла.Добавить(КаталогКуда + РазделительКаталоговОС(), РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
								РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
	КонецЕсли;
	
	// 8. сначала ВспомогательнаяОбработкаВФК, чтобы удалить её из папки с инишками
	КаталогКуда = ИмяКаталога;
	ЕстьЧтоЗаписатьВАрхив = НайтиИСкопироватьФайлыПоМаске(ИмяПапкиОткудаМожноУдалять, КаталогОткуда, КаталогКуда,
														  "ВнешниеФункции_Клиент*", Истина, Истина);
	Если ЗначениеЗаполнено(ЕстьЧтоЗаписатьВАрхив) Тогда
		Для Каждого СбисФайл Из ЕстьЧтоЗаписатьВАрхив Цикл
			ЗаписьZipФайла.Добавить(СбисФайл.ПолноеИмя, РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
									РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		КонецЦикла;
	КонецЕсли;
	// INI-файл для обработки ВФК
	СбисСведенияОВФК = get_prop(ТехИнфо, "СведенияОВФК");
	Если ЗначениеЗаполнено(СбисСведенияОВФК) И ЗначениеЗаполнено(get_prop(СбисСведенияОВФК, "СведенияОЗапуске")) Тогда
		ИмяФайла = ИмяКаталога + "ВнешниеФункции_Клиент.ini";
		ФайлДляЗаписи = СобратьТехническуюИнформациюПоВФКВТекстДок(СбисСведенияОВФК);
		ФайлДляЗаписи.Записать(ИмяФайла);
		ЗаписьZipФайла.Добавить(ИмяФайла, РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
								РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
	КонецЕсли;
	
	// 7. потом ПИМ-файлы
	КаталогКуда = ИмяКаталога + "ПИМ-файлы";
	ЕстьЧтоЗаписатьВАрхив = НайтиИСкопироватьФайлыПоМаске(ИмяПапкиОткудаМожноУдалять, КаталогОткуда, КаталогКуда,
														  "ФайлыНастроекОбщее", Истина, Истина);
	Если ЗначениеЗаполнено(ЕстьЧтоЗаписатьВАрхив) Тогда
		ЗаписьZipФайла.Добавить(КаталогКуда + РазделительКаталоговОС(), РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
								РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
	КонецЕсли;
	
	УдалитьФайлы(ИмяКаталогаВремАрхива); // Удаляем весь временный распакованный каталог

	Возврат Истина;
КонецФункции

&НаСервере
Функция СобратьТехническуюИнформациюПоВФКВТекстДок(СведенияОВФК) Экспорт
	Перем СбисСсылка, СбисИмя, СбисВерсия, СбисНазначение, СбисИдентификатор, СбисПуть, СбисАктивна;
	
	СбисИмя = "Неопределено";
	СбисВерсия = "Неопределено";
	СбисНазначение = "Неопределено";
	СбисИдентификатор = "Неопределено";
	СбисПуть = "Неопределено";
	СбисАктивна = "Неопределено";
	
	Попытка
		СведенияОЗапуске = СведенияОВФК.СведенияОЗапуске;
		
		МестоПоиска = Новый Массив;
		МестоПоиска.Добавить(СведенияОЗапуске.Поиск);
		РезультатДанные = ВнешняяОбработка_НайтиДанные(МестоПоиска);
		ДанныеОбработки = РезультатДанные.Получить(СведенияОЗапуске.Поиск.Путь);
		// Ссылка в справочнике
		Если ДанныеОбработки.Тип = "Ссылка" Тогда
			СбисСсылка = get_prop(ДанныеОбработки, "Значение");
			СбисИмя = "" + СведенияОЗапуске.Поиск.Путь + "." + get_prop(ДанныеОбработки, "Имя", "");
			СбисВерсия = get_prop(СбисСсылка, "Версия", "");
			СбисНазначение = get_prop(СбисСсылка, "Информация", "");
			СбисИдентификатор = get_prop(ДанныеОбработки, "ИД", "");
			СбисПуть = "";
			СбисАктивна = СокрЛП(get_prop(СбисСсылка, "Публикация", "Отключена")) <> "Отключена";
		// Внешний файл
		ИначеЕсли ДанныеОбработки.Тип = "Файл" Тогда
			СбисИмя = "";
			СбисВерсия = "";
			СбисНазначение = "";
			СбисИдентификатор = "";
			СбисПуть = get_prop(get_prop(ДанныеОбработки, "Значение"), "ПолноеИмя", "");
			СбисАктивна = "Истина";
		// Объект в конфигурации
		ИначеЕсли ДанныеОбработки.Тип = "ОбъектКонфигурации" Тогда
			СбисИмя = "Обработка " + get_prop(ДанныеОбработки, "Имя", "");
			СбисВерсия = "";
			СбисНазначение = "";
			СбисИдентификатор = "";
			СбисПуть = "";
			СбисАктивна = "Истина";
		Иначе
			СбисИмя = "Неопределено";
		КонецЕсли;
	Исключение
		ДанныеОбработки = Неопределено;
	КонецПопытки;
	
	// Данные [ВспомогательнаяОбработкаВФК].ini
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.ДобавитьСтроку("[Обработка]" + Символы.ПС
						  + "; Имя обработки в конфигурации 1С" + Символы.ПС
						  + "Имя = " + СбисИмя + Символы.ПС);
	ТекстДок.ДобавитьСтроку("; Версия обработки" + Символы.ПС
						  + "Версия = " + СбисВерсия + Символы.ПС);
	ТекстДок.ДобавитьСтроку("; Назначение обработки" + Символы.ПС
						  + "Назначение = " + СбисНазначение + Символы.ПС);
	ТекстДок.ДобавитьСтроку("; Идентификатор обработки (UUID)" + Символы.ПС
						  + "Идентификатор = " + СбисИдентификатор + Символы.ПС);
	ТекстДок.ДобавитьСтроку("; Путь к файлу обработки (если хранится в файловой системе)" + Символы.ПС
						  + "Путь = " + СбисПуть + Символы.ПС);
	ТекстДок.ДобавитьСтроку("; Признак активности обработки" + Символы.ПС
						  + "Активна = " + СбисАктивна);
	
	Возврат ТекстДок;
КонецФункции

