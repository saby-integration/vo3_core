
Функция ПараметрыОбработкиSaby(context = Неопределено)  
	Результат = Новый Структура;
	Результат.Вставить("Обработка", ИмяОбработки());
	Результат.Вставить("ЭтоВнешняяОбработка", Ложь);
	Возврат Результат;
КонецФункции

Функция ОбработкаДляДлительнойОперации(context = Неопределено)
	Возврат МодульОбъекта();
КонецФункции

// Функция ИмяСправочникаДопОтчетыИОбработки
//
// Возвращаемое значение:
//  - Строка - Имя справочника
Функция ИмяСправочникаДопОтчетыИОбработки()
	СправочникДопОтчетыИОбработки = "ДополнительныеОтчетыИОбработки";
	Если Метаданные.Справочники.Найти(СправочникДопОтчетыИОбработки) = Неопределено Тогда
		СправочникДопОтчетыИОбработки = "ВнешниеОбработки";
	КонецЕсли;
	Если Метаданные.Справочники.Найти(СправочникДопОтчетыИОбработки) = Неопределено Тогда
		ВызватьИсключение "Отсутствует справочник " + СправочникДопОтчетыИОбработки;
	КонецЕсли;
	Возврат СправочникДопОтчетыИОбработки;
КонецФункции

// Функция ОбработкаВО3
//
// Параметры:
// 	ИмяСправочника - Строка - Имя справочника в дереве метаданных.
// 	ИмяОбработки - Строка - Имя обработки.
//
// Возвращаемое значение:
//  - Булево - Результат работы метода
//
// BSLLS:QueryParseError-off Имя справочника зависит от конфигурации
Функция ОбработкаВО3(ИмяСправочника, ИмяОбработки)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СправочникДопОтчетыИОбработки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК СправочникДопОтчетыИОбработки
	|ГДЕ
	|	СправочникДопОтчетыИОбработки.Наименование = &Наименование
	|	И НЕ СправочникДопОтчетыИОбработки.ЭтоГруппа";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДополнительныеОтчетыИОбработки", ИмяСправочника);
	Запрос.УстановитьПараметр("Наименование", ИмяОбработки);
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Неопределено;
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	Возврат Результат;
КонецФункции
// BSLLS:QueryParseError-on
