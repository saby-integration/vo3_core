
//DynamicDirective

Процедура СообщитьПрогрессОперации(Процент = Неопределено, Текст = Неопределено, ДополнительныеПараметры = Неопределено)
	#Если Сервер Тогда
		МодульФоновогоЗаданияСервер().СообщитьПрогресс(Процент, Текст, ДополнительныеПараметры);
	#Иначе
		Если Процент = Неопределено Тогда
			Процент  = get_prop(ДополнительныеПараметры, "Прогресс", 0);
		КонецЕсли;
		Состояние("Выполнение операции", Процент, Текст);
	#КонецЕсли	
КонецПроцедуры

